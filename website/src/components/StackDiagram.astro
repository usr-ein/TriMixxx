---
// The deck, layer by layer: what each layer is, what it is built from, and
// where its source lives. The home page shows it short; the architecture page
// shows it with links to each layer's section.
interface Layer {
  id: string;
  name: string;
  what: string;
  parts: readonly string[];
  source: string;
}

interface Props {
  linked?: boolean;
}

const { linked = false } = Astro.props;

const layers: readonly Layer[] = [
  {
    id: "network",
    name: "Network",
    what: "Joins a Pro DJ Link network beside CDJs: browses their sticks, serves its own, follows and takes tempo master.",
    parts: ["prolink (Rust)", "NFSv2 + dbserver", "beat sync"],
    source: "usr-ein/prolink",
  },
  {
    id: "mixxx",
    name: "DJ software",
    what: "A Mixxx 2.5.6 fork with a CDJ-style skin and browser for the deck's touchscreen, rekordbox waveforms and grids, SYNC, KEY SYNC, History and Record set.",
    parts: ["Mixxx fork (C++/Qt)", "skin XML + QSS", "controller script (JS)"],
    source: "usr-ein/mixxx",
  },
  {
    id: "pi",
    name: "Operating system",
    what: "Raspberry Pi OS on a Pi 4: the UART becomes a MIDI port, a launch manager picks Mixxx, Doom or a rescue console, and A/B slots take signed updates that roll back on their own.",
    parts: ["ttymidi", "Go daemons", "systemd + RAUC"],
    source: "pi_config/ · trimixxx-launcher/",
  },
  {
    id: "link",
    name: "The link",
    what: "Raw MIDI over a 3.3 V UART at 115 200 baud. Notes and CCs go up; LED states and RGB SysEx come back down.",
    parts: ["MidiMap.hpp", "SysEx 0x7D"],
    source: "firmwares/trimixxx-midi/lib/PiLink",
  },
  {
    id: "brain",
    name: "Controller",
    what: "An ESP32-S3 reads every control: the jog through the hardware pulse counter, the tempo fader at 14 bits, both button rings on their own UARTs.",
    parts: ["ESP32-S3", "FreeRTOS", "PlatformIO"],
    source: "boards/midi_s3_mini · firmwares/trimixxx-midi",
  },
  {
    id: "boards",
    name: "Satellite boards",
    what: "Thirteen pads on two rings of CH32V003 nodes, each with a button and two RGB LEDs, passing one frame round the ring at 500 kbaud. Play, cue and loop on boards of their own.",
    parts: ["CH32V003 (RISC-V)", "WS2812", "KiCad"],
    source: "boards/ · firmwares/onebutton",
  },
  {
    id: "controls",
    name: "Controls",
    what: "An optical jog wheel with touch, a tempo fader, a push encoder, play, cue, loop in, out and reloop: laid out like the deck a DJ already knows.",
    parts: ["GP1A038RBK optical encoder", "Fusion 360 chassis"],
    source: "boards/ · ref_sizes/",
  },
];
---

<ol class="stack" aria-label="TriMixxx's layers, from the network down to the controls">
  {layers.map((layer, i) => (
    <li class="stack__layer" style={`--i: ${String(i)}`}>
      <span class="stack__index mono" aria-hidden="true">
        {String(layers.length - i).padStart(2, "0")}
      </span>
      <div class="stack__body">
        <h3 class="stack__name">
          {linked ? <a href={`/architecture/#${layer.id}`}>{layer.name}</a> : layer.name}
        </h3>
        <p class="stack__what">{layer.what}</p>
      </div>
      <div class="stack__meta">
        <ul class="stack__parts">
          {layer.parts.map((part) => (
            <li class="pill">{part}</li>
          ))}
        </ul>
        <span class="stack__source mono">{layer.source}</span>
      </div>
    </li>
  ))}
</ol>

<style>
  .stack {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .stack__layer {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1.3fr) minmax(0, 1fr);
    gap: 1.25rem;
    align-items: start;
    padding: 1.25rem clamp(1rem, 2.5vw, 1.75rem);
    border-top: 1px solid var(--line);
    background: linear-gradient(
      90deg,
      rgb(136 255 0 / calc(0.07 - var(--i) * 0.009)) 0%,
      transparent 55%
    );
  }

  .stack__layer:first-child {
    border-top: 0;
  }

  .stack__index {
    color: var(--lime);
    font-size: 0.8rem;
    padding-top: 0.2rem;
  }

  .stack__body {
    display: grid;
    gap: 0.35rem;
  }

  .stack__name {
    font-size: 1.15rem;
  }

  .stack__name a {
    text-decoration: none;
  }

  .stack__what {
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .stack__meta {
    display: grid;
    gap: 0.6rem;
    justify-items: start;
  }

  .stack__parts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stack__source {
    color: var(--text-faint);
    font-size: 0.72rem;
  }

  @media (width <= 48rem) {
    .stack__layer {
      grid-template-columns: 2.25rem minmax(0, 1fr);
    }

    .stack__meta {
      grid-column: 2;
    }
  }
</style>
