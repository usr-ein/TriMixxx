---
import type { CollectionEntry } from "astro:content";
import { Picture } from "astro:assets";

import { coverOf } from "../lib/photos";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const cover = await coverOf(post);
---

<article class="post-card">
  <a class="post-card__link" href={`/blog/${post.id}/`}>
    <Picture
      src={cover.src}
      alt=""
      formats={["avif"]}
      fallbackFormat="webp"
      width={720}
      sizes="(min-width: 62rem) 24rem, 100vw"
      loading="lazy"
    />
    <div class="post-card__body">
      <span class="label">{post.data.period}</span>
      <h3 class="post-card__title">{post.data.title}</h3>
      <p class="post-card__text">{post.data.description}</p>
    </div>
  </a>
</article>

<style>
  .post-card {
    display: flex;
  }

  .post-card__link {
    display: grid;
    grid-template-rows: auto 1fr;
    width: 100%;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-raised);
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  .post-card__link:hover {
    color: inherit;
    border-color: var(--lime-line);
  }

  @media (prefers-reduced-motion: no-preference) {
    .post-card__link:hover {
      transform: translateY(-2px);
    }
  }

  .post-card__link :global(img) {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-bottom: 1px solid var(--line);
    background: var(--panel);
  }

  .post-card__body {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    padding: 1.25rem 1.35rem 1.5rem;
  }

  .post-card__title {
    font-size: 1.2rem;
    line-height: 1.2;
  }

  .post-card__link:hover .post-card__title {
    color: var(--lime);
  }

  .post-card__text {
    color: var(--text-muted);
    font-size: 0.94rem;
  }
</style>
