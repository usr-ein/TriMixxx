---
// A numbered sequence with a timing beside each step: the boot, a press of
// PLAY. Vertical everywhere, so it reads the same on a phone.

interface Step {
  title: string;
  text: string;
  time?: string;
}

interface Props {
  steps: readonly Step[];
  label: string;
}

const { steps, label } = Astro.props;
---

<ol class="steps" aria-label={label}>
  {steps.map((step, i) => (
    <li class="steps__item">
      <span class="steps__index mono" aria-hidden="true">
        {String(i + 1).padStart(2, "0")}
      </span>
      <div class="steps__body">
        <h3 class="steps__title">{step.title}</h3>
        <p class="steps__text">{step.text}</p>
      </div>
      {step.time && <span class="steps__time mono">{step.time}</span>}
    </li>
  ))}
</ol>

<style>
  .steps {
    position: relative;
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .steps__item {
    position: relative;
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr) minmax(0, 11rem);
    gap: 1rem;
    padding: 1rem 0;
    border-top: 1px solid var(--line);
  }

  .steps__item:last-child {
    border-bottom: 1px solid var(--line);
  }

  .steps__index {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border: 1px solid var(--lime-line);
    border-radius: 999px;
    color: var(--lime);
    font-size: 0.75rem;
  }

  .steps__body {
    display: grid;
    gap: 0.3rem;
  }

  .steps__title {
    font-size: 1.05rem;
  }

  .steps__text {
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .steps__time {
    place-self: start end;
    padding-top: 0.2rem;
    color: var(--amber);
    font-size: 0.78rem;
    text-align: right;
  }

  @media (width <= 40rem) {
    .steps__item {
      grid-template-columns: 2.75rem minmax(0, 1fr);
    }

    .steps__time {
      grid-column: 2;
      justify-self: start;
      text-align: left;
    }
  }
</style>
