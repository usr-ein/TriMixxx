---
// The whole deck on one drawing: the controls and satellite boards, the S3
// that reads them, the Pi that plays, and what the Pi talks to. Laid out in
// code so boxes and arrows stay aligned when a row is added.

interface Box {
  x: number;
  y: number;
  w: number;
  h: number;
  title: string;
  sub?: string;
  tone?: "lime" | "plain";
}

interface Wire {
  from: [number, number];
  to: [number, number];
  label: string;
  below?: string;
  both?: boolean;
}

const COL = { controls: 20, s3: 330, pi: 690, out: 1040 };
const ROW = 56;
const GAP = 12;
const top = 64;

const controls: Box[] = [
  ["Ring A", "7 OneButton nodes, RGB pads"],
  ["Ring B", "6 OneButton nodes, RGB pads"],
  ["play_cue_btn", "PLAY, CUE, 8 LEDs"],
  ["loop_btn", "LOOP IN, OUT, RELOOP"],
  ["Jog wheel", "optical quadrature + touch"],
  ["Tempo fader", "centre-tapped slide pot"],
  ["Track encoder", "KY-040 with push"],
].map(([title, sub], i) => ({
  x: COL.controls,
  y: top + i * (ROW + GAP),
  w: 230,
  h: ROW,
  title: title ?? "",
  sub: sub ?? "",
}));

const controlLinks = ["UART1 · 500k", "UART2 · 500k", "GPIO", "GPIO", "PCNT", "ADC1", "GPIO"];

const s3: Box = {
  x: COL.s3,
  y: top,
  w: 250,
  h: 7 * (ROW + GAP) - GAP,
  title: "midi_s3_mini",
  sub: "ESP32-S3 · FreeRTOS",
  tone: "lime",
};

const s3Modules = [
  "PiLink · MIDI in and out",
  "OneButtonRing × 2 · core 0",
  "Buttons · 2 ms poll, latched",
  "JogWheel · pulse counter",
  "TempoFader · 14-bit",
  "TrackEncoder · state table",
  "MidiMap.hpp · the contract",
];

const pi: Box = {
  x: COL.pi,
  y: top,
  w: 290,
  h: 7 * (ROW + GAP) - GAP,
  title: "Raspberry Pi 4",
  sub: "Raspberry Pi OS · systemd",
  tone: "lime",
};

const piModules = [
  "ttymidi · UART to ALSA MIDI",
  "Mixxx fork · skin, browser, script",
  "prolink · Pro DJ Link in Rust",
  "trimixxx-launchd · modes, SysEx",
  "dj-usb · read-only automount",
  "RAUC · A/B slots, health check",
];

const outside: Box[] = [
  ["Touchscreen", "DSI or HDMI panel"],
  ["USB sticks", "rekordbox or plain"],
  ["UCA222", "RCA out and in"],
  ["Pro DJ Link", "eth0: CDJs, other decks"],
  ["Wi-Fi", "ssh, updates, own hotspot"],
].map(([title, sub], i) => ({
  x: COL.out,
  y: top + 18 + i * (ROW + 30),
  w: 175,
  h: ROW,
  title: title ?? "",
  sub: sub ?? "",
}));

const moduleRow = (box: Box, i: number) => ({
  x: box.x + 14,
  y: box.y + 54 + i * 52,
  w: box.w - 28,
  h: 40,
});

const centreY = (b: { y: number; h: number }) => b.y + b.h / 2;

const wires: Wire[] = [
  ...controls.map((box, i) => ({
    from: [box.x + box.w, centreY(box)] as [number, number],
    to: [s3.x, centreY(box)] as [number, number],
    label: controlLinks[i] ?? "",
    both: i < 4,
  })),
  {
    from: [s3.x + s3.w, centreY(moduleRow(s3, 0))],
    to: [pi.x, centreY(moduleRow(pi, 0))],
    label: "raw MIDI",
    below: "115 200 baud",
    both: true,
  },
  ...outside.map((box) => ({
    from: [pi.x + pi.w, centreY(box)] as [number, number],
    to: [box.x, centreY(box)] as [number, number],
    label: "",
    both: true,
  })),
];

const height = s3.y + s3.h + 40;
---

<div class="diagram-scroll" role="region" aria-label="System diagram" tabindex="0">
  <svg
    class="system"
    viewBox={`0 0 1235 ${String(height)}`}
    role="img"
    aria-labelledby="system-title system-desc"
    xmlns="http://www.w3.org/2000/svg"
  >
    <title id="system-title">TriMixxx's system, from the controls to the network</title>
    <desc id="system-desc">
      Seven controls and boards on the left connect to the midi_s3_mini controller over UARTs,
      GPIOs, the pulse counter and the ADC. The controller talks MIDI to the Raspberry Pi over a
      UART at 115 200 baud. The Pi runs ttymidi, the Mixxx fork, the prolink library, the launch
      manager, the USB automount and RAUC, and connects to the touchscreen, USB sticks, the UCA222
      sound card, the Pro DJ Link network and Wi-Fi.
    </desc>
    <defs>
      <marker
        id="arrow"
        viewBox="0 0 10 10"
        refX="9"
        refY="5"
        markerWidth="7"
        markerHeight="7"
        orient="auto-start-reverse"
      >
        <path d="M0 0 L10 5 L0 10 z" class="system__arrowhead"></path>
      </marker>
    </defs>

    <text x={COL.controls} y="30" class="system__column">
      CONTROLS AND BOARDS
    </text>
    <text x={COL.s3} y="30" class="system__column">
      CONTROLLER
    </text>
    <text x={COL.pi} y="30" class="system__column">
      COMPUTER
    </text>
    <text x={COL.out} y="30" class="system__column">
      AROUND IT
    </text>

    {wires.map((wire) => (
      <g>
        <line
          x1={wire.from[0]}
          y1={wire.from[1]}
          x2={wire.to[0] - 2}
          y2={wire.to[1]}
          class="system__wire"
          marker-end="url(#arrow)"
          marker-start={wire.both ? "url(#arrow)" : undefined}
        />
        {wire.label && (
          <text x={(wire.from[0] + wire.to[0]) / 2} y={wire.from[1] - 8} class="system__wire-label">
            {wire.label}
          </text>
        )}
        {wire.below && (
          <text
            x={(wire.from[0] + wire.to[0]) / 2}
            y={wire.from[1] + 16}
            class="system__wire-label"
          >
            {wire.below}
          </text>
        )}
      </g>
    ))}

    {[...controls, ...outside].map((box) => (
      <g>
        <rect x={box.x} y={box.y} width={box.w} height={box.h} rx="10" class="system__box" />
        <text x={box.x + 14} y={box.y + 24} class="system__title">
          {box.title}
        </text>
        <text x={box.x + 14} y={box.y + 43} class="system__sub">
          {box.sub}
        </text>
      </g>
    ))}

    {(
      [
        [s3, s3Modules],
        [pi, piModules],
      ] as const
    ).map(([box, modules]) => (
      <g>
        <rect
          x={box.x}
          y={box.y}
          width={box.w}
          height={box.h}
          rx="14"
          class="system__box system__box--main"
        />
        <text x={box.x + 16} y={box.y + 26} class="system__title system__title--main">
          {box.title}
        </text>
        <text x={box.x + 16} y={box.y + 44} class="system__sub">
          {box.sub}
        </text>
        {modules.map((name, i) => {
          const row = moduleRow(box, i);
          return (
            <g>
              <rect
                x={row.x}
                y={row.y}
                width={row.w}
                height={row.h}
                rx="7"
                class="system__module"
              />
              <text x={row.x + 12} y={row.y + 25} class="system__module-text">
                {name}
              </text>
            </g>
          );
        })}
      </g>
    ))}
  </svg>
</div>

<style>
  .system {
    min-width: 60rem;
    width: 100%;
    height: auto;
    font-family: var(--font-mono);
  }

  .system__column {
    fill: var(--lime);
    font-size: 11px;
    letter-spacing: 0.14em;
  }

  .system__box {
    fill: var(--panel);
    stroke: var(--line-strong);
    stroke-width: 1;
  }

  .system__box--main {
    fill: rgb(136 255 0 / 4%);
    stroke: var(--lime-line);
  }

  .system__title {
    fill: var(--text);
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 650;
  }

  .system__title--main {
    font-size: 16px;
  }

  .system__sub {
    fill: var(--text-faint);
    font-size: 10.5px;
  }

  .system__module {
    fill: var(--bg);
    stroke: var(--line);
  }

  .system__module-text {
    fill: var(--text-muted);
    font-size: 11px;
  }

  .system__wire {
    stroke: var(--lime);
    stroke-width: 1.4;
    opacity: 0.8;
  }

  .system__arrowhead {
    fill: var(--lime);
  }

  .system__wire-label {
    fill: var(--text-muted);
    font-size: 10px;
    text-anchor: middle;
  }
</style>
