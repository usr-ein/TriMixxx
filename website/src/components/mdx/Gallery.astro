---
// Two or three figures side by side in a post; stacks on a phone.
interface Props {
  columns?: 2 | 3;
}

const { columns = 2 } = Astro.props;
---

<div class:list={["gallery", { "gallery--three": columns === 3 }]}>
  <slot />
</div>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    align-items: start;
  }

  .gallery--three {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  @media (width <= 40rem) {
    .gallery,
    .gallery--three {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
