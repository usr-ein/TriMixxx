---
// One dialog for the whole site. Any link with data-lightbox opens its href in
// it; links sharing a data-lightbox value form a set the arrows step through.
// Without JavaScript the links still open the full-size image.
---

<dialog class="lightbox" aria-label="Image viewer" data-lightbox-dialog>
  <figure class="lightbox__figure">
    <img class="lightbox__image" alt="" data-lightbox-image />
    <figcaption class="lightbox__caption" data-lightbox-caption></figcaption>
  </figure>
  <div class="lightbox__controls">
    <button type="button" class="lightbox__button" data-lightbox-prev aria-label="Previous image">
      ←
    </button>
    <span class="lightbox__count" data-lightbox-count></span>
    <button type="button" class="lightbox__button" data-lightbox-next aria-label="Next image">
      →
    </button>
    <button type="button" class="lightbox__button" data-lightbox-close aria-label="Close">
      ✕
    </button>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("[data-lightbox-dialog]");
  const image = dialog?.querySelector<HTMLImageElement>("[data-lightbox-image]");
  const caption = dialog?.querySelector<HTMLElement>("[data-lightbox-caption]");
  const count = dialog?.querySelector<HTMLElement>("[data-lightbox-count]");
  const prev = dialog?.querySelector<HTMLButtonElement>("[data-lightbox-prev]");
  const next = dialog?.querySelector<HTMLButtonElement>("[data-lightbox-next]");
  const close = dialog?.querySelector<HTMLButtonElement>("[data-lightbox-close]");

  if (dialog && image && caption && count && prev && next && close) {
    let set: HTMLAnchorElement[] = [];
    let index = 0;

    const show = (i: number): void => {
      index = (i + set.length) % set.length;
      const link = set[index];
      if (!link) return;
      image.src = link.href;
      image.alt = link.dataset["alt"] ?? "";
      caption.textContent = link.dataset["caption"] ?? "";
      caption.hidden = caption.textContent === "";
      const many = set.length > 1;
      prev.hidden = !many;
      next.hidden = !many;
      count.hidden = !many;
      count.textContent = `${String(index + 1)} / ${String(set.length)}`;
    };

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const link = target.closest<HTMLAnchorElement>("a[data-lightbox]");
      if (!link || event.metaKey || event.ctrlKey || event.shiftKey) return;
      event.preventDefault();
      const group = link.dataset["lightbox"] ?? "";
      set = Array.from(document.querySelectorAll<HTMLAnchorElement>("a[data-lightbox]")).filter(
        (a) => (a.dataset["lightbox"] ?? "") === group,
      );
      show(set.indexOf(link));
      dialog.showModal();
    });

    prev.addEventListener("click", () => {
      show(index - 1);
    });
    next.addEventListener("click", () => {
      show(index + 1);
    });
    close.addEventListener("click", () => {
      dialog.close();
    });
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") show(index - 1);
      if (event.key === "ArrowRight") show(index + 1);
    });
    dialog.addEventListener("close", () => {
      image.removeAttribute("src");
    });
  }
</script>

<style>
  .lightbox {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: calc(1rem + env(safe-area-inset-top, 0px)) 1rem
      calc(1rem + env(safe-area-inset-bottom, 0px));
    border: 0;
    background: rgb(4 5 4 / 94%);
    color: var(--text);
  }

  .lightbox:modal {
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 0.75rem;
  }

  .lightbox::backdrop {
    background: transparent;
  }

  .lightbox__figure {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    gap: 0.75rem;
    min-height: 0;
    margin: 0;
  }

  .lightbox__image {
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: contain;
  }

  .lightbox__caption {
    max-width: 50rem;
    margin-inline: auto;
    color: var(--text-muted);
    font-size: 0.92rem;
    text-align: center;
  }

  .lightbox__controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .lightbox__button {
    min-width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: var(--panel);
    color: var(--text);
    font-size: 1rem;
    cursor: pointer;
  }

  .lightbox__button:hover {
    border-color: var(--lime);
    color: var(--lime);
  }

  .lightbox__count {
    min-width: 4rem;
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-align: center;
  }
</style>
