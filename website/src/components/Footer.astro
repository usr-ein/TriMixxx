---
import { nav, repositories, site } from "../data/site";
import Wordmark from "./Wordmark.astro";

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap footer__grid">
    <div class="footer__brand">
      <span class="footer__mark">
        <Wordmark glow />
      </span>
      <p>
        An all-in-one DJ player, open from the copper to the cue point. Not a product: a platform to
        build the booth's next ideas on.
      </p>
      <p class="footer__links">
        <a href="/rss.xml">RSS</a>
        <span aria-hidden="true">·</span>
        <a href={site.repo} rel="noopener">
          Source
        </a>
      </p>
    </div>

    <nav class="footer__col" aria-label="Site">
      <h2 class="label">Site</h2>
      <ul>
        <li>
          <a href="/">Home</a>
        </li>
        {nav.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <nav class="footer__col" aria-label="Repositories">
      <h2 class="label">Repositories</h2>
      <ul>
        {repositories.map((repo) => (
          <li>
            <a href={repo.href} rel="noopener">
              {repo.name.replace("usr-ein/", "")}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="footer__col footer__legal">
      <h2 class="label">Fine print</h2>
      <p>
        © {year} {site.author} and contributors. TriMixxx is free software under the GPL; each
        repository states its licence.
      </p>
      <p>
        TriMixxx is independent, with no affiliation with, sponsorship by or endorsement from
        AlphaTheta Corporation (formerly Pioneer DJ) or the Mixxx project. CDJ, rekordbox, Pro DJ
        Link and Pioneer DJ are trademarks of AlphaTheta Corporation, named here only to say what
        TriMixxx works with.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: clamp(4rem, 9vw, 7rem);
    padding-block: clamp(3rem, 6vw, 4.5rem) calc(2.5rem + env(safe-area-inset-bottom, 0px));
    border-top: 1px solid var(--line);
    background: var(--bg-sunken);
    font-size: 0.92rem;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: minmax(16rem, 1.4fr) repeat(2, minmax(9rem, 0.7fr)) minmax(16rem, 1.4fr);
    gap: 2.5rem;
  }

  .footer__brand {
    display: grid;
    align-content: start;
    gap: 1rem;
    color: var(--text-muted);
  }

  .footer__mark {
    display: inline-flex;
    font-size: 2.4rem;
  }

  .footer__links {
    display: flex;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .footer__col {
    display: grid;
    align-content: start;
    gap: 0.9rem;
  }

  .footer__col h2 {
    font-weight: 500;
  }

  .footer__col ul {
    display: grid;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__col a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .footer__col a:hover {
    color: var(--lime);
  }

  .footer__legal p {
    color: var(--text-faint);
    font-size: 0.82rem;
    line-height: 1.6;
  }

  @media (width <= 62rem) {
    .footer__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .footer__brand,
    .footer__legal {
      grid-column: 1 / -1;
    }
  }
</style>
