---
// A board's render. When the board's model is in the media repository, the
// render is also a button that opens the board in 3D (ModelViewer.astro).
// With a caption it is framed, for a post.
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

import { modelUrl } from "../lib/models";

interface Props {
  /** The board's id on the hardware page, which names its model. */
  board: string;
  /** Its KiCad name: the viewer's title. */
  name: string;
  src: ImageMetadata;
  alt: string;
  sizes?: string | undefined;
  /** The side of the board its render shows. */
  side?: "top" | "bottom" | undefined;
  caption?: string | undefined;
}

const { board, name, src, alt, sizes, side = "top", caption } = Astro.props;
const model = modelUrl(board);
---

<figure class:list={["board-model", { "board-model--framed": caption !== undefined }]}>
  <div class="board-model__stage">
    <Picture
      src={src}
      alt={alt}
      formats={["avif"]}
      fallbackFormat="webp"
      sizes={sizes}
      loading="lazy"
    />
    {model && (
      <button
        type="button"
        class="board-model__open"
        data-model={model}
        data-name={name}
        data-side={side}
      >
        <span class="board-model__badge" aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            width="14"
            height="14"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linejoin="round"
          >
            <path d="M12 2.5 3.5 7v10l8.5 4.5 8.5-4.5V7zM3.5 7l8.5 4.5L20.5 7M12 11.5v10" />
          </svg>
          3D
        </span>
        <span class="visually-hidden">Turn {name} in 3D</span>
      </button>
    )}
  </div>
  {caption !== undefined && <figcaption class="board-model__caption">{caption}</figcaption>}
</figure>

<style>
  .board-model {
    display: grid;
    gap: 0.6rem;
    margin: 0;
  }

  .board-model__stage {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-sm);
  }

  .board-model--framed .board-model__stage {
    border: 1px solid var(--line);
    background: radial-gradient(120% 90% at 50% 40%, #1b1f1b 0%, #0b0c0b 70%);
  }

  .board-model__stage :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .board-model__open {
    position: absolute;
    inset: 0;
    width: 100%;
    padding: 0;
    border: 0;
    border-radius: inherit;
    background: transparent;
    cursor: grab;
  }

  .board-model__open:focus-visible {
    outline: 2px solid var(--lime);
    outline-offset: -2px;
  }

  .board-model__badge {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.4em 0.8em;
    border: 1px solid var(--lime-line);
    border-radius: 999px;
    background: rgb(0 0 0 / 65%);
    color: var(--lime);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    transition: background-color 0.2s ease;
  }

  .board-model__open:hover .board-model__badge,
  .board-model__open:focus-visible .board-model__badge {
    background: rgb(20 40 0 / 85%);
  }

  .board-model__caption {
    color: var(--text-muted);
    font-size: 0.88rem;
    line-height: 1.55;
  }
</style>
