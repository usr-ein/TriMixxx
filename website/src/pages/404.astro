---
// Not found, said the way the deck says a stick has nothing it can read.
import Row from "../components/screen/Row.astro";
import Deck from "../layouts/Deck.astro";
---

<Deck title="Not found" kind="list" back="/browse/" crumbs={[{ label: "Not found", href: "/404" }]}>
  <h1 class="missing">Nothing at this address on the stick.</h1>
  <ul class="list" data-list>
    <li>
      <Row href="/browse/" icon="home" goesIn label="Home" />
    </li>
    <li>
      <Row href="/deck/" icon="play" label="Back to the track" />
    </li>
  </ul>
</Deck>

<style>
  .missing {
    margin: 0;
    padding: calc(var(--dp) * 60) calc(var(--dp) * 40);
    border-bottom: 1px solid var(--rule-strong);
    color: var(--dim);
    font-size: max(15px, calc(var(--dp) * 30));
    font-weight: 400;
  }
</style>
