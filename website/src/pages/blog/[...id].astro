---
import type { GetStaticPaths } from "astro";
import { getCollection, render } from "astro:content";
import { Picture } from "astro:assets";

import Base from "../../layouts/Base.astro";
import { coverOf } from "../../lib/photos";

export const getStaticPaths = (async () => {
  const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
    (a, b) => a.data.date.valueOf() - b.data.date.valueOf(),
  );
  return posts.map((post, i) => ({
    params: { id: post.id },
    props: { post, previous: posts[i - 1], next: posts[i + 1], number: i + 1 },
  }));
}) satisfies GetStaticPaths;

const { post, previous, next, number } = Astro.props;
const { Content, headings } = await render(post);
const cover = await coverOf(post);
const date = post.data.date.toLocaleDateString("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
const toc = headings.filter((heading) => heading.depth === 2);
---

<Base
  title={post.data.title}
  description={post.data.description}
  image={cover.src}
  imageAlt={cover.alt}
  article={{ published: post.data.date, tags: post.data.tags }}
>
  <article class="post">
    <header class="post__header wrap">
      <a class="post__back mono" href="/blog/">
        ← Build log
      </a>
      <span class="kicker">
        Part {number} · {post.data.period}
      </span>
      <h1 class="post__title">{post.data.title}</h1>
      <p class="lede">{post.data.description}</p>
      <p class="post__meta label">
        <time datetime={post.data.date.toISOString()}>{date}</time>
        {post.data.tags.map((tag) => (
          <span class="post__tag">#{tag}</span>
        ))}
      </p>
    </header>

    <div class="post__cover wrap">
      <Picture
        src={cover.src}
        alt={cover.alt}
        formats={["avif"]}
        fallbackFormat="webp"
        sizes="(min-width: 75rem) 72rem, 100vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>

    <div class="post__layout wrap">
      {toc.length > 2 && (
        <nav class="post__toc" aria-label="In this post">
          <span class="label">In this post</span>
          <ol>
            {toc.map((heading) => (
              <li>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )}
      <div class="prose post__body">
        <Content />
      </div>
    </div>

    <nav class="post__pager wrap" aria-label="More from the build log">
      {previous ? (
        <a class="card post__pager-link" href={`/blog/${previous.id}/`}>
          <span class="label">← Earlier</span>
          <span class="post__pager-title">{previous.data.title}</span>
        </a>
      ) : (
        <span />
      )}
      {next && (
        <a class="card post__pager-link post__pager-link--next" href={`/blog/${next.id}/`}>
          <span class="label">Later →</span>
          <span class="post__pager-title">{next.data.title}</span>
        </a>
      )}
    </nav>
  </article>
</Base>

<style>
  .post__header {
    display: grid;
    gap: 1.1rem;
    justify-items: start;
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(1.5rem, 4vw, 2.5rem);
    max-width: calc(56rem + 2 * var(--gutter));
  }

  .post__back {
    color: var(--text-muted);
    font-size: 0.8rem;
    text-decoration: none;
  }

  .post__title {
    font-size: clamp(2.2rem, 5.2vw, 4rem);
  }

  .post__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
  }

  .post__tag {
    color: var(--text-muted);
  }

  .post__cover :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--panel);
  }

  .post__layout {
    display: grid;
    grid-template-columns: minmax(0, 14rem) minmax(0, var(--max-prose));
    justify-content: center;
    gap: clamp(2rem, 5vw, 4.5rem);
    padding-block: clamp(2.5rem, 6vw, 4rem);
  }

  .post__toc {
    position: sticky;
    top: calc(var(--header-h) + env(safe-area-inset-top, 0px) + 1.5rem);
    align-self: start;
    display: grid;
    gap: 0.75rem;
    font-size: 0.85rem;
  }

  .post__toc ol {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0 0 0 0.9rem;
    border-left: 1px solid var(--line);
    list-style: none;
  }

  .post__toc a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .post__toc a:hover {
    color: var(--lime);
  }

  .post__body {
    grid-column: 2;
    min-width: 0;
  }

  .post__pager {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    max-width: calc(56rem + 2 * var(--gutter));
  }

  .post__pager-link--next {
    text-align: right;
    justify-items: end;
  }

  .post__pager-title {
    font-weight: 650;
    font-stretch: 108%;
    line-height: 1.25;
  }

  @media (width <= 62rem) {
    .post__layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .post__toc {
      display: none;
    }

    .post__body {
      grid-column: 1;
    }
  }

  @media (width <= 40rem) {
    .post__pager {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
