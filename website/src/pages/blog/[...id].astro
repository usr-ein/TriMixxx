---
// A post, loaded onto the deck the way a track is: its cover and title in the
// header, then its text, which the knob scrolls. Its neighbours at the end.
import type { GetStaticPaths } from "astro";
import { Image } from "astro:assets";
import { render } from "astro:content";

import Deck from "../../layouts/Deck.astro";
import { coverOf } from "../../lib/photos";
import { posts, readingTime } from "../../lib/posts";

export const getStaticPaths = (async () => {
  const all = (await posts()).reverse();
  return all.map((post, i) => ({
    params: { id: post.id },
    props: { post, previous: all[i - 1], next: all[i + 1], number: i + 1 },
  }));
}) satisfies GetStaticPaths;

const { post, previous, next, number } = Astro.props;
const { Content } = await render(post);
const cover = await coverOf(post);
const date = post.data.date.toLocaleDateString("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<Deck
  title={post.data.title}
  description={post.data.description}
  image={cover.src}
  imageAlt={cover.alt}
  article={{ published: post.data.date, tags: post.data.tags }}
  kind="page"
  back="/blog/"
  crumbs={[
    { label: "Build log", href: "/blog/" },
    { label: post.data.title, href: `/blog/${post.id}/` },
  ]}
>
  <article class="page post">
    <header class="post__head">
      <Image
        class="post__cover"
        src={cover.src}
        alt={cover.alt}
        width={360}
        height={360}
        fit="cover"
        layout="fixed"
        format="webp"
      />
      <div>
        <h1 class="post__title">{post.data.title}</h1>
        <p class="post__meta">
          <span class="post__number">{String(number).padStart(2, "0")}</span>
          {post.data.period} · {readingTime(post)}
        </p>
        <p class="post__meta dim">
          <time datetime={post.data.date.toISOString()}>{date}</time> · {post.data.tags.join(" · ")}
        </p>
      </div>
    </header>
    <div class="post__body">
      <Content />
    </div>
    <nav class="post__next" aria-label="Other posts">
      {previous && (
        <a class="post__link" href={`/blog/${previous.id}/`}>
          <span class="dim">Before</span> {previous.data.title}
        </a>
      )}
      {next && (
        <a class="post__link" href={`/blog/${next.id}/`}>
          <span class="dim">After</span> {next.data.title}
        </a>
      )}
    </nav>
  </article>
</Deck>

<style>
  .post__head {
    display: grid;
    grid-template-columns: max(72px, calc(var(--dp) * 150)) minmax(0, 1fr);
    gap: calc(var(--dp) * 28);
    align-items: center;
    margin-bottom: calc(var(--dp) * 40);
    padding-bottom: calc(var(--dp) * 30);
    border-bottom: 1px solid var(--rule-strong);
  }

  .post__head :global(.post__cover) {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .post__title {
    margin: 0 0 0.35em;
  }

  .post__meta {
    margin: 0;
    font-size: 0.85em;
  }

  .post__number {
    margin-right: 1ch;
    color: var(--accent);
    font-weight: 700;
  }

  .post__body :global(img) {
    height: auto;
  }

  .post__next {
    display: grid;
    margin-top: calc(var(--dp) * 60);
    border-top: 1px solid var(--rule-strong);
  }

  .post__link {
    padding: calc(var(--dp) * 22) 0;
    border-bottom: 1px solid var(--rule);
    color: var(--text);
    text-decoration: none;
  }

  .post__link:hover {
    color: var(--accent);
  }
</style>
