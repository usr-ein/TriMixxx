---
// The build log, as the deck's History: a row a post, its cover, its title,
// its period and tags, and where History says how long a track played, how
// long the post takes to read.
import { Image } from "astro:assets";

import Deck from "../../layouts/Deck.astro";
import { coverOf } from "../../lib/photos";
import { posts, readingTime } from "../../lib/posts";

const rows = await Promise.all(
  (await posts()).map(async (post) => ({
    post,
    cover: await coverOf(post),
    time: readingTime(post),
  })),
);
---

<Deck
  title="Build log"
  description="How TriMixxx was built, from one circuit board in February 2026 to a deck in a booth."
  kind="list"
  back="/browse/"
  crumbs={[{ label: "Build log", href: "/blog/" }]}
>
  <h1 class="visually-hidden">Build log</h1>
  <ul class="list" data-list>
    {rows.map(({ post, cover, time }) => (
      <li>
        <a class="entry" href={`/blog/${post.id}/`} data-row>
          <Image
            class="entry__cover"
            src={cover.src}
            alt=""
            width={180}
            height={180}
            fit="cover"
            layout="fixed"
            format="webp"
          />
          <span class="entry__text">
            <span class="entry__title">{post.data.title}</span>
            <span class="entry__sub">
              {post.data.period} · {post.data.tags.join(" · ")}
            </span>
          </span>
          <span class="entry__time">{time}</span>
        </a>
      </li>
    ))}
  </ul>
</Deck>

<style>
  .entry {
    display: grid;
    grid-template-columns: max(48px, calc(var(--dp) * 90)) minmax(0, 1fr) auto;
    gap: calc(var(--dp) * 22);
    align-items: center;
    min-height: max(64px, calc(var(--dp) * 110));
    padding: calc(var(--dp) * 10) calc(var(--dp) * 22) calc(var(--dp) * 10) calc(var(--dp) * 20);
    border-bottom: 1px solid var(--rule);
    background: var(--row);
    color: var(--text);
    text-decoration: none;
    user-select: none;
  }

  .entry:global(.is-selected) {
    background: var(--accent);
    color: var(--on-accent);
  }

  .entry :global(.entry__cover) {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .entry__text {
    display: grid;
    gap: calc(var(--dp) * 8);
    min-width: 0;
  }

  .entry__title,
  .entry__sub {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .entry__title {
    font-size: max(14px, calc(var(--dp) * 28));
  }

  .entry__sub,
  .entry__time {
    color: var(--dim);
    font-size: max(12px, calc(var(--dp) * 22));
  }

  .entry:global(.is-selected) .entry__sub,
  .entry:global(.is-selected) .entry__time {
    color: var(--on-accent);
  }
</style>
