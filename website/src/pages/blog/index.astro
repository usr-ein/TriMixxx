---
import { getCollection } from "astro:content";
import { Picture } from "astro:assets";

import Base from "../../layouts/Base.astro";
import { coverOf } from "../../lib/photos";

const posts = await Promise.all(
  (await getCollection("blog", ({ data }) => !data.draft))
    .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf())
    .map(async (post) => ({ ...post, cover: await coverOf(post) })),
);
---

<Base
  title="Build log"
  description="How TriMixxx got here, phase by phase: a monolithic board that was never built, a deck taken apart into small boards, Mixxx on a Pi, Pro DJ Link, emulated decks and A/B releases."
>
  <section class="wrap section section--tight">
    <div class="section__head">
      <span class="kicker">Build log</span>
      <h1>From one board to 1.0.</h1>
      <p class="lede">
        Eight months of TriMixxx, one phase per post, oldest first. They were written in October
        2026, looking back over the repository's history; each is dated by when its phase ended.
      </p>
    </div>

    <ol class="log">
      {posts.map((post, i) => (
        <li class="log__item">
          <span class="log__dot" aria-hidden="true" />
          <a class="log__link" href={`/blog/${post.id}/`}>
            <div class="log__text">
              <span class="label">
                Part {i + 1} · {post.data.period}
              </span>
              <h2 class="log__title">{post.data.title}</h2>
              <p class="log__description">{post.data.description}</p>
              <span class="log__tags mono">{post.data.tags.map((tag) => `#${tag}`).join(" ")}</span>
            </div>
            <Picture
              src={post.cover.src}
              alt=""
              formats={["avif"]}
              fallbackFormat="webp"
              width={480}
              sizes="(min-width: 48rem) 15rem, 100vw"
              loading={i < 2 ? "eager" : "lazy"}
            />
          </a>
        </li>
      ))}
    </ol>

    <p class="log__rss muted">
      Follow new posts by <a href="/rss.xml">RSS</a>.
    </p>
  </section>
</Base>

<style>
  .log {
    position: relative;
    display: grid;
    gap: 1.25rem;
    margin: 0;
    padding: 0 0 0 2rem;
    list-style: none;
  }

  .log::before {
    content: "";
    position: absolute;
    top: 0.5rem;
    bottom: 0.5rem;
    left: 0.45rem;
    width: 1px;
    background: linear-gradient(180deg, var(--lime-line), var(--line) 30%, var(--line));
  }

  .log__item {
    position: relative;
  }

  .log__dot {
    position: absolute;
    top: 1.6rem;
    left: -1.85rem;
    width: 0.65rem;
    height: 0.65rem;
    background: var(--lime);
    box-shadow: 0 0 0.75rem rgb(136 255 0 / 60%);
  }

  .log__link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 15rem;
    gap: 1.5rem;
    align-items: center;
    padding: 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-raised);
    text-decoration: none;
    transition: border-color 0.2s ease;
  }

  .log__link:hover {
    color: inherit;
    border-color: var(--lime-line);
  }

  .log__link :global(img) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: var(--radius-sm);
    background: var(--panel);
  }

  .log__text {
    display: grid;
    gap: 0.5rem;
  }

  .log__title {
    font-size: clamp(1.25rem, 2.2vw, 1.6rem);
  }

  .log__link:hover .log__title {
    color: var(--lime);
  }

  .log__description {
    color: var(--text-muted);
  }

  .log__tags {
    color: var(--text-faint);
    font-size: 0.75rem;
  }

  .log__rss {
    margin-top: 2rem;
  }

  @media (width <= 48rem) {
    .log__link {
      grid-template-columns: minmax(0, 1fr);
    }

    .log__link :global(picture) {
      grid-row: 1;
    }
  }
</style>
