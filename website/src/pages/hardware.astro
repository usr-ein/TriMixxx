---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

import loopRender from "../assets/boards/loop.webp";
import midiLaserRender from "../assets/boards/midi-laser.webp";
import s3Render from "../assets/boards/midi-s3-mini.webp";
import oneButtonRender from "../assets/boards/one-button.webp";
import playCueRender from "../assets/boards/play-cue.webp";
import laserBack from "../assets/history/laser-play-cue-b.webp";
import laserFront from "../assets/history/laser-play-cue-f.webp";
import mainboardRender from "../assets/history/mainboard-3d.webp";
import v1Back from "../assets/renders/deck-v1-back.webp";
import v1Front from "../assets/renders/deck-v1-front.webp";
import v2Model from "../assets/renders/deck-v2-model.webp";
import v2Render from "../assets/renders/deck-v2-render.webp";
import Figure from "../components/Figure.astro";
import Photo from "../components/mdx/Photo.astro";
import { site } from "../data/site";
import Base from "../layouts/Base.astro";
import { photo } from "../lib/photos";

interface Board {
  id: string;
  name: string;
  role: string;
  status: "current" | "abandoned" | "never built";
  image: ImageMetadata;
  imageAlt: string;
  facts: readonly string[];
  schematics: readonly { label: string; href: string }[];
  source: string;
  photo?: string;
}

const tree = `${site.repo}/tree/main`;
const inside = await photo("2026-08-11-img-9013");

const boards: readonly Board[] = [
  {
    id: "midi-s3-mini",
    name: "midi_s3_mini",
    role: "The controller. Every control on the deck lands here, and MIDI leaves for the Pi.",
    status: "current",
    image: s3Render,
    imageAlt:
      "A 3D render of the midi_s3_mini board: a green PCB with headers for the LOLIN S3 Mini, a row of white JST connectors along two edges, a large capacitor and a screw terminal.",
    facts: [
      "LOLIN S3 Mini (ESP32-S3) on headers, 90 × 70 mm, two layers",
      "SRV05-4 TVS arrays and 1 kΩ series resistors on every input",
      "Reverse-polarity P-FET, soft start, a polyfuse footprint and a 1000 µF bulk cap",
      "An LDO set to 3.87 V so the board's supply wins over USB, and the USB side held off",
      "Dividers bring the rings' 5 V replies down to 3.24 V for the S3",
      "v2, fabbed 23 July 2026; silkscreen: “SEE YOU SPACE COWBOY…”",
    ],
    schematics: [
      { label: "Main sheet", href: "/schematics/midi-s3-mini/midi_s3_mini.svg" },
      { label: "Power", href: "/schematics/midi-s3-mini/midi_s3_mini-Power.svg" },
      { label: "Jog board", href: "/schematics/midi-s3-mini/midi_s3_mini-JOGB_ASSY.svg" },
    ],
    source: `${tree}/boards/midi_s3_mini`,
    photo: "2026-07-28-img-8937",
  },
  {
    id: "one-button",
    name: "one_button",
    role: "A ring node: one pad, two RGB LEDs, one RISC-V microcontroller. Every node is identical.",
    status: "current",
    image: oneButtonRender,
    imageAlt:
      "A 3D render of the OneButton board: a small square green PCB with a tact switch in the middle, two LEDs beside it, a tiny QFN chip and JST connectors on two sides.",
    facts: [
      "CH32V003F4U6, a 48 MHz RISC-V microcontroller in a 3 × 3 mm QFN",
      "Two 2020-size RGB LEDs on the WS2812 protocol, and a tact switch",
      "20 × 20 mm; JST-PH in and out, so nodes daisy-chain into a ring",
      "Relays the ring's frame byte by byte inside its UART interrupt",
      "One binary for every node; its address comes from its place in the ring",
      "Assembled by JLCPCB; flashed over one wire (SWIO)",
    ],
    schematics: [{ label: "Schematic", href: "/schematics/one-button/OneButton.svg" }],
    source: `${tree}/boards/one_button`,
    photo: "2026-07-28-img-8940",
  },
  {
    id: "play-cue",
    name: "play_cue_btn",
    role: "PLAY and CUE, each ringed by four LEDs that Mixxx lights.",
    status: "current",
    image: playCueRender,
    imageAlt:
      "A 3D render of the play/cue board: a bare copper PCB with two tact switches, each surrounded by four red 5 mm LEDs.",
    facts: [
      "No microcontroller: the S3 reads the switches and drives the LEDs",
      "Eight 5 mm LEDs, switched from 5 V by two 2N7000 MOSFETs",
      "100 nF on each switch, so the edge is slow and clean for the poller",
      "Laid out for a home etch: no vias, wide tracks",
    ],
    schematics: [{ label: "Schematic", href: "/schematics/play-cue/play_cue_btn.svg" }],
    source: `${tree}/boards/play_cue_btn`,
    photo: "2026-08-11-img-9014",
  },
  {
    id: "loop",
    name: "loop_btn",
    role: "LOOP IN, LOOP OUT and RELOOP, under the jog wheel.",
    status: "current",
    image: loopRender,
    imageAlt:
      "A 3D render of the loop board: a long bare copper PCB with three tact switches and two LEDs.",
    facts: [
      "Three switches and two LEDs; RELOOP has no light of its own",
      "LEDs sunk straight into the S3's GPIOs",
      "No microcontroller and no vias, like play/cue",
    ],
    schematics: [{ label: "Schematic", href: "/schematics/loop/loop_btn.svg" }],
    source: `${tree}/boards/loop_btn`,
  },
  {
    id: "midi-laser",
    name: "midi-laser-pcb",
    role: "The first standalone controller, May 2026: a Pro Micro and an I²C expander.",
    status: "abandoned",
    image: midiLaserRender,
    imageAlt:
      "A 3D render of the midi-laser board: a green PCB with an Arduino Pro Micro footprint, a DIP-28 expander and JST connectors.",
    facts: [
      "Arduino Pro Micro (ATmega32U4) and an MCP23017 on I²C, 80 × 60 mm",
      "Its bring-up list: no pinouts on the silkscreen, a divider on RX that belonged on TX, and RELOOP left off the expander",
      "Its bring-up and the ESP32-S3 board's design happened on the same day, 30 June",
    ],
    schematics: [{ label: "Schematic", href: "/schematics/midi-laser/midi-laser-pcb.svg" }],
    source: `${tree}/boards/midi-laser-pcb`,
    photo: "2026-06-25-img-8790",
  },
  {
    id: "mainboard",
    name: "CDJ-MainBoard",
    role: "The monolithic first design, Feb – Mar 2026: everything on one board.",
    status: "never built",
    image: mainboardRender,
    imageAlt:
      "KiCad's 3D view of the monolithic main board: a long green PCB with RCA jacks, USB ports and the Compute Module 5.",
    facts: [
      "Compute Module 5, PCM5122 DAC, USB-C PD at 20 V, an ATmega32U4 MIDI controller",
      "250 × 104 mm, four layers, 210 footprints, 406 vias",
      "Fully routed on 26 March 2026; removed in July, kept in the history",
    ],
    schematics: [],
    source: `${site.repo}/tree/02997e681e52c54710ede9e3cca202f4118eaf40/CDJ-MainBoard`,
  },
];

const parts = [
  [
    "Computer",
    "Raspberry Pi 4 Model B, 4 GB",
    "Runs Raspberry Pi OS, Mixxx and the deck's services",
  ],
  [
    "Screen",
    "Waveshare 10.1″ DSI LCD (C), 1280 × 800, touch",
    "The first deck has a 1024 × 600 touchscreen behind a lip",
  ],
  ["Sound", "Behringer UCA222 (TI PCM2902)", "RCA out to the mixer; RCA in for Record set"],
  ["Controller", "LOLIN S3 Mini (ESP32-S3)", "On midi_s3_mini"],
  ["Pads", "CH32V003F4U6 + 2 × RGB LED per node", "Two rings: 7 + 6 nodes on the first deck"],
  [
    "Jog wheel",
    "A CDJ-1000MK3 jog assembly",
    "Sharp GP1A038RBK optical sensor on a 3,240-line disk: 12,960 counts a turn; a touch switch in the platter",
  ],
  ["Tempo", "Centre-tapped slide potentiometer", "Read ratiometrically, sent as 14-bit MIDI"],
  ["Browse", "KY-040 push encoder", "Decoded with a state table, one tick per detent"],
  ["Buttons", "6 mm tact switches under printed caps", "With 5 mm LEDs on play/cue and loop"],
  [
    "Power",
    "IEC mains inlet and a 5 V, 30 W module (IRM-30-5ST)",
    "In the V2 chassis; passively cooled",
  ],
  ["Network", "RJ45 panel coupler", "eth0 for Pro DJ Link; Wi-Fi for everything else"],
  ["Chassis", "PETG-CF, printed", "V2: 423 × 329 × 85 mm"],
] as const;
---

<Base
  title="Hardware"
  description="TriMixxx's hardware: a 3D-printed chassis, an ESP32-S3 controller board, rings of CH32V003 pad nodes, play/cue and loop boards, a CDJ jog assembly and a Raspberry Pi 4. KiCad sources and schematics included."
>
  <section class="wrap section section--tight">
    <div class="section__head">
      <span class="kicker">Hardware</span>
      <h1>Boards you can order. A chassis you can print.</h1>
      <p class="lede">
        A Raspberry Pi 4 and a USB sound card do what computers and sound cards already do well.
        Everything a DJ touches goes through boards made for this deck: an ESP32-S3 controller, two
        rings of tiny RISC-V pad nodes, and plain boards for PLAY, CUE and the loops. All of them
        are KiCad projects in the repository.
      </p>
    </div>
  </section>

  <section class="wrap section section--line" id="chassis">
    <div class="split">
      <div class="split__text">
        <span class="kicker">Chassis V2</span>
        <h2>Shaped like a deck, printed at home.</h2>
        <p class="muted">
          Drawn in Fusion 360 around measurements of real decks, and printed in carbon-fibre PETG.
          The second version, from September 2026, sinks the deck to 85 mm, leans a 10.1″ DSI
          touchscreen back towards the DJ, and puts mains power, Ethernet and RCA on the rear.
        </p>
        <dl class="specs">
          <div>
            <dt>Body</dt>
            <dd>423 × 329 × 85 mm</dd>
          </div>
          <div>
            <dt>Jog platter</dt>
            <dd>210 mm, from a CDJ-1000MK3</dd>
          </div>
          <div>
            <dt>Tempo travel</dt>
            <dd>130 mm</dd>
          </div>
          <div>
            <dt>Screen</dt>
            <dd>10.1″, 1280 × 800, DSI</dd>
          </div>
          <div>
            <dt>Rear</dt>
            <dd>IEC mains, RJ45, RCA out and in</dd>
          </div>
        </dl>
      </div>
      <div class="split__media">
        <Figure
          src={v2Render}
          alt="A render of the V2 chassis: black, on pink legs, with the screen angled up behind the jog wheel."
          caption="The V2 chassis, raytraced, September 2026."
          frame="dark"
          zoom="chassis"
          sizes="(min-width: 62rem) 38rem, 100vw"
        />
      </div>
    </div>
    <div class="grid grid--3 chassis-more">
      <Figure
        src={v2Model}
        alt="The V2 chassis in Fusion 360, seen from the side: the fader slot lit green, the screen angled back, the rear panel with its sockets."
        caption="V2 in Fusion 360: the rear panel with mains, Ethernet and RCA."
        zoom="chassis"
        sizes="(min-width: 62rem) 24rem, 100vw"
      />
      <Figure
        src={v1Front}
        alt="The V1 chassis in Fusion 360: a grey box with an angled screen housing, the jog wheel and the tempo fader slot."
        caption="V1, June 2026: a CDJ-3000's envelope, 453 × 329 × 118 mm."
        zoom="chassis"
        sizes="(min-width: 62rem) 24rem, 100vw"
      />
      <Figure
        src={v1Back}
        alt="The back of the V1 chassis in Fusion 360, with cut-outs for power, Ethernet and audio."
        caption="V1 from behind: the sound card's outputs and inputs, power and LAN."
        zoom="chassis"
        sizes="(min-width: 62rem) 24rem, 100vw"
      />
    </div>
    <div class="grid grid--4 chassis-more">
      <Photo id="2026-10-02-img-9266" zoom="printed" sizes="(min-width: 62rem) 18rem, 100vw" />
      <Photo id="2026-09-17-img-9211" zoom="printed" sizes="(min-width: 62rem) 18rem, 100vw" />
      <Photo id="2026-09-09-img-9172" zoom="printed" sizes="(min-width: 62rem) 18rem, 100vw" />
      <Photo id="2026-06-03-img-8664" zoom="printed" sizes="(min-width: 62rem) 18rem, 100vw" />
    </div>
  </section>

  <section class="wrap section section--line" id="boards">
    <div class="section__head">
      <span class="kicker">The boards</span>
      <h2>Six boards, four in the deck.</h2>
      <p class="lede">
        Rendered from their KiCad sources. Each schematic opens as a vector drawing you can zoom
        into, notes in the margins included.
      </p>
    </div>
    <div class="boards">
      {boards.map((board) => (
        <article class="board" id={board.id}>
          <div class:list={["board__media", { "board__media--photo": board.photo }]}>
            <Picture
              src={board.image}
              alt={board.imageAlt}
              formats={["avif"]}
              fallbackFormat="webp"
              sizes="(min-width: 62rem) 30rem, 100vw"
              loading="lazy"
            />
            {board.photo && (
              <Photo id={board.photo} zoom="boards" sizes="(min-width: 62rem) 30rem, 100vw" />
            )}
          </div>
          <div class="board__body">
            <div class="board__head">
              <h3 class="mono board__name">{board.name}</h3>
              <span
                class:list={[
                  "pill",
                  {
                    "pill--lime": board.status === "current",
                    "pill--amber": board.status !== "current",
                  },
                ]}
              >
                {board.status}
              </span>
            </div>
            <p class="board__role">{board.role}</p>
            <ul class="board__facts">
              {board.facts.map((fact) => (
                <li>{fact}</li>
              ))}
            </ul>
            <div class="board__links">
              {board.schematics.map((sheet) => (
                <a class="btn btn--ghost btn--small" href={sheet.href}>
                  {sheet.label} <span class="visually-hidden">(SVG)</span>
                </a>
              ))}
              <a class="btn btn--ghost btn--small" href={board.source} rel="noopener">
                KiCad source
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  {inside && (
    <section class="wrap section section--line" id="inside">
      <div class="section__head">
        <span class="kicker">Inside</span>
        <h2>Open it up.</h2>
        <p class="lede">
          Under the top plate: the CDJ's jog mechanism, the chain of pad nodes, the play/cue and
          loop boards, and the wiring back to the controller. Under the screen: the Pi, the
          controller board and the power supply.
        </p>
      </div>
      <div class="grid grid--2">
        <Photo id="2026-08-11-img-9013" zoom="inside" sizes="(min-width: 62rem) 36rem, 100vw" />
        <Photo id="2026-10-10-img-9309" zoom="inside" sizes="(min-width: 62rem) 36rem, 100vw" />
        <Photo id="2026-07-28-img-8943" zoom="inside" sizes="(min-width: 62rem) 36rem, 100vw" />
        <Photo id="2026-10-10-img-9308" zoom="inside" sizes="(min-width: 62rem) 36rem, 100vw" />
      </div>
    </section>
  )}

  <section class="wrap section section--line" id="parts">
    <div class="section__head">
      <span class="kicker">Parts</span>
      <h2>What's inside a deck.</h2>
      <p class="lede">
        The second deck as built in October 2026. The jog wheel, and probably the fader, came out of
        a Pioneer CDJ-1000MK3; the buttons are new switches under printed caps.
      </p>
    </div>
    <div class="table-wrap" role="region" aria-label="The parts list" tabindex="0">
      <table>
        <thead>
          <tr>
            <th scope="col">Part</th>
            <th scope="col">What</th>
            <th scope="col">Notes</th>
          </tr>
        </thead>
        <tbody>
          {parts.map(([part, what, notes]) => (
            <tr>
              <th scope="row">{part}</th>
              <td>{what}</td>
              <td class="muted">{notes}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="wrap section section--line" id="home-made">
    <div class="split split--reverse">
      <div class="split__text">
        <span class="kicker">Made at home first</span>
        <h2>Etched with a laser before ordering.</h2>
        <p class="muted">
          The play/cue and loop boards were first made in the workshop: KiCad's negative copper
          plots turned into laser files by a small script, the laser ablating a mask, ferric
          chloride doing the rest, and the holes drilled by hand. Getting the two sides to line up
          cost four attempts, all from a viewBox offset the laser software didn't clip to. Then the
          same boards were prepared for JLCPCB.
        </p>
        <p>
          <a class="btn btn--ghost btn--small" href={`${tree}/handmade_pcb`} rel="noopener">
            make_bambu_ready.py
          </a>
        </p>
      </div>
      <div class="split__media grid grid--2">
        <Figure
          src={laserFront}
          alt="The play/cue board's front copper as a laser file: the outlines of every track and pad around two switch footprints."
          caption="play_cue_btn's front copper, as the laser file draws it."
          zoom="laser"
          sizes="(min-width: 62rem) 18rem, 100vw"
        />
        <Figure
          src={laserBack}
          alt="The same board's back copper as a laser file."
          caption="The back copper, for the other side of the same board."
          zoom="laser"
          sizes="(min-width: 62rem) 18rem, 100vw"
        />
      </div>
    </div>
  </section>
</Base>

<style>
  .split {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .split__text {
    display: grid;
    gap: 1.1rem;
    align-content: start;
  }

  .split--reverse .split__text {
    order: 2;
  }

  .specs {
    display: grid;
    gap: 0;
    margin: 0.5rem 0 0;
    border-top: 1px solid var(--line);
  }

  .specs div {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: 1rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--line);
  }

  .specs dt {
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .specs dd {
    margin: 0;
  }

  .chassis-more {
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .boards {
    display: grid;
    gap: 1.25rem;
  }

  .board {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
    gap: clamp(1.25rem, 3vw, 2.5rem);
    align-items: center;
    padding: clamp(1rem, 2.5vw, 1.75rem);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-raised);
  }

  .board__media {
    display: grid;
    gap: 0.75rem;
    align-items: center;
    border-radius: var(--radius-sm);
    background: radial-gradient(120% 90% at 50% 40%, #1d221d 0%, #0b0c0b 72%);
  }

  .board__media :global(img) {
    width: 100%;
    height: auto;
  }

  /* With a photo, the render and the photo sit side by side. */
  .board__media--photo {
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
  }

  .board__media :global(figure img) {
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .board__body {
    display: grid;
    gap: 0.9rem;
  }

  .board__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .board__name {
    font-family: var(--font-mono);
    font-size: 1.25rem;
    font-weight: 600;
    font-stretch: 100%;
    letter-spacing: 0;
  }

  .board__role {
    color: var(--text);
  }

  .board__facts {
    display: grid;
    gap: 0.4rem;
    margin: 0;
    padding-left: 1.1rem;
    color: var(--text-muted);
    font-size: 0.93rem;
  }

  .board__facts li::marker {
    color: var(--lime);
  }

  .board__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .btn--small {
    padding: 0.6em 1em;
    font-size: 0.78rem;
  }

  @media (width <= 62rem) {
    .split,
    .board {
      grid-template-columns: minmax(0, 1fr);
    }

    .split--reverse .split__text {
      order: 0;
    }
  }
</style>
