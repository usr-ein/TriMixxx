---
import type { ImageMetadata } from "astro";

import deckView from "../assets/screens/deck-build-and-drop.webp";
import autoplayGenres from "../assets/screens/autoplay-genres.webp";
import endRecording from "../assets/screens/end-recording.webp";
import history from "../assets/screens/history-plain-plays.webp";
import homeList from "../assets/screens/after-only-the-stick.webp";
import plainTags from "../assets/screens/plain-stick-tags.webp";
import trackList from "../assets/screens/browser-bpm-covers.webp";
import silencePrompt from "../assets/screens/silence-prompt.webp";
import writing from "../assets/screens/writing.webp";
import Figure from "../components/Figure.astro";
import Base from "../layouts/Base.astro";
import { photo } from "../lib/photos";

type Status = "cdj" | "deck" | "emulated";

interface Feature {
  title: string;
  text: string;
  status: Status;
}

interface Shot {
  src: ImageMetadata;
  alt: string;
  caption: string;
}

interface Group {
  id: string;
  kicker: string;
  title: string;
  lede: string;
  features: readonly Feature[];
  shots: readonly Shot[];
}

const statusLabel: Record<Status, string> = {
  cdj: "with real CDJs",
  deck: "on real decks",
  emulated: "emulated so far",
};

const groups: readonly Group[] = [
  {
    id: "playing",
    kicker: "Playing",
    title: "The controls a DJ already knows.",
    lede: "Everything on the deck is a physical control, wired the way a CDJ's are. The screen shows; the hands play.",
    features: [
      {
        title: "Transport, loops and cues",
        text: "PLAY and CUE, LOOP IN, LOOP OUT and RELOOP, four hot cues in colour, 8- and 4-beat loops, loop ×2 and ÷2, slip, and master tempo.",
        status: "deck",
      },
      {
        title: "A jog wheel from a CDJ",
        text: "A CDJ-1000MK3 jog assembly: 12,960 counts a turn, read by the controller's hardware counter. Touch the platter to scratch; turn it untouched to bend.",
        status: "deck",
      },
      {
        title: "A 14-bit tempo fader",
        text: "Ranges of ±6, ±10 and ±16 % and WIDE. After SYNC, a range change or a load, the fader waits until it crosses the playing tempo before it takes over, and the screen shows where it would go.",
        status: "deck",
      },
      {
        title: "Pads that light up with meaning",
        text: "Thirteen RGB pads on two rings, coloured by what they do: the tempo range, hot cue colours, slip flashing, KEY SYNC in purple. A rainbow runs round both rings at start-up, and every light goes out at shutdown.",
        status: "deck",
      },
    ],
    shots: [
      {
        src: deckView,
        alt: "The deck view of Birth4000 by Floating Points at 126.25 BPM: on the left a build-up in yellow mids and white highs with no bass, a beat of silence at the playhead, then the drop with blue bass under every kick; white beat lines, red downbeats, and the whole track's overview along the bottom.",
        caption:
          "The deck view. The only button left on screen is Shut down; everything else is on the deck.",
      },
    ],
  },
  {
    id: "library",
    kicker: "Library",
    title: "Your sticks, and a browser for a thumb.",
    lede: "Plug in a USB stick exported from rekordbox, or one with nothing but music files on it, or one of each. The deck reads them as they are, mounted read-only.",
    features: [
      {
        title: "rekordbox sticks, as exported",
        text: "Playlists, beat grids, hot cues, loops, colour waveforms, cover art and Camelot keys, read straight off the stick. Nothing is analysed again.",
        status: "deck",
      },
      {
        title: "A CDJ-style browser",
        text: "A full-screen menu the encoder drives: search with an on-screen keyboard, playlists, folders, genre, artist, album, label, key with compatible keys in green, BPM in buckets one fader range wide, last played and date added. SORT on twelve fields. A long press on BACK returns to the deck and keeps your place.",
        status: "deck",
      },
      {
        title: "Plain sticks",
        text: "A stick of music files with no rekordbox library browses by folder, with tags and covers. Only the track you load is analysed.",
        status: "deck",
      },
      {
        title: "Pull a stick out, any time",
        text: "Sticks are mounted read-only, so yanking one mid-set can't corrupt it: no eject button, no damaged library. The deck plays its own copy of the track, so the music doesn't stop either. The one write is a recorded set you ask the deck to save, after which the stick is read-only again.",
        status: "deck",
      },
      {
        title: "Loads in half a second",
        text: "A track starts while it is still arriving: its start, then its end, then the rest following the playhead. From a CDJ, about 0.56 s from button to sound. Off a slow stick, a 52 MB AIFF now starts in 0.46 s instead of 18 (measured on an emulated stick).",
        status: "cdj",
      },
      {
        title: "Autoplay",
        text: "Pick a stick and a genre. The deck plays it, choosing the unplayed track nearest in BPM each time, round after round, until you take over.",
        status: "emulated",
      },
    ],
    shots: [
      {
        src: trackList,
        alt: "The deck's browser at USB 1, BPM, 126 – 142: eight tracks sorted by tempo, each with its own cover, title, artist, BPM and Camelot key, the first highlighted.",
        caption: "A rekordbox stick's tracks by tempo, each with its cover, BPM and key.",
      },
      {
        src: plainTags,
        alt: "A plain stick's folder: tracks listed by their tags, some with cover art, one only by its filename.",
        caption:
          "A plain stick, browsed by folder: tags where the files have them, the filename where they don't.",
      },
      {
        src: autoplayGenres,
        alt: "The Autoplay menu listing the genres on a stick: Disco, House, Techno, and the number of tracks in each.",
        caption: "Autoplay: choose a genre, and the deck plays it.",
      },
    ],
  },
  {
    id: "link",
    kicker: "Pro DJ Link",
    title: "On the link, beside the CDJs.",
    lede: "Plug the deck's Ethernet into a booth's Pro DJ Link network and it becomes a player like the others, built from captures of real CDJ-2000NXS players.",
    features: [
      {
        title: "Browse and load from CDJs",
        text: "The deck claims a player number, lists every CDJ's USB and SD, browses them like its own sticks, and loads and plays their tracks with their grids, cues and waveforms.",
        status: "cdj",
      },
      {
        title: "Serve your sticks to CDJs",
        text: "CDJs see the deck under LINK and play its sticks: all eleven browse categories, search, sorting, key matching, artwork, hot cues and both waveforms.",
        status: "cdj",
      },
      {
        title: "Two sticks, both on the link",
        text: "Plug in two sticks and CDJs see both: the first as the deck's USB, the second as its SD card, the two slots a CDJ offers itself. An NXS browsed, loaded and played a rekordbox stick from the SD slot; a plain stick there is yet to be tried.",
        status: "emulated",
      },
      {
        title: "SYNC and MASTER",
        text: "The deck follows a CDJ's tempo and phase, and a CDJ follows the deck's. With the deck as master at −3.05 %, a CDJ followed it to 116.34 BPM, to the hundredth.",
        status: "cdj",
      },
      {
        title: "Master, the way CDJs pass it",
        text: "The first deck to play takes master, a stopped master hands it on, and a hand-over takes 67 to 133 ms, as between two CDJs. SYNC lands with one exact beat-jump, then holds phase with a trim of at most 1 % that never shows on the BPM.",
        status: "emulated",
      },
      {
        title: "A phase meter",
        text: "Two rows in the header: the deck you are mixing against, and your own.",
        status: "cdj",
      },
      {
        title: "KEY SYNC",
        text: "A press shifts the track onto the master's Camelot number, between −5 and +6 semitones, in the track's own mode. A hold opens the twelve keys to pick from. The pad stays purple while the track is out of its own key.",
        status: "emulated",
      },
      {
        title: "Plain sticks both ways",
        text: "A CDJ browses the deck's plain stick by folder and plays from it; a CDJ's plain stick shows up on the deck as a folder source.",
        status: "emulated",
      },
      {
        title: "History",
        text: "What played on the link during this power-up and the two before, whoever played it: this deck, another TriMixxx or a CDJ. A timeline of what overlapped and for how long, with covers.",
        status: "emulated",
      },
    ],
    shots: [
      {
        src: history,
        alt: "The History list: tracks played on the link this session, each with the stick it came from and how long it played, two of them on one row because they played together.",
        caption: "History: two tracks on one row played together, for 3 s here.",
      },
    ],
  },
  {
    id: "record",
    kicker: "Record set",
    title: "Take the night home.",
    lede: "The deck's sound card has an input. Plug the mixer's record out into it, and the deck records the set.",
    features: [
      {
        title: "Recorded to the card, written to your stick",
        text: "A 320 kbit/s MP3 is written to the deck's card as you play, never held in RAM. At the end it goes onto one of your sticks, with the History's track list beside it.",
        status: "emulated",
      },
      {
        title: "It notices the silence",
        text: "Up to three hours. After five minutes of silence, the deck asks whether the set is over.",
        status: "emulated",
      },
    ],
    shots: [
      {
        src: endRecording,
        alt: "The home list while recording: an End recording row with the elapsed time and a left and right level meter.",
        caption: "While it records: the time so far, and a meter for each side.",
      },
      {
        src: silencePrompt,
        alt: "A prompt over the deck: End the recording? Nothing on the input for 5 minutes. Buttons: Keep recording, End recording.",
        caption: "Five minutes of silence, and the deck asks.",
      },
      {
        src: writing,
        alt: "The set being written to a stick, 42 % done, with a warning not to remove the stick.",
        caption: "Writing the set to a stick, 16 MB at a time.",
      },
    ],
  },
  {
    id: "system",
    kicker: "Reliability",
    title: "Built to survive a booth.",
    lede: "Power gets pulled, cables get yanked, Wi-Fi isn't there. The deck is designed to shrug all of it off.",
    features: [
      {
        title: "Updates that roll back",
        text: "A new release goes into the deck's idle slot and starts as a trial. If the network and ssh don't come up within 150 s, the deck goes back to the release it ran before. Diagnostics can restart into the other slot.",
        status: "deck",
      },
      {
        title: "Safe to pull the plug",
        text: "The system is read-only under a layer in RAM, the logs live in RAM, and the settings are never written back, so pulling the power can't corrupt the system.",
        status: "deck",
      },
      {
        title: "Always comes back as a deck",
        text: "Whatever fails at start-up, the deck falls back to Mixxx, and Mixxx restarts two seconds after any exit.",
        status: "deck",
      },
      {
        title: "Up in seconds",
        text: "The logo is on screen about 8 s after power-on, the whole boot takes about 15 s, and the boot log keeps printing behind the splash.",
        status: "deck",
      },
      {
        title: "Diagnostics",
        text: "CPU, temperature, throttling, underruns, the network and the release, an output trim of ±6 dB and the panel's brightness, on one page.",
        status: "deck",
      },
      {
        title: "Its own Wi-Fi",
        text: "With no network to join 45 s into a boot, the deck becomes a hotspot named after itself, so a phone can always reach it.",
        status: "deck",
      },
    ],
    shots: [
      {
        src: homeList,
        alt: "The deck's home list: a stick called DJSTICK, then Autoplay, History, Record set, Diagnostics and Shut down.",
        caption:
          "The home list: the sticks first, then Autoplay, History, Record set, Diagnostics and Shut down.",
      },
    ],
  },
];

const modes = [
  {
    gesture: "Hold PLAY at power-on",
    name: "DOOM",
    text: "The deck boots into DOOM (1993). The jog turns, touching it fires, the tempo fader is the throttle, and ring A's seven pads are the seven weapons. The game is a stock chocolate-doom: the deck's controls reach it as a virtual keyboard and mouse.",
  },
  {
    gesture: "Hold CUE at power-on",
    name: "Rescue console",
    text: "A logged-in terminal on the left of the touchscreen and an on-screen keyboard on the right, for when something needs fixing and there's no keyboard in the booth. The pads type the arrow keys.",
  },
  {
    gesture: "Hold LOOP IN + LOOP OUT for 2 s",
    name: "Back to the deck",
    text: "From DOOM or the console, the one chord nobody holds by accident brings the deck back to Mixxx. A power cycle always does too.",
  },
] as const;

const share = await photo("2026-10-04-img-9282");
---

<Base
  title="Features"
  description="What TriMixxx does: CDJ-style controls, rekordbox and plain USB sticks, a browser for a thumb, Pro DJ Link with real CDJs, SYNC and KEY SYNC, History, Record set, A/B updates that roll back, and DOOM."
  image={share?.data.image}
  imageAlt={share?.data.alt}
>
  <section class="wrap section section--tight">
    <div class="section__head">
      <span class="kicker">Features</span>
      <h1>Everything a deck does. And a few things decks don't.</h1>
      <p class="lede">
        Everything below is in release 1.0.2. Each feature says how far it has been taken: with real
        CDJs on the link, on the real decks, or so far only on emulated decks and emulated CDJs.
      </p>
    </div>
    <ul class="legend" aria-label="Status labels">
      <li>
        <span class="pill pill--lime">with real CDJs</span> Shown with real CDJ-2000NXS players
      </li>
      <li>
        <span class="pill pill--cyan">on real decks</span> Played on the TriMixxx decks
      </li>
      <li>
        <span class="pill pill--amber">emulated so far</span> Shown on emulated decks and CDJs; the
        real-hardware check is still to come
      </li>
    </ul>
    <nav class="jump" aria-label="Feature groups">
      {groups.map((group) => (
        <a class="pill" href={`#${group.id}`}>
          {group.kicker}
        </a>
      ))}
      <a class="pill" href="#modes">
        Hidden modes
      </a>
    </nav>
  </section>

  {groups.map((group) => (
    <section class="wrap section section--line group" id={group.id}>
      <div class="group__head">
        <span class="kicker">{group.kicker}</span>
        <h2>{group.title}</h2>
        <p class="lede">{group.lede}</p>
      </div>
      <div class="group__body">
        <ul class="features">
          {group.features.map((feature) => (
            <li class="features__item">
              <div class="features__head">
                <h3>{feature.title}</h3>
                <span
                  class:list={[
                    "pill",
                    {
                      "pill--lime": feature.status === "cdj",
                      "pill--cyan": feature.status === "deck",
                      "pill--amber": feature.status === "emulated",
                    },
                  ]}
                >
                  {statusLabel[feature.status]}
                </span>
              </div>
              <p>{feature.text}</p>
            </li>
          ))}
        </ul>
        <div class="group__shots">
          {group.shots.map((shot) => (
            <Figure
              src={shot.src}
              alt={shot.alt}
              caption={shot.caption}
              frame="screen"
              zoom="features"
              sizes="(min-width: 62rem) 32rem, 100vw"
            />
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="wrap section section--line" id="modes">
    <div class="group__head">
      <span class="kicker">Hidden modes</span>
      <h2>Hold a button at power-on.</h2>
      <p class="lede">
        The deck reads its own buttons while it boots, and becomes something else when one is held.
      </p>
    </div>
    <div class="grid grid--3">
      {modes.map((mode) => (
        <article class="card">
          <span class="label">{mode.gesture}</span>
          <h3>{mode.name}</h3>
          <p>{mode.text}</p>
        </article>
      ))}
    </div>
  </section>
</Base>

<style>
  .legend {
    display: grid;
    gap: 0.6rem;
    margin: 0 0 2rem;
    padding: 0;
    list-style: none;
    color: var(--text-muted);
    font-size: 0.92rem;
  }

  .legend li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }

  .legend .pill {
    min-width: 9.5rem;
    justify-content: center;
  }

  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .jump a {
    text-decoration: none;
  }

  .jump a:hover {
    border-color: var(--lime);
    color: var(--lime);
  }

  .group__head {
    display: grid;
    gap: 1rem;
    max-width: 48rem;
    margin-bottom: clamp(1.5rem, 4vw, 2.75rem);
  }

  .group__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: start;
  }

  .features {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .features__item {
    display: grid;
    gap: 0.5rem;
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--line);
  }

  .features__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
  }

  .features__head h3 {
    font-size: 1.12rem;
  }

  .features__item p {
    color: var(--text-muted);
    font-size: 0.97rem;
  }

  .group__shots {
    position: sticky;
    top: calc(var(--header-h) + env(safe-area-inset-top, 0px) + 1.5rem);
    display: grid;
    gap: 1.5rem;
  }

  @media (width <= 62rem) {
    .group__body {
      grid-template-columns: minmax(0, 1fr);
    }

    .group__shots {
      position: static;
    }
  }
</style>
