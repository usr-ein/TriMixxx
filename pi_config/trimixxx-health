#!/bin/sh
# Keep the release this start runs, or fall back (trimixxx-health.service,
# pi-qemu/PLAN.md §5.2). The slots and autoboot.txt are rpi-tryboot's business
# (RAUC's backend); this decides from what the deck does.
#
# One question decides (Sam, 2026-10-08): can the deck take the next release?
# It can when it's on a network, by any of the three ways in -- the Ethernet
# cable (link-local), home Wi-Fi, or its own hotspot -- and sshd runs. Nothing
# else is checked. Mixxx, the sound or the S3 may be broken; the next release
# fixes them, over the air.
#
#   a trial (the firmware's tryboot)
#       The deck can take the next release within 150 s: `rauc status
#       mark-good`, which commits the slot. It can't, or RAUC can't commit it:
#       exit 1 (after `rauc status mark-bad`); systemd then reboots, and with
#       the trial flag used up the committed slot starts.
#   a normal start
#       autoboot.txt missing or damaged: restore it from its copy, and reboot
#       if that commits the other slot. One edited by hand to commit the slot
#       running is kept (rpi-tryboot repair). Then, if a valid autoboot.txt
#       commits another slot than the one running -- the bootloader's watchdog
#       started A because the committed slot failed before Linux (phase 1,
#       T10), or a `reboot N` by hand -- and this one can take the next
#       release: mark the other bad and commit this one. If it can't, change
#       nothing.
#
# Exits non-zero only for a trial that failed, so a normal start is never
# rebooted by it.
set -u
backend=/usr/lib/rauc/rpi-tryboot
why="not checked yet"
# What each start decided, on the state partition both slots share. The
# journal is in RAM, so after a trial failed this is what says why the update
# rolled back. One previous file is kept.
history=/var/lib/rauc/trimixxx-health.log
[ "$(stat -c %s "$history" 2>/dev/null || echo 0)" -lt 65536 ] || mv -f "$history" "$history.1"

# Its lines are a contract with Mixxx. RAUC keeps no record of a slot marked
# bad, so Diagnostics reads this file to know which slot failed its last trial
# and refuses to restart into it (DeckRelease::verdictOf, in the fork's
# src/widget/deck/deckrelease.cpp; its tests, deckrelease_test.cpp, copy these
# lines). A line's shape, and the messages for a trial started, a slot
# committed and a slot marked bad, change only together with those.
log() {
    echo "health: $*"
    echo "trimixxx-health: $*" > /dev/kmsg 2>/dev/null || true
    echo "$(date -u +%FT%TZ) +$(uptime_s)s $*" >> "$history" 2>/dev/null || true
}

# The deck can take the next release: NetworkManager has it on a network, and
# sshd runs. Any of NetworkManager's connected states counts: `connected` on
# home Wi-Fi, and `connected (local only)`, which is what the cable's
# link-local profile and the hotspot give, with no route out. On the loopback
# alone it says `disconnected` (all three measured, phase 4). The hotspot
# starts 45 to 75 s after NetworkManager (trimixxx-wifi-fallback), well within
# the wait.
reflashable() {
    state=$(nmcli -t -f STATE general 2>/dev/null)
    case "$state" in
    connected*) ;;
    *) why="no network: NetworkManager says ${state:-nothing}"; return 1 ;;
    esac
    systemctl is-active --quiet ssh.service || { why="sshd isn't running"; return 1; }
}

# Seconds since the kernel started. Not the wall clock: a Pi has no clock that
# keeps time, so it starts at the last time it saved, and NTP then jumps it
# forward by however long the deck was off. Measured that way, a trial's wait
# ended the moment NTP answered (phase 4, F4).
uptime_s() { cut -d. -f1 /proc/uptime; }

reflashable_within() { # seconds
    end=$(( $(uptime_s) + $1 ))
    while [ "$(uptime_s)" -lt "$end" ]; do
        reflashable && return 0
        sleep 2
    done
    return 1
}

booted=$("$backend" booted) || { log "cannot tell which slot started; leaving everything as it is"; exit 0; }
case "$booted" in
*" trial")
    slot=${booted% trial}
    log "trial of slot $slot ($(sed -n 's/^VERSION=//p' /etc/trimixxx-release 2>/dev/null))"
    if reflashable_within 150; then
        if rauc status mark-good; then
            log "slot $slot can take the next release: committed"
            exit 0
        fi
        # RAUC is what installs the next release.
        log "slot $slot: RAUC can't commit it, so it can't take the next release either; rebooting to the committed slot"
        exit 1
    fi
    rauc status mark-bad
    log "slot $slot can't take the next release after 150 s ($why): marked bad, rebooting to the committed slot"
    exit 1
    ;;
esac

if [ "$("$backend" repair)" = reboot ]; then
    log "autoboot.txt restored; rebooting into the committed slot"
    systemctl reboot
    exit 0
fi
committed=$("$backend" committed) || exit 0
[ "$committed" = "$booted" ] && exit 0
log "slot $booted started, but $committed is committed: the bootloader's watchdog fell back (or a reboot by hand)"
if reflashable_within 150; then
    rauc status mark-bad other && rauc status mark-good &&
        log "slot $booted can take the next release: committed, $committed marked bad"
else
    log "slot $booted can't take the next release either ($why): nothing changed"
fi
exit 0
