[Unit]
# Keep the release this start runs, or fall back (pi-qemu/PLAN.md §5.2): a
# trial is committed if the deck can take the next release (a network, and
# sshd), or marked bad; a normal start repairs a damaged autoboot.txt, and
# reconciles after the bootloader's watchdog started the other slot. See
# trimixxx-health.
#
# Installed on every deck, enabled only on a release card (`make release`),
# which is also the only one with RAUC's /etc/rauc/system.conf. Nothing of the
# deck's own (Mixxx, the MIDI bridge) is waited for or checked.
Description=TriMixxx: keep the release this start runs, or fall back
Documentation=file:/usr/local/lib/trimixxx/health
After=NetworkManager.service ssh.service
ConditionPathExists=/etc/rauc/system.conf

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/lib/trimixxx/health
# The script exits non-zero only for a trial that failed: the reboot that
# follows starts the committed slot, the trial flag being gone. It gives up
# waiting at 150 s; this is the backstop.
TimeoutStartSec=180
FailureAction=reboot

[Install]
WantedBy=multi-user.target
