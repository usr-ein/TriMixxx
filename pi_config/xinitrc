#!/bin/sh

# No screen blanking, ever
xset s off
xset -dpms
xset s noblank

# brightness
#xrandr --output HDMI-1 --brightness 1.0

# Hide cursor immediately (touchscreen)
unclutter -idle 0 -root &

# Minimal WM for reliable fullscreen
#picom --vsync --backend glx --unredir-if-possible --glx-no-stencil --glx-no-rebind-pixmap &
picom --vsync --backend glx --unredir-if-possible --glx-no-stencil --glx-no-rebind-pixmap &
sleep 1
matchbox-window-manager -use_titlebar no &

# ---- which app is this session? ---------------------------------------------
# trimixxx-launchd decides at boot (holding PLAY picks Doom) and writes the
# answer here. See ../trimixxx-launcher/README.md.
#
# THE FAILSAFE IS THE DEFAULT: no file, an unreadable file, or a mode this does
# not know all fall through to Mixxx below. A launch manager that failed to
# start must never be able to stop the deck from being a deck.
MODE_FILE=/run/trimixxx/mode
mode="$(cat "$MODE_FILE" 2>/dev/null || true)"

case "$mode" in
doom)
    # Doom is a ONE-SHOT. The mode is handed back before this session ends, so
    # a Doom that dies instantly falls through to Mixxx right here rather than
    # exiting the session into a getty respawn loop -- which is what a
    # missing WAD would otherwise cause, on a deck with no keyboard to stop it.
    #
    # trimixxx-launchd notices the file change and stops the key bridge, so the
    # deck stops typing before Mixxx takes over.
    # Logged to a file, not the console: if Doom fails to start (a missing WAD,
    # say) the session moves straight on to Mixxx and the message would be gone
    # before anyone could read it.
    trimixxx-doom >>/tmp/trimixxx-doom.log 2>&1 ||
        echo "trimixxx-doom exited $? -- see /tmp/trimixxx-doom.log; starting Mixxx" >&2
    printf 'mixxx\n' > "$MODE_FILE" 2>/dev/null || true
    ;;
esac

# Auto-restart Mixxx if it crashes; sleep prevents tight loops
#
# To log audio underruns, add --developer to the mixxx line below. Without it
# SoundManager::underflowHappened() sets its flag and returns silently
# (soundmanager.h), so grepping the log for xruns always finds nothing whether
# or not the buffer is coping. With it, each one logs "underflowHappened code: N".
#
# Do NOT leave it on for a gig. That warning is printed from the audio callback and
# qWarning locks -- Mixxx's own comment on the line says it "will make the problem
# worse", i.e. this flag can itself cause the dropouts it reports. It is a
# measuring tool, not a setting. The live counter in Preferences -> Sound Hardware
# ([App],audio_latency_overload_count) needs no flag and costs nothing.
# Keep one previous run and no more.
#
# --log-level debug writes tens of megabytes an hour, and both logs are on the
# SD card: stderr.log had reached 200 MB before anyone looked. Rotating on start
# rather than trimming on a timer means the log covering a crash is still whole
# when the auto-restart below brings Mixxx back, which is exactly when it is
# worth reading.
rotate_log() {
    [ -s "$1" ] || return 0
    mv -f "$1" "$1.1" 2>/dev/null || true
}

while true; do
    rotate_log ~/.mixxx/stderr.log
    rotate_log ~/.mixxx/mixxx.log
    mixxx --fullScreen --developer --log-level debug --log-flush-level info 2>>~/.mixxx/stderr.log
    sleep 2
done
