#!/bin/sh

# No screen blanking, ever
xset s off
xset -dpms
xset s noblank

# brightness
#xrandr --output HDMI-1 --brightness 1.0

# ---- which screen is the deck's ----------------------------------------------
# The deck's own panel is on DSI (trimixxx2: a Waveshare 10.1" DSI LCD (C),
# 1280x800, `vc4-kms-dsi-waveshare-panel` in config.txt). An HDMI monitor is a
# debugging aid, and plugged in alongside the panel it must MIRROR it rather
# than extend the desktop: X's default lays outputs side by side, which puts
# Mixxx's fullscreen window on whichever output is listed first and stretches
# the touchscreen across both.
#
# --scale-from fits the panel's picture to the monitor whatever the monitor's own
# mode, and keeps the X screen exactly the panel's size -- so the window
# manager's idea of "fullscreen" and the touchscreen's coordinate range both stay
# the panel's, even with a 3440x1440 monitor attached. The touch is pinned to the
# panel as well, for when scaling is refused and the screen grows after all.
#
# Runs before the window manager starts, so it starts on the final geometry. A
# monitor plugged in mid-session is not picked up until the session restarts
# (sudo systemctl restart getty@tty1). A DSI output reads "connected" whenever
# its overlay is loaded, panel or not -- harmless: the mirror is then the only
# picture there is. No DSI output at all (an HDMI-only deck) skips all of this,
# and X's defaults are right for it.
#
# The emulated deck (pi-qemu) has no KMS at all: X runs on the firmware
# framebuffer, set to the panel's size, and xrandr calls its one output
# "default". That is the panel there, so it is scaled the same way. A deck
# always has vc4 KMS, so it never sees this output.
panel="$(xrandr --query | awk '/^DSI-[0-9]+ connected/ {print $1; exit}')"
[ -n "$panel" ] || panel="$(xrandr --query | awk '/^default connected/ {print $1; exit}')"
if [ -n "$panel" ]; then
    xrandr --output "$panel" --auto --primary --pos 0x0
    size="$(xrandr --query | awk -v p="$panel" '$1 == p {
        for (i = 2; i <= NF; i++) if ($i ~ /^[0-9]+x[0-9]+\+/) { split($i, g, "+"); print g[1]; exit }
    }')"
    for out in $(xrandr --query | awk -v p="$panel" '$2 == "connected" && $1 != p {print $1}'); do
        xrandr --output "$out" --auto --same-as "$panel" --scale-from "$size" ||
            xrandr --output "$out" --auto --same-as "$panel"
    done
    for id in $(xinput list | awk 'tolower($0) ~ /slave +pointer/ && tolower($0) ~ /touch|goodix/ &&
            match($0, /id=[0-9]+/) {print substr($0, RSTART + 3, RLENGTH - 3)}'); do
        xinput map-to-output "$id" "$panel" 2>/dev/null
    done

    # The skin is pinned to 1024x600 (every top-level group in skin.xml has
    # Minimum = Maximum size), so on a bigger panel it sits top-left with empty
    # bands to the right and below. Scale Mixxx up until the skin meets the
    # panel's width or height, whichever comes first: 1.25 on a 1280x800 panel,
    # which fills the width and leaves 40 logical (50 real) px at the bottom; no
    # scaling at all on a 1024x600 one. Text stays sharp, bitmap art is
    # resampled. QT_SCALE_FACTOR overrides mixxx.cfg's [Config] ScaleFactor
    # (adjustScaleFactor() in mixxx/src/main.cpp), which is what keeps this
    # per-unit while every deck shares one mixxx.cfg.
    scale="$(echo "$size" | awk -F x '$2 > 0 {
        s = $1 / 1024; t = $2 / 600; if (t < s) s = t; if (s != 1) printf "%g", s }')"
    [ -n "$scale" ] && export QT_SCALE_FACTOR="$scale"
fi

# Hide cursor immediately (touchscreen)
unclutter -idle 0 -root &

# Minimal WM for reliable fullscreen
#picom --vsync --backend glx --unredir-if-possible --glx-no-stencil --glx-no-rebind-pixmap &
picom --vsync --backend glx --unredir-if-possible --glx-no-stencil --glx-no-rebind-pixmap &
sleep 1
matchbox-window-manager -use_titlebar no &

# ---- which app is this session? ---------------------------------------------
# trimixxx-launchd decides at boot (holding PLAY picks Doom) and writes the
# answer here. See ../trimixxx-launcher/README.md.
#
# THE FAILSAFE IS THE DEFAULT: no file, an unreadable file, or a mode this does
# not know all fall through to Mixxx below. A launch manager that failed to
# start must never be able to stop the deck from being a deck.
MODE_FILE=/run/trimixxx/mode
mode="$(cat "$MODE_FILE" 2>/dev/null || true)"

case "$mode" in
doom)
    # Doom is a ONE-SHOT. The mode is handed back before this session ends, so
    # a Doom that dies instantly falls through to Mixxx right here rather than
    # exiting the session into a getty respawn loop -- which is what a
    # missing WAD would otherwise cause, on a deck with no keyboard to stop it.
    #
    # trimixxx-launchd notices the file change and stops the key bridge, so the
    # deck stops typing before Mixxx takes over.
    # Logged to a file, not the console: if Doom fails to start (a missing WAD,
    # say) the session moves straight on to Mixxx and the message would be gone
    # before anyone could read it.
    trimixxx-doom >>/tmp/trimixxx-doom.log 2>&1 ||
        echo "trimixxx-doom exited $? -- see /tmp/trimixxx-doom.log; starting Mixxx" >&2
    printf 'mixxx\n' > "$MODE_FILE" 2>/dev/null || true
    ;;
esac

# Auto-restart Mixxx if it crashes; sleep prevents tight loops
#
# ---- logs: in RAM, never on the SD card ---------------------------------------
# Both logs live in LOG_DIR on /tmp, which is a tmpfs: mixxx.log because the
# fork's --log-path puts it there, stderr.log because of the redirect below. On
# the card they were its one steady writer -- a write every couple of seconds
# while Mixxx was up -- so a power cut was likely to catch one in flight
# (measured 2026-10-02). The price is that they do not survive a reboot: read
# them, or copy them off, before one. --log-path is the fork's: stock Mixxx
# (/usr/bin/mixxx.apt) exits on an option it does not know, so a rollback to it
# has to drop the flag too.
#
# --log-level only filters stderr. mixxx.log gets every Debug and Info message
# whatever it says (handleMessage() in logging.cpp, a TODO since 2.4.0), so a
# lower level would not have spared the card. With debug, stderr.log carries
# the full stream as well, and stderr is unbuffered: after a crash its tail is
# the one to trust, since mixxx.log only flushes at --log-flush-level.
#
# --developer is OFF. It is a measuring tool, not a setting:
#   * It makes underruns visible. Without it SoundManager::underflowHappened()
#     sets its flag and returns silently (soundmanager.h); with it each one logs
#     "underflowHappened code: N". But that warning is printed from the audio
#     callback and qWarning locks -- Mixxx's own comment on the line says it
#     "will make the problem worse", i.e. the flag can cause the dropouts it
#     reports. The live counter in Preferences -> Sound Hardware
#     ([App],audio_latency_overload_count) needs no flag and costs nothing.
#   * It times every event in MixxxApplication::notify() and logs each one over
#     a threshold, which on this hardware is most UI events:
#       Processing QEvent::UpdateRequest for object OpenGLWindow(0x...) took 10 ms
#     That one message was 112,546 of the 113,212 lines in a 12-minute session's
#     mixxx.log (2026-10-02), and has been measured at 2 MB/s.
# Add it to the mixxx line below for a measuring session, never for a gig.
LOG_DIR=/tmp/mixxx

# One previous run per log and no more. Rotating on start rather than trimming
# on a timer means the log covering a crash is still whole when the auto-restart
# below brings Mixxx back, which is exactly when it is worth reading.
rotate_log() {
    [ -s "$1" ] || return 0
    mv -f "$1" "$1.1" 2>/dev/null || true
}

# Rotating between runs is not enough on its own: with --developer on, a single
# session eats RAM fast (2026-08-11: stderr.log reached 347 MB in under three
# minutes). So cap stderr.log during the session. Truncate IN PLACE rather than
# rename: it is open in append mode (the `2>>` below), and a rename would take
# the open descriptor with it -- writes would keep landing in the renamed file
# while the fresh one stayed empty forever. Copy the tail out first so the part
# worth reading, whatever happened just before, survives. logrotate calls this
# copytruncate.
#
# mixxx.log is capped by Mixxx itself instead (--log-max-file-size, the same
# size). Mixxx does not open it in append mode, so truncating it from out here
# would leave Mixxx writing on at its old offset, into a file that is mostly a
# hole. At the cap Mixxx stops writing it; stderr.log keeps the tail.
LOG_CAP_BYTES=$((32 * 1024 * 1024))
LOG_KEEP_BYTES=$((8 * 1024 * 1024))

cap_log() {
    while sleep 60; do
        for file in "$@"; do
            size=$(stat -c %s "$file" 2>/dev/null) || continue
            [ "$size" -gt "$LOG_CAP_BYTES" ] || continue
            # Same .1 slot the between-runs rotation uses: the policy is one
            # previous chunk either way, and the recent one is the useful one.
            tail -c "$LOG_KEEP_BYTES" "$file" >"$file.1" 2>/dev/null || continue
            : >"$file"
        done
    done
}

# /tmp starts empty at every boot, and the shell opens the `2>>` redirect below
# BEFORE it starts mixxx -- so without this the redirect fails, mixxx never
# runs, and the loop spins on a black screen forever. (Mixxx creates LOG_DIR
# itself as well, but only once it is running.)
mkdir -p "$LOG_DIR"

cap_log "$LOG_DIR/stderr.log" &
CAP_PID=$!
# The watchdog must not outlive the session -- without this it survives as an
# orphan across every X restart and they accumulate.
trap 'kill "$CAP_PID" 2>/dev/null' EXIT INT TERM

while true; do
    rotate_log "$LOG_DIR/stderr.log"
    # Mixxx rotates its own log as it starts (mixxx.log -> .1 -> ... -> .10).
    # Clearing the older generations first leaves one previous run, as for
    # stderr.log; in RAM, ten of them would cost ten times the memory.
    rm -f "$LOG_DIR"/mixxx.log.*
    mixxx --fullScreen --log-path "$LOG_DIR" --log-max-file-size "$LOG_CAP_BYTES" \
        --log-level debug --log-flush-level info 2>>"$LOG_DIR/stderr.log"
    # How Mixxx ended, which is otherwise unknowable: its own log stops at
    # whatever was last flushed, so a clean quit and a crash during shutdown look
    # identical from the outside. 0 is a normal exit; 143 is SIGTERM taking the
    # default action, i.e. the signal handler did not turn it into a quit; 134 is
    # SIGABRT, which on this build means a failed DEBUG_ASSERT.
    echo "--- mixxx exited $? at $(date '+%H:%M:%S') ---" >>"$LOG_DIR/stderr.log"
    sleep 2
done
