#!/usr/bin/env bash
# dj-usb mount|unmount <kernel-name>   e.g. dj-usb mount sda1
# dj-usb write <slot> <file>...        e.g. dj-usb write /media/DJ_USB_1 /var/lib/rauc/trimixxx-recording/recorded-set-12345678.mp3
#
# Mounts DJ sticks READ-ONLY at /media/DJ_USB_1 / /media/DJ_USB_2. Driven by
# 99-dj-usb.rules -> dj-usb@.service; not meant to be run by hand except to
# debug.
#
# Read-only is the whole safety model: with no writes there are no dirty pages,
# so a stick can be yanked mid-set without corrupting a DJ's library. Mixxx
# tolerates this -- its Rekordbox importer opens export.pdb and the ANLZ files
# with std::ifstream::binary and parks everything it reads in Mixxx's own
# database, never on the device.
#
# The one exception is `write`: a recorded set ("Record set" on the browser's
# home list), its MP3 and its track list, copied onto a stick the DJ chose.
# The stick is read-write for the copy and nothing else, under the same lock
# as mount and unmount, and read-only again however the copy ends. Mixxx runs
# it as root through sudo (/etc/sudoers.d/dj-usb-write); it copies only a
# recording, out of the recording directory, and only onto a slot's root.
#
# The slot path matters and is not cosmetic. Mixxx's RekordboxFeature scans
# /media, /media/$USER and /run/media/$USER, takes their IMMEDIATE children
# only, and tests <child>/PIONEER/rekordbox/export.pdb. So /media/DJ_USB_1 is
# found and /media/usb/DJ_USB_1 would not be.
set -euo pipefail

SLOTS=2
LOCK=/run/dj-usb.lock
# FAT/exFAT/HFS+ carry no ownership, so the kernel synthesises it at mount time
# and needs to be told who the files belong to. uid 1000 is the Pi's first human
# user, i.e. whoever runs Mixxx; override with DJ_USER= if that ever changes.
DJ_USER="${DJ_USER:-$(id -un 1000 2>/dev/null || echo pi)}"

log() { logger -t dj-usb -- "$*" 2>/dev/null || true; echo "dj-usb: $*" >&2; }

# Where Mixxx records a set (pi_config/trimixxx-recording.service): what
# `write` copies may only come from here.
REC_DIR=/var/lib/rauc/trimixxx-recording
# Filesystems Linux writes safely, of those a DJ's stick carries: FAT32 and
# exFAT (what CDJs and rekordbox use) and ext. Not HFS+ (a journaled one is
# read-only to Linux) nor NTFS.
WRITABLE_FS="vfat exfat ext2 ext3 ext4"

# `write`'s exits, which Mixxx tells apart: 2 refused (not a slot, not a
# recording), 3 too little room, 4 a filesystem it does not write, 5 the
# write failed (a stick pulled, a bad stick, one too slow), 6 the name is
# taken.
#
# The longest a write may take: three hours of set (432 MB) at half a
# megabyte a second, which no working stick is slower than. It holds the lock
# all that time, so a stick pulled from the other port is unmounted only once
# it is done: dj-usb@.service's stop timeout is set past this.
COPY_LIMIT_S=900
# How much is written at a time, each on the stick before the next (dsync):
# what a pull or a cut can tear is the block under way, and the FAT and the
# part file's directory entry (in the root, beside PIONEER/) are written once
# a block -- 27 times for three hours -- and not once a megabyte.
COPY_BLOCK=16M
fail() {
    local code=$1
    shift
    log "$*"
    exit "$code"
}

slot_path() { echo "/media/DJ_USB_$1"; }

# Serialise slot choice: two sticks inserted together would otherwise both see
# slot 1 as free and race for it.
take_lock() {
    exec 9>"$LOCK"
    flock 9
}

do_mount() {
    local kname=$1 dev=/dev/$1 fstype opts uid gid mp i

    [[ -b $dev ]] || { log "$dev is not a block device"; exit 1; }

    fstype=$(blkid -o value -s TYPE "$dev" 2>/dev/null || true)
    if [[ -z $fstype ]]; then
        log "$dev carries no recognisable filesystem; ignoring"
        exit 0
    fi

    # noexec/nosuid/nodev: this is foreign media handed over by a stranger.
    opts="ro,noatime,nosuid,nodev,noexec"
    case $fstype in
    vfat | exfat | ntfs | ntfs3 | hfsplus)
        uid=$(id -u "$DJ_USER")
        gid=$(id -g "$DJ_USER")
        opts="$opts,uid=$uid,gid=$gid"
        ;;
    esac
    # FAT stores long names as UTF-16, and the Pi kernel translates them with
    # CONFIG_FAT_DEFAULT_IOCHARSET="ascii" unless told otherwise -- so every
    # name with an accent or a non-Latin letter in it (Zøe, Ø [Phase], ...)
    # came out mangled, and the file behind it could not be opened by its real
    # name: a track rekordbox exported, listed fine from the pdb, that would not
    # load. exFAT, NTFS and HFS+ already default to UTF-8.
    if [[ $fstype == vfat ]]; then
        opts="$opts,utf8"
    fi

    take_lock
    for ((i = 1; i <= SLOTS; i++)); do
        mp=$(slot_path "$i")
        mountpoint -q "$mp" && continue

        mkdir -p "$mp"
        if mount -t "$fstype" -o "$opts" "$dev" "$mp"; then
            # What the stick calls itself, written where Mixxx can read it.
            # The slot is handed out in plug order, so DJ_USB_1 says nothing
            # about which stick this is -- and the browser shows the label.
            # blkid is already loaded and has the answer; the alternative is
            # Mixxx resolving the mount back to a device and hunting through
            # /dev/disk/by-label for it, which it can only do on Linux and only
            # if it can read both.
            #
            # Written even when empty: an empty file means "asked, no label",
            # which is different from no file at all, i.e. "not mounted by us".
            mkdir -p /run/dj-usb
            blkid -o value -s LABEL "$dev" 2>/dev/null >"/run/dj-usb/DJ_USB_$i.label" ||
                : >"/run/dj-usb/DJ_USB_$i.label"
            # And which stick it is. The label cannot say -- two sticks can
            # share one, or have none -- and the slot is reused by the next
            # stick in the same port, so Mixxx keys what it caches from a stick
            # on its filesystem UUID. For FAT that is the volume serial.
            blkid -o value -s UUID "$dev" 2>/dev/null >"/run/dj-usb/DJ_USB_$i.uuid" ||
                : >"/run/dj-usb/DJ_USB_$i.uuid"
            log "mounted $dev ($fstype) read-only at $mp"
            exit 0
        fi
        # Do not leave an empty slot dir behind: RekordboxFeature would stat it
        # on every refresh for no reason.
        rmdir "$mp" 2>/dev/null || true
        log "mount of $dev at $mp failed"
        exit 1
    done

    log "no free slot for $dev: all $SLOTS DJ_USB slots are occupied"
    exit 1
}

do_unmount() {
    local kname=$1 mp i src

    take_lock
    for ((i = 1; i <= SLOTS; i++)); do
        mp=$(slot_path "$i")
        src=$(findmnt -n -o SOURCE --mountpoint "$mp" 2>/dev/null || true)
        [[ $src == "/dev/$kname" ]] || continue

        # Lazy: on a yank the device is already gone, and Mixxx may still hold
        # the pdb or a track open. -l detaches now and lets the kernel clean up
        # when the last handle closes, instead of failing with EBUSY.
        umount -l "$mp" 2>/dev/null || log "umount -l $mp failed"
        rmdir "$mp" 2>/dev/null || true
        rm -f "/run/dj-usb/DJ_USB_$i.label" "/run/dj-usb/DJ_USB_$i.uuid"
        log "unmounted $mp ($kname)"
    done
}

# Read-only again, and said so if it would not go. A stick left read-write is
# the one thing this must not leave behind, so it is tried a few times: a
# remount refuses while a file is still open for writing.
restore_ro() {
    local mp=$1 i
    mountpoint -q "$mp" || return 0 # pulled: nothing is mounted to restore
    sync -f "$mp" 2>/dev/null || true
    for ((i = 0; i < 10; i++)); do
        if mount -o remount,ro "$mp" 2>/dev/null; then
            log "remounted $mp read-only"
            return 0
        fi
        sleep 0.2
    done
    log "could not remount $mp read-only: it is still read-write"
    return 1
}

do_write() {
    local mp=$1 src name fstype need avail part deadline left rc written=()
    shift
    [[ $mp =~ ^/media/DJ_USB_[0-9]+$ ]] && mountpoint -q "$mp" ||
        fail 2 "$mp is not a stick in this deck"
    (($# > 0)) || fail 2 "nothing to write to $mp"
    need=$((1024 * 1024)) # and a megabyte to spare: the FAT and the directory
    for src in "$@"; do
        name=${src##*/}
        [[ $src == "$REC_DIR/$name" && $name =~ ^recorded-set-[a-z0-9-]+\.(mp3|txt)$ &&
            -f $src && ! -L $src ]] || fail 2 "$src is not a recording"
        need=$((need + $(stat -c %s "$src")))
    done

    take_lock
    # The lock waited for any mount or unmount: what was checked is checked
    # again, against the stick that is there now.
    mountpoint -q "$mp" || fail 5 "$mp went before the write"
    fstype=$(findmnt -n -o FSTYPE --mountpoint "$mp")
    [[ " $WRITABLE_FS " == *" $fstype "* ]] || fail 4 "$mp is $fstype, which this deck does not write"
    for src in "$@"; do
        [[ -e $mp/${src##*/} ]] && fail 6 "${src##*/} is on $mp already"
    done
    avail=$(df -B1 --output=avail "$mp" | tail -n 1 | tr -d ' ')
    ((avail >= need)) || fail 3 "$mp is full: the set needs $need bytes, it has $avail"

    # Read-only again however this ends: done, failed, or stopped.
    trap 'restore_ro "$mp"' EXIT
    trap 'exit 5' INT TERM HUP
    mount -o remount,rw "$mp" || fail 5 "$mp would not remount read-write"
    log "remounted $mp read-write for ${#} file(s)"
    deadline=$((SECONDS + COPY_LIMIT_S))
    for src in "$@"; do
        name=${src##*/}
        # Under a name of its own until it is whole, so a stick pulled
        # mid-copy is left with a hidden part and never a short file under
        # the set's name. COPY_BLOCK at a time, synchronously: little ever
        # waits in the page cache (a big copy to a slow stick would otherwise
        # stall every writer on the deck), and the stick's metadata is
        # written once a block. Mixxx reads the progress off the stick's own
        # count of what it has written.
        # Neither end followed if it is a link (nofollow): checked above, but
        # this runs as root, and a link swapped in since, or one an ext stick
        # brought, must not make it read or write anything else.
        part="$mp/.$name.part"
        left=$((deadline - SECONDS))
        rc=0
        ((left > 0)) || rc=124
        ((rc != 0)) || timeout "$left" dd if="$src" of="$part" bs=$COPY_BLOCK \
            iflag=nofollow oflag=dsync,nofollow status=none || rc=$?
        ((rc != 0)) || { sync "$part" && mv "$part" "$mp/$name"; } || rc=$?
        if ((rc != 0)); then
            rm -f "$part" 2>/dev/null || true
            ((rc == 124)) && fail 5 "$mp is too slow: the set was not written in $((COPY_LIMIT_S / 60)) minutes"
            fail 5 "writing $name to $mp failed"
        fi
        written+=("$name")
    done
    sync -f "$mp" || fail 5 "$mp did not take the write"
    log "wrote ${written[*]} to $mp"
    # The EXIT trap remounts it read-only; a stick it could not be done for
    # fails the write, so Mixxx says so.
    trap - EXIT
    restore_ro "$mp" || exit 5
}

case "${1:-}" in
mount) do_mount "${2:?usage: dj-usb mount <kernel-name>}" ;;
unmount) do_unmount "${2:?usage: dj-usb unmount <kernel-name>}" ;;
write) do_write "${2:?usage: dj-usb write <slot> <file>...}" "${@:3}" ;;
*) echo "usage: dj-usb mount|unmount <kernel-name> | write <slot> <file>..." >&2; exit 2 ;;
esac
