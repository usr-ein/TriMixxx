	path = mixxx_config/ttymidi
	url = https://github.com/usr-ein/ttymidi
# Our Mixxx fork: the source the deck actually runs. `main` forks off the
# 2.5.6 tag and carries our patches (downbeat rendering, ...); upstream's own
# main is not merged into it. Doubles as the reference copy, so questions about
# ConfigKeys / skin nodes / engine behaviour get answered from the version we
# actually ship.
#
# Push URL is set per-clone, not here, since it needs the `github.com-usr-ein`
# SSH alias that only exists in ~/.ssh/config on the dev box:
#
#     git -C mixxx remote set-url --push origin \
#         git@github.com-usr-ein:usr-ein/mixxx.git
#
# Upstream stays reachable for rebases onto later releases:
#
#     git -C mixxx remote add upstream https://github.com/mixxxdj/mixxx.git
#
# No `shallow = true`: it does not work for a pin to an old tag. `submodule
# update --init` shallow-clones the DEFAULT branch, then fetches the pinned SHA
# with no depth limit -- which deepens the clone to full history anyway.
# Measured: 565M and 48557 commits, shallow flag or not.
#
# To get a shallow checkout (34M), clone the branch directly instead of going
# through `submodule update`:
#
#     rm -rf mixxx && git clone --depth 1 --branch main \
#         https://github.com/usr-ein/mixxx.git mixxx
#     git submodule absorbgitdirs mixxx
#
# That lands on the same commit, so `git submodule status` stays clean.
[submodule "mixxx"]
	path = mixxx
	url = https://github.com/usr-ein/mixxx.git
	branch = main
# The CDJ-2000NXS emulator (cdj2k-revival/cdj2000-emulator): Pioneer's own
# firmware on emulated MAIN and GUI boards, on the decks' links through
# `pi-qemu cdj` (docs/cdj-emulator.md). Our fork, as with mixxx: its `main`
# is upstream main, our changes (each a commit on upstream main, ready to go
# back upstream), and geepot's open NXS series (#33-#38), which the NXS needs
# to keep Pro DJ Link time. No firmware is ever in it; it ignores *.UPD and
# what is extracted from one.
#
# Push URL and upstream, per clone, as for mixxx:
#
#     git -C cdj2000-emulator remote set-url --push origin \
#         git@github.com-usr-ein:usr-ein/cdj2000-emulator.git
#     git -C cdj2000-emulator remote add upstream \
#         https://github.com/cdj2k-revival/cdj2000-emulator.git
[submodule "cdj2000-emulator"]
	path = cdj2000-emulator
	url = https://github.com/usr-ein/cdj2000-emulator.git
	branch = main
