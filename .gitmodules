# Reference copy of the Mixxx source the deck actually runs (pinned to 2.5.0),
# so questions about ConfigKeys / skin nodes / engine behaviour get answered from
# that version rather than upstream main.
#
# No `shallow = true`: it does not work for a pin to an old tag. `submodule
# update --init` shallow-clones the DEFAULT branch, which lacks 2.5.0's commit,
# then fetches the pinned SHA with no depth limit -- which deepens the clone to
# full history anyway. Measured: 565M and 48557 commits, shallow flag or not.
#
# To get a shallow checkout (34M), clone it directly at the tag instead of
# through `submodule update`:
#
#     rm -rf mixxx && git clone --depth 1 --branch 2.5.0 \
#         https://github.com/mixxxdj/mixxx.git mixxx
#     git submodule absorbgitdirs mixxx
#
# That lands on the same commit, so `git submodule status` stays clean.
[submodule "mixxx"]
	path = mixxx
	url = https://github.com/mixxxdj/mixxx.git
