[Unit]
Description=pi-midi-daemon - privileged system actions for Mixxx, over MIDI SysEx
# Mixxx enumerates MIDI devices once, at startup, and is launched from the tty1
# autologin session -- so the virtual port must exist before getty@tty1 comes up
# or Mixxx will never list "pi-midi-daemon" as a controller.
Before=getty@tty1.service
After=sound.target

[Service]
Type=exec
# Runs as root deliberately: performing privileged system actions IS this
# daemon's job, and doing it directly avoids a sudoers rule. Safety comes from
# the fixed action table in main.go -- a SysEx opcode only *selects* a
# hardcoded argv, nothing from the wire is interpolated and no shell is used.
User=root
ExecStart=/usr/local/bin/pi-midi-daemon

# Do not report the service "started" (which is what releases getty@tty1, hence
# Mixxx) until the ALSA port is actually present -- same gate as the ttymidi
# bridge, and for the same reason. Max ~30s.
ExecStartPost=/bin/sh -c 'for i in $(seq 1 150); do grep -q pi-midi-daemon /proc/asound/seq/clients 2>/dev/null && exit 0; sleep 0.2; done'

Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
