<?xml version="1.0" encoding="utf-8"?>
<!-- TriMixxx S3 single-deck controller mapping for Mixxx.
     Addresses match the firmware's lib/PiLink/MidiMap.hpp EXACTLY. One deck =
     MIDI channel 1 = [Channel1]. Change both together, never let addresses overlap. -->
<MixxxControllerPreset mixxxVersion="2.4+" schemaVersion="1">
  <info>
    <name>TriMixxx S3</name>
    <author>Samuel Prevost</author>
    <description>Custom TriMixxx single-deck controller (ESP32-S3 master). Two OneButton rings (A: tempo range/keylock/loops/back, B: hotcues/slip/key-sync), jog scratch/bend, 14-bit tempo, transport + loop + browse.</description>
  </info>
  <controller id="TriMixxx S3">
    <scriptfiles>
      <!-- Self-contained: no dependency on Mixxx's bundled common-controller-scripts.js
           (a single fixed deck, so the deck number is hardcoded in the script). -->
      <file filename="TriMixxx.scripts.js" functionprefix="TriMixxx"/>
    </scriptfiles>
    <controls>

      <!-- ===================== Transport ===================== -->
      <!-- Play/pause: note 0x3C -> toggle (script) -->
      <control>
        <group>[Channel1]</group>
        <key>TriMixxx.play</key>
        <status>0x90</status>
        <midino>0x3C</midino>
        <options><script-binding/></options>
      </control>
      <!-- Cue: note 0x3D -> cue_default, momentary (press 0x90 + release 0x80) -->
      <control>
        <group>[Channel1]</group>
        <key>cue_default</key>
        <status>0x90</status>
        <midino>0x3D</midino>
        <options><normal/></options>
      </control>
      <control>
        <group>[Channel1]</group>
        <key>cue_default</key>
        <status>0x80</status>
        <midino>0x3D</midino>
        <options><normal/></options>
      </control>

      <!-- ===================== Loop ===================== -->
      <!-- Mixxx's native loop_in/loop_out are held-state controls: press sets the
           point, RELEASE ends "adjust" mode (holding + jog drags the point). The
           firmware sends Note-On on press AND Note-Off on release, so BOTH edges
           must be mapped. With press only, the control sticks at 1 and Mixxx never
           leaves loop-adjust -> the jog drags the loop points around ("banana").
           Cue is mapped the same way (0x90 + 0x80). -->
      <control>
        <group>[Channel1]</group>
        <key>loop_in</key>
        <status>0x90</status>
        <midino>0x3E</midino>
        <options><normal/></options>
      </control>
      <control>
        <group>[Channel1]</group>
        <key>loop_in</key>
        <status>0x80</status>
        <midino>0x3E</midino>
        <options><normal/></options>
      </control>
      <control>
        <group>[Channel1]</group>
        <key>loop_out</key>
        <status>0x90</status>
        <midino>0x3F</midino>
        <options><normal/></options>
      </control>
      <control>
        <group>[Channel1]</group>
        <key>loop_out</key>
        <status>0x80</status>
        <midino>0x3F</midino>
        <options><normal/></options>
      </control>
      <!-- Reloop is a toggle: it acts on the press only, so the release (Note-Off)
           is intentionally left unmapped (mapping it would double-toggle). -->
      <control>
        <group>[Channel1]</group>
        <key>reloop_toggle</key>
        <status>0x90</status>
        <midino>0x40</midino>
        <options><normal/></options>
      </control>

      <!-- ===================== Track select (encoder) ===================== -->
      <!-- Rotate: CC 0x10 (1 = up, 127 = down) -> browse library (script) -->
      <control>
        <group>[Library]</group>
        <key>TriMixxx.browse</key>
        <status>0xB0</status>
        <midino>0x10</midino>
        <options><script-binding/></options>
      </control>
      <!-- Push: note 0x41 -> context dependent, so it needs the script:
           deck view -> open the library; sidebar -> step into the track list;
           track list -> load the selected track. -->
      <control>
        <group>[Channel1]</group>
        <key>TriMixxx.encoderPush</key>
        <status>0x90</status>
        <midino>0x41</midino>
        <options><script-binding/></options>
      </control>

      <!-- ===================== Jog wheel ===================== -->
      <!-- Touch: note 0x42 -> scratch enable/disable, momentary (0x90 + 0x80) -->
      <control>
        <group>[Channel1]</group>
        <key>TriMixxx.jogTouch</key>
        <status>0x90</status>
        <midino>0x42</midino>
        <options><script-binding/></options>
      </control>
      <control>
        <group>[Channel1]</group>
        <key>TriMixxx.jogTouch</key>
        <status>0x80</status>
        <midino>0x42</midino>
        <options><script-binding/></options>
      </control>
      <!-- Rotate: CC 0x11 (relative ticks) -> scratch tick / pitch bend (script) -->
      <control>
        <group>[Channel1]</group>
        <key>TriMixxx.jog</key>
        <status>0xB0</status>
        <midino>0x11</midino>
        <options><script-binding/></options>
      </control>

      <!-- ===================== Tempo fader (14-bit) ===================== -->
      <!-- MSB CC 0x12 + LSB CC 0x32 -> [Channel1] rate (0..16383, 8192 = center) -->
      <!--
           soft-takeover is what makes BEAT SYNC survivable. While this deck
           follows a network master its tempo comes from the wire, and the fader
           under your hand is connected to nothing: the master drags the deck
           from 130 to 140 while the fader still sits at 130. Without this, the
           first touch of the fader afterwards would drop ten BPM.

           With it, the fader does nothing until it comes back to meet the tempo
           actually playing, from below or from above, whichever side it was
           left on, and only then leads. Mixxx applies it after assembling the
           14-bit value, so it works on the full resolution, and its threshold
           is 3/128 of the fader travel: about a third of a BPM at the 6 percent
           range, which is close enough to a crossing to feel like one.

           See docs/tempo-sync.md for what this is half of.
      -->
      <control>
        <group>[Channel1]</group>
        <key>rate</key>
        <status>0xB0</status>
        <midino>0x12</midino>
        <options><fourteen-bit-msb/><soft-takeover/></options>
      </control>
      <control>
        <group>[Channel1]</group>
        <key>rate</key>
        <status>0xB0</status>
        <midino>0x32</midino>
        <options><fourteen-bit-lsb/><soft-takeover/></options>
      </control>

      <!-- The same two CCs again, read a second time and for the screen only.
           Soft-takeover is what makes the fader survivable and it is also what
           makes it invisible: while it holds, the fader moves and nothing on
           screen does, so a DJ approaching the playing tempo is aiming at a
           target with the sights removed. These publish where the fader
           physically is, so the panel can show it beside the tempo it is
           creeping up on.

           Deliberately a SECOND pair of bindings rather than a rewrite of the
           first. The pair above is the one that moves the deck, and it is
           correct; a script binding that had to forward as well as report could
           only make that worse. Mixxx dispatches a MIDI message to every
           mapping that matches it, so these observe without being in the way.

           Plain 7-bit, assembled in the script. Declaring a second 14-bit
           control on the same CCs is what the mapping validator objects to, and
           the assembly is four lines. -->
      <control>
        <group>[Channel1]</group>
        <key>TriMixxx.tempoFaderMsb</key>
        <status>0xB0</status>
        <midino>0x12</midino>
        <options><script-binding/></options>
      </control>
      <control>
        <group>[Channel1]</group>
        <key>TriMixxx.tempoFaderLsb</key>
        <status>0xB0</status>
        <midino>0x32</midino>
        <options><script-binding/></options>
      </control>

      <!-- ===================== Ring A buttons (notes 0x00..0x06) ===================== -->
      <!-- A1 tempo range: cycle +/-6/10/16/Wide (script) -->
      <control>
        <group>[Channel1]</group>
        <key>TriMixxx.tempoRange</key>
        <status>0x90</status>
        <midino>0x00</midino>
        <options><script-binding/></options>
      </control>
      <!-- A2 master tempo = keylock over the deck, SORT over the library.
           Two entries, because the ring sends a real Note Off on release
           (status 0x80) rather than a Note On with velocity 0, and the sort
           needs the release: a short press is only distinguishable from a hold
           once the button comes back up. With the press alone mapped, the
           hold timer fired every time and nothing ever cycled. -->
      <control>
        <group>[Channel1]</group>
        <key>TriMixxx.keylock</key>
        <status>0x90</status>
        <midino>0x01</midino>
        <options><script-binding/></options>
      </control>
      <control>
        <group>[Channel1]</group>
        <key>TriMixxx.keylock</key>
        <status>0x80</status>
        <midino>0x01</midino>
        <options><script-binding/></options>
      </control>
      <!-- A3 8-beat loop / A4 4-beat loop: beatloop toggles (press only) -->
      <control>
        <group>[Channel1]</group>
        <key>beatloop_8_toggle</key>
        <status>0x90</status>
        <midino>0x02</midino>
        <options><normal/></options>
      </control>
      <control>
        <group>[Channel1]</group>
        <key>beatloop_4_toggle</key>
        <status>0x90</status>
        <midino>0x03</midino>
        <options><normal/></options>
      </control>
      <!-- A5 double / A6 halve the active loop -->
      <control>
        <group>[Channel1]</group>
        <key>loop_double</key>
        <status>0x90</status>
        <midino>0x04</midino>
        <options><normal/></options>
      </control>
      <control>
        <group>[Channel1]</group>
        <key>loop_halve</key>
        <status>0x90</status>
        <midino>0x05</midino>
        <options><normal/></options>
      </control>
      <!-- A7 back: library view / focus (script).

           BOTH EDGES, and that is the whole feature. A7 has two meanings:
           short goes up one level, long returns to the deck. A long press is
           knowable only by nothing having happened yet, so the script starts a
           timer on the press and cancels it on the release.

           With only the press mapped the release never arrived, the timer
           always expired, and every BACK closed the browser outright however
           briefly it was tapped. Four levels into a stick, one tap put you back
           at the deck. -->
      <control>
        <group>[Channel1]</group>
        <key>TriMixxx.back</key>
        <status>0x90</status>
        <midino>0x06</midino>
        <options><script-binding/></options>
      </control>
      <control>
        <group>[Channel1]</group>
        <key>TriMixxx.back</key>
        <status>0x80</status>
        <midino>0x06</midino>
        <options><script-binding/></options>
      </control>

      <!-- ===================== Ring B buttons (notes 0x43..0x48) ===================== -->
      <!-- B1..B4 hotcues 1..4 -> TriMixxx.hotcue (both edges: press jump/create +
           colour, release ends the preview). Script-bound so a newly-created cue
           gets a colour from HOTCUE_COLORS; existing ones keep their own. -->
      <control>
        <group>[Channel1]</group>
        <key>TriMixxx.hotcue</key>
        <status>0x90</status>
        <midino>0x43</midino>
        <options><script-binding/></options>
      </control>
      <control>
        <group>[Channel1]</group>
        <key>TriMixxx.hotcue</key>
        <status>0x80</status>
        <midino>0x43</midino>
        <options><script-binding/></options>
      </control>
      <control>
        <group>[Channel1]</group>
        <key>TriMixxx.hotcue</key>
        <status>0x90</status>
        <midino>0x44</midino>
        <options><script-binding/></options>
      </control>
      <control>
        <group>[Channel1]</group>
        <key>TriMixxx.hotcue</key>
        <status>0x80</status>
        <midino>0x44</midino>
        <options><script-binding/></options>
      </control>
      <control>
        <group>[Channel1]</group>
        <key>TriMixxx.hotcue</key>
        <status>0x90</status>
        <midino>0x45</midino>
        <options><script-binding/></options>
      </control>
      <control>
        <group>[Channel1]</group>
        <key>TriMixxx.hotcue</key>
        <status>0x80</status>
        <midino>0x45</midino>
        <options><script-binding/></options>
      </control>
      <control>
        <group>[Channel1]</group>
        <key>TriMixxx.hotcue</key>
        <status>0x90</status>
        <midino>0x46</midino>
        <options><script-binding/></options>
      </control>
      <control>
        <group>[Channel1]</group>
        <key>TriMixxx.hotcue</key>
        <status>0x80</status>
        <midino>0x46</midino>
        <options><script-binding/></options>
      </control>
      <!-- B5 slip: toggle (script) -->
      <control>
        <group>[Channel1]</group>
        <key>TriMixxx.slip</key>
        <status>0x90</status>
        <midino>0x47</midino>
        <options><script-binding/></options>
      </control>
      <!-- B6 (note 0x48): SORT while the library is open, KEY SYNC over the
           deck (script picks by view, as A2 does).
           Was output-only, which is why pressing it did nothing at all: the
           button sends on every press and the mapping simply had nowhere for
           it to go. Both edges, because a short press is only distinguishable
           from a hold once the button comes back up, and this ring sends a
           real Note Off rather than a Note On with velocity zero. -->
      <control>
        <group>[Channel1]</group>
        <key>TriMixxx.sortKey</key>
        <status>0x90</status>
        <midino>0x48</midino>
        <options><script-binding/></options>
      </control>
      <control>
        <group>[Channel1]</group>
        <key>TriMixxx.sortKey</key>
        <status>0x80</status>
        <midino>0x48</midino>
        <options><script-binding/></options>
      </control>

    </controls>
    <outputs>
      <!-- Play LED: note 0x3C <- play_indicator -->
      <output>
        <group>[Channel1]</group>
        <key>play_indicator</key>
        <status>0x90</status>
        <midino>0x3C</midino>
        <on>0x7F</on>
        <off>0x00</off>
        <minimum>0.5</minimum>
      </output>
      <!-- Cue LED: note 0x3D <- cue_indicator -->
      <output>
        <group>[Channel1]</group>
        <key>cue_indicator</key>
        <status>0x90</status>
        <midino>0x3D</midino>
        <on>0x7F</on>
        <off>0x00</off>
        <minimum>0.5</minimum>
      </output>
      <!-- Loop LEDs: notes 0x3E/0x3F <- loop_enabled (both light while a loop is active) -->
      <output>
        <group>[Channel1]</group>
        <key>loop_enabled</key>
        <status>0x90</status>
        <midino>0x3E</midino>
        <on>0x7F</on>
        <off>0x00</off>
        <minimum>0.5</minimum>
      </output>
      <output>
        <group>[Channel1]</group>
        <key>loop_enabled</key>
        <status>0x90</status>
        <midino>0x3F</midino>
        <on>0x7F</on>
        <off>0x00</off>
        <minimum>0.5</minimum>
      </output>
      <!-- Ring A/B button LEDs are driven as COLOURED SysEx from the script
           (see ledConnect / paintAll in TriMixxx.scripts.js), not as Note-On
           outputs, so there are no ring <output> entries here. -->
    </outputs>
  </controller>
</MixxxControllerPreset>
