<!DOCTYPE template>
<Template>
  <!-- Tempo-fader range selector, one pad per range. `rateRange` is a fraction
       (0.16 = +/-16%), so each pad IsEqual-matches its own value: the transform
       lights the pad when that range is live, and its inverse writes the value
       back on press. EmitOnDownPress is required, not cosmetic: a 1-state
       button also emits 0.0 on release, which IsEqual would invert into
       rateRange=0 (clamped to 1%), killing the fader. Press-only drops it. -->
  <PushButton>
    <ObjectName>RangePad</ObjectName>
    <MinimumSize>80,110</MinimumSize>
    <MaximumSize>80,110</MaximumSize>
    <NumberStates>1</NumberStates>
    <State><Number>0</Number><Text><Variable name="label"/></Text></State>
    <Connection>
      <ConfigKey>[Channel1],rateRange</ConfigKey>
      <Transform><IsEqual><Variable name="range"/></IsEqual></Transform>
      <ButtonState>LeftButton</ButtonState>
      <EmitOnDownPress>true</EmitOnDownPress>
    </Connection>
    <Connection>
      <ConfigKey>[Channel1],rateRange</ConfigKey>
      <Transform><IsEqual><Variable name="range"/></IsEqual></Transform>
      <BindProperty>highlight</BindProperty>
    </Connection>
  </PushButton>
</Template>
