<!DOCTYPE template>
<skin>
  <manifest>
    <title>TriMixxx</title>
    <author>Sam</author>
    <version>1.0</version>
    <description>Single-deck CDJ-style skin for 1024x600 touchscreen</description>
    <attributes>
      <attribute config_key="[Master],num_decks">1</attribute>
      <attribute config_key="[Master],num_samplers">0</attribute>
      <attribute config_key="[Master],num_preview_decks">0</attribute>
      <attribute config_key="[EffectRack1],num_effectunits">0</attribute>
      <!-- 2 = RGB waveform -->
      <attribute config_key="[Waveform],WaveformType">2</attribute>
      <!-- Default to deck view, not library -->
      <attribute persist="true" config_key="[Master],show_library">0</attribute>
      <!-- Shutdown menu. Mixxx itself cannot touch the OS, so POWER only sets
           skin-local state: shutdown_confirm raises the overlay, and YES pulses
           shutdown_now, which the PiMidiDaemon mapping turns into a SysEx the
           pi-midi-daemon service acts on. Not persisted, so a boot can never
           come up mid-confirm, let alone mid-shutdown. -->
      <attribute persist="false" config_key="[TriMixxx],shutdown_confirm">0</attribute>
      <attribute persist="false" config_key="[TriMixxx],shutdown_now">0</attribute>
    </attributes>
  </manifest>

  <Style src="skin:/style.qss"/>

  <!-- Stacked so the shutdown confirm can sit ON TOP of the whole UI. Mixxx's
       stacked layout is a QStackedLayout in StackAll mode, so every child shows
       at once (rather than one-at-a-time) and a child's `visible` connection is
       still honoured, which is what makes the overlay possible in pure XML.

       ORDER IS LOAD-BEARING AND BACKWARDS: the FIRST child renders on TOP.
       Mixxx inserts a zero-sized dummy first (so the stacked layout force-shows
       that instead of clobbering a real child's `visible` connection), which
       means QStackedLayout::insertWidget takes its `else` branch for every real
       child and calls widget->lower() on it, so each one lands UNDER the
       previous. With ShutdownOverlay listed last it rendered behind the opaque
       #Root and was invisible even while shown. Stock skins rely on the same
       rule: LateNight's button_1state_optional.xml lists the cover Label first
       and the button it covers second. -->
  <WidgetGroup>
    <ObjectName>RootStack</ObjectName>
    <Layout>stacked</Layout>
    <MinimumSize>1024,600</MinimumSize>
    <MaximumSize>1024,600</MaximumSize>
    <Children>

      <!-- Shutdown confirm. Covers everything, so the deck is unreachable while
           it is up; visible only while shutdown_confirm = 1. Mixxx cannot power
           the Pi off itself: SHUT DOWN pulses shutdown_now, the PiMidiDaemon
           mapping turns that into SysEx F0 7D 01 F7, and the pi-midi-daemon
           service runs systemctl poweroff. -->
      <WidgetGroup>
        <ObjectName>ShutdownOverlay</ObjectName>
        <Layout>vertical</Layout>
        <MinimumSize>1024,600</MinimumSize>
        <MaximumSize>1024,600</MaximumSize>
        <Connection>
          <ConfigKey persist="false">[TriMixxx],shutdown_confirm</ConfigKey>
          <BindProperty>visible</BindProperty>
        </Connection>
        <Children>
          <WidgetGroup><SizePolicy>e,e</SizePolicy><Children/></WidgetGroup>

          <WidgetGroup>
            <ObjectName>ShutdownDialog</ObjectName>
            <Layout>vertical</Layout>
            <MinimumSize>1024,270</MinimumSize>
            <MaximumSize>1024,270</MaximumSize>
            <Children>
              <Label>
                <ObjectName>ShutdownTitle</ObjectName>
                <MinimumSize>1024,80</MinimumSize>
                <MaximumSize>1024,80</MaximumSize>
                <Text>Shut down the deck?</Text>
              </Label>
              <Label>
                <ObjectName>ShutdownHint</ObjectName>
                <MinimumSize>1024,40</MinimumSize>
                <MaximumSize>1024,40</MaximumSize>
                <Text>Wait for the screen to go dark before cutting power.</Text>
              </Label>
              <WidgetGroup>
                <Layout>horizontal</Layout>
                <MinimumSize>1024,140</MinimumSize>
                <MaximumSize>1024,140</MaximumSize>
                <Children>
                  <WidgetGroup><SizePolicy>e,f</SizePolicy><Children/></WidgetGroup>

                  <!-- CANCEL is momentary: the RELEASE writes 0 to
                       shutdown_confirm, which hides this overlay.

                       LeftClickIsPushButton is required, not decoration. A
                       skin-created control is a ControlPushButton in TOGGLE
                       mode, and WPushButton copies that mode off the control,
                       which makes the connection EMIT_ON_PRESS only, so
                       setControlParameterUp() drops the release. The press
                       alone writes 1 to a control already at 1, i.e. nothing
                       happens and the overlay can never be dismissed. Forcing
                       PUSH restores EMIT_ON_PRESS_AND_RELEASE. -->
                  <PushButton>
                    <ObjectName>ShutdownNo</ObjectName>
                    <MinimumSize>220,110</MinimumSize>
                    <MaximumSize>220,110</MaximumSize>
                    <NumberStates>1</NumberStates>
                    <LeftClickIsPushButton>true</LeftClickIsPushButton>
                    <State><Number>0</Number><Text>CANCEL</Text></State>
                    <Connection>
                      <ConfigKey persist="false">[TriMixxx],shutdown_confirm</ConfigKey>
                      <ButtonState>LeftButton</ButtonState>
                    </Connection>
                  </PushButton>

                  <WidgetGroup><MinimumSize>60,10</MinimumSize><MaximumSize>60,10</MaximumSize><Children/></WidgetGroup>

                  <!-- SHUT DOWN pulses shutdown_now (1 on press, 0 on release);
                       the mapping fires on the rising edge. The overlay stays up
                       afterwards on purpose: the deck is on its way down, and
                       if nothing happens CANCEL still gets you out. -->
                  <PushButton>
                    <ObjectName>ShutdownYes</ObjectName>
                    <MinimumSize>220,110</MinimumSize>
                    <MaximumSize>220,110</MaximumSize>
                    <NumberStates>1</NumberStates>
                    <!-- Same reason as CANCEL, plus one of its own: without the
                         release, shutdown_now would latch at 1 forever, so a
                         second press would write 1 to a control already at 1,
                         raise no valueChanged, and never fire again. -->
                    <LeftClickIsPushButton>true</LeftClickIsPushButton>
                    <State><Number>0</Number><Text>SHUT DOWN</Text></State>
                    <Connection>
                      <ConfigKey persist="false">[TriMixxx],shutdown_now</ConfigKey>
                      <ButtonState>LeftButton</ButtonState>
                    </Connection>
                  </PushButton>

                  <WidgetGroup><SizePolicy>e,f</SizePolicy><Children/></WidgetGroup>
                </Children>
              </WidgetGroup>
            </Children>
          </WidgetGroup>

          <WidgetGroup><SizePolicy>e,e</SizePolicy><Children/></WidgetGroup>
        </Children>
      </WidgetGroup>

      <WidgetGroup>
        <ObjectName>Root</ObjectName>
        <Layout>vertical</Layout>
        <MinimumSize>1024,600</MinimumSize>
        <MaximumSize>1024,600</MaximumSize>
        <Children>

          <!-- =========== TOP HEADER (always visible) =========== -->
          <WidgetGroup>
            <ObjectName>TopHeader</ObjectName>
            <Layout>horizontal</Layout>
            <MinimumSize>1024,80</MinimumSize>
            <MaximumSize>1024,80</MaximumSize>
            <Children>

              <!-- Cover art -->
              <CoverArt>
                <Group>[Channel1]</Group>
                <MinimumSize>72,72</MinimumSize>
                <MaximumSize>72,72</MaximumSize>
                <DefaultCover>cover_default.svg</DefaultCover>
              </CoverArt>

              <!-- Title / Artist, beside the cover art.
                   The explicit sizes are what make this render at all: with
                   none the TrackPropertys have no height, and this group is
                   vertically Fixed, so the column collapsed to 0px and was
                   simply never drawn. Stock skins always size these
                   (e.g. <Size>0e,40f</Size>). -->
              <WidgetGroup>
                <ObjectName>TitleArtistColumn</ObjectName>
                <Layout>vertical</Layout>
                <MinimumSize>200,72</MinimumSize>
                <MaximumSize>-1,72</MaximumSize>
                <SizePolicy>me,f</SizePolicy>
                <Children>
                  <TrackProperty>
                    <ObjectName>TitleText</ObjectName>
                    <Group>[Channel1]</Group>
                    <Property>title</Property>
                    <Size>0me,42f</Size>
                    <Elide>right</Elide>
                  </TrackProperty>
                  <TrackProperty>
                    <ObjectName>ArtistText</ObjectName>
                    <Group>[Channel1]</Group>
                    <Property>artist</Property>
                    <Size>0me,28f</Size>
                    <Elide>right</Elide>
                  </TrackProperty>
                </Children>
              </WidgetGroup>

              <!-- BPM / KEY column -->
              <WidgetGroup>
                <ObjectName>BpmKeyColumn</ObjectName>
                <Layout>vertical</Layout>
                <MinimumSize>120,72</MinimumSize>
                <MaximumSize>120,72</MaximumSize>
                <Children>
                  <!-- The tempo used to be here. It is bottom right now, in
                       the seven-segment face, where a CDJ puts it; showing the
                       same number twice on a 1024x600 panel is just clutter. -->
                  <Key>
                    <ObjectName>KeyDisplay</ObjectName>
                    <Group>[Channel1]</Group>
                    <DisplayType>1</DisplayType>
                  </Key>
                </Children>
              </WidgetGroup>

              <!-- Audio underrun counter. [App],audio_latency_overload_count is
                   bumped by SoundManager::processUnderflowHappened() whenever an
                   underflow flag was set, rate-limited to one count per 500ms.
                   This is the SAME number Preferences / Sound Hardware shows as
                   "Buffer Underflow Count", and unlike the developer-flag log
                   lines it costs nothing to read: no qWarning, no lock in the
                   audio callback. If this climbs during a set, enlarge the
                   buffer (soundconfig.xml `latency`, see upload.sh).

                   Caveat: it does NOT isolate the DAC. Every underflowHappened()
                   source feeds this one counter, including the network/broadcast
                   device (codes 24 and 25), which chatters harmlessly on its own.
                   So treat a rising number as "look closer", not "the DAC dropped
                   out"; only the developer flag plus a grep for code 6 proves
                   that. Group is [App] (soundmanager.cpp), NOT [Channel1].

                   Note for editors: no double hyphen anywhere in this comment.
                   XML forbids it inside comments and Qt's parser rejects the
                   whole skin, which boots Mixxx to a default one. -->
              <WidgetGroup>
                <ObjectName>XrunColumn</ObjectName>
                <Layout>vertical</Layout>
                <MinimumSize>84,72</MinimumSize>
                <MaximumSize>84,72</MaximumSize>
                <Children>
                  <WidgetGroup><SizePolicy>f,e</SizePolicy><Children/></WidgetGroup>
                  <Number>
                    <ObjectName>XrunDisplay</ObjectName>
                    <NumberOfDigits>0</NumberOfDigits>
                    <Text>XRUN %1</Text>
                    <Connection>
                      <ConfigKey>[App],audio_latency_overload_count</ConfigKey>
                    </Connection>
                  </Number>
                  <WidgetGroup><SizePolicy>f,e</SizePolicy><Children/></WidgetGroup>
                </Children>
              </WidgetGroup>

              <!-- TIME column -->
              <WidgetGroup>
                <ObjectName>TimeColumn</ObjectName>
                <Layout>vertical</Layout>
                <!-- Wide enough for the combined string: the mode renders
                     elapsed and remaining together in ONE widget. -->
                <MinimumSize>240,72</MinimumSize>
                <MaximumSize>240,72</MaximumSize>
                <Children>
                  <!-- ONE widget, showing elapsed AND remaining together.
                       There is no <ShowRemaining> element: every WNumberPos
                       reads the one global control
                       [Controls],ShowDurationRemaining, so a second widget
                       could only ever repeat the first, which is exactly what
                       it did. mixxx.cfg sets PositionDisplay 2
                       (TrackTime::DisplayMode::ELAPSED_AND_REMAINING), which is
                       what makes this show both. -->
                  <NumberPos>
                    <ObjectName>TimeElapsed</ObjectName>
                    <Group>[Channel1]</Group>
                    <Connection>
                      <ConfigKey>[Channel1],playposition</ConfigKey>
                    </Connection>
                  </NumberPos>
                </Children>
              </WidgetGroup>

              <!-- POWER: raises the shutdown confirm overlay. It lives in the
                   header because nothing sits below the waveform any more, and
                   this is the ONLY way to shut the deck down from the UI (there
                   is no hardware shutdown button). Far right, away from the
                   transport, for the same reason it was far right in the old bar.

                   Deliberately a 2-state toggle, not a 1-state momentary button:
                   a momentary one writes 1 on press and 0 on release, so the
                   overlay would flash up and vanish again. -->
              <WidgetGroup>
                <ObjectName>PowerColumn</ObjectName>
                <Layout>vertical</Layout>
                <MinimumSize>84,72</MinimumSize>
                <MaximumSize>84,72</MaximumSize>
                <Children>
                  <WidgetGroup><SizePolicy>f,e</SizePolicy><Children/></WidgetGroup>
                  <PushButton>
                    <ObjectName>PowerButton</ObjectName>
                    <MinimumSize>78,56</MinimumSize>
                    <MaximumSize>78,56</MaximumSize>
                    <NumberStates>2</NumberStates>
                    <State><Number>0</Number><Unpressed>power.svg</Unpressed><Pressed>power.svg</Pressed></State>
                    <State><Number>1</Number><Unpressed>power.svg</Unpressed><Pressed>power.svg</Pressed></State>
                    <Connection>
                      <ConfigKey persist="false">[TriMixxx],shutdown_confirm</ConfigKey>
                      <ButtonState>LeftButton</ButtonState>
                    </Connection>
                  </PushButton>
                  <WidgetGroup><SizePolicy>f,e</SizePolicy><Children/></WidgetGroup>
                </Children>
              </WidgetGroup>

            </Children>
          </WidgetGroup>

          <!-- =========== MIDDLE: DECK VIEW (shown when library hidden) =========== -->
          <WidgetGroup>
            <ObjectName>DeckView</ObjectName>
            <Layout>vertical</Layout>
            <!-- 600 total - 80 header. There is no bottom bar any more, so the
                 deck owns everything under the header. -->
            <MinimumSize>1024,520</MinimumSize>
            <MaximumSize>1024,520</MaximumSize>
            <Connection>
              <ConfigKey persist="true">[Master],show_library</ConfigKey>
              <Transform><Not/></Transform>
              <BindProperty>visible</BindProperty>
            </Connection>
            <Children>

              <!-- Pro DJ Link phase meter: where the network's tempo master is
                   in its bar, over where this deck is in its own. Sits directly
                   above the waveform because that is where the eye already is
                   while beatmatching.

                   The 58 px it takes come out of the waveform below (465 -> 360),
                   so the total height of the deck view is unchanged. -->
              <WidgetGroup>
                <ObjectName>ProLinkPhaseRow</ObjectName>
                <Layout>horizontal</Layout>
                <MinimumSize>1024,58</MinimumSize>
                <MaximumSize>1024,58</MaximumSize>
                <Children>
                  <!-- Expanding spacers either side keep the meter centred
                       without hard-coding half the screen width twice. -->
                  <WidgetGroup><Size>0me,0me</Size><Children/></WidgetGroup>
                  <ProLinkPhaseMeter>
                    <ObjectName>ProLinkPhase</ObjectName>
                    <Group>[Channel1]</Group>
                    <!-- 40% of the 1024 px panel. Wide enough to read the
                         offset between the two rows, narrow enough that they
                         stay side by side rather than a foot apart. -->
                    <MinimumSize>410,58</MinimumSize>
                    <MaximumSize>410,58</MaximumSize>
                    <MasterColor>#ff6600</MasterColor>
                    <DeckColor>#44ccff</DeckColor>
                    <InSyncColor>#44ff88</InSyncColor>
                  </ProLinkPhaseMeter>
                  <WidgetGroup><Size>0me,0me</Size><Children/></WidgetGroup>
                </Children>
              </WidgetGroup>

              <!-- Scrolling waveform -->
              <Visual>
                <ObjectName>ScrollingWaveform</ObjectName>
                <Group>[Channel1]</Group>
                <!-- 360 + 58 (phase meter) + 76 (bottom row) = 494. Not 520: the
                     window's menu bar takes about 22 px off the top that the old
                     budget never counted, and the last row in the column is the
                     one that gets squeezed for it. The waveform
                     absorbs every row of buttons that used to sit under it,
                     rather than leaving a hole. -->
                <MinimumSize>1024,360</MinimumSize>
                <MaximumSize>1024,360</MaximumSize>
                <SignalHighColor>#ff5544</SignalHighColor>
                <SignalMidColor>#88ff00</SignalMidColor>
                <SignalLowColor>#2266ff</SignalLowColor>
                <PlayPosColor>#ffffff</PlayPosColor>
                <BgColor>#000000</BgColor>
                <AxesColor>#444444</AxesColor>
                <BeatColor>#cccccc</BeatColor>
                <!-- First beat of each bar, Rekordbox-style. Anchored on the
                     intro cue, so a track with no intro cue shows plain beats. -->
                <DownbeatColor>#ff0000</DownbeatColor>
                <EndOfTrackColor>#ff2200</EndOfTrackColor>
                <!-- Hotcues: one auto-mark per set hotcue (colored by the hotcue's
                     own color); %1 = hotcue number. -->
                <DefaultMark>
                  <Align>bottom|right</Align>
                  <Color>#88ff00</Color>
                  <TextColor>#0c0c0c</TextColor>
                  <Text> %1 </Text>
                </DefaultMark>
                <!-- Cue point (red, distinct from the orange loop) -->
                <Mark>
                  <Control>cue_point</Control>
                  <Text>CUE</Text>
                  <Align>top|right</Align>
                  <Color>#ff0033</Color>
                  <TextColor>#ffffff</TextColor>
                </Mark>
                <!-- Active loop: an orange window between loop in/out.
                     Bright while looping (loop_enabled=1); stays as a dimmer amber
                     once you exit the loop (the in/out positions persist), and goes
                     bright again on reloop. Cleared only by loop_remove. -->
                <MarkRange>
                  <StartControl>loop_start_position</StartControl>
                  <EndControl>loop_end_position</EndControl>
                  <EnabledControl>loop_enabled</EnabledControl>
                  <Color>#ff8800</Color>
                  <Opacity>0.75</Opacity>
                  <DisabledColor>#b35f00</DisabledColor>
                  <DisabledOpacity>0.4</DisabledOpacity>
                </MarkRange>
                <Mark>
                  <Control>loop_start_position</Control>
                  <Text>&#8635;</Text>
                  <Align>top|left</Align>
                  <Color>#ff8800</Color>
                  <TextColor>#0c0c0c</TextColor>
                </Mark>
                <Mark>
                  <Control>loop_end_position</Control>
                  <Align>top|right</Align>
                  <Color>#ff8800</Color>
                  <TextColor>#0c0c0c</TextColor>
                </Mark>
              </Visual>

              <!-- Bottom row: the minimap, with the tempo readout to its right.
                   The BPM lives here rather than up in the header because it is
                   the number a DJ glances at constantly, and the bottom right
                   corner is where a CDJ puts it. -->
              <WidgetGroup>
                <ObjectName>OverviewRow</ObjectName>
                <Layout>horizontal</Layout>
                <MinimumSize>1024,76</MinimumSize>
                <MaximumSize>1024,76</MaximumSize>
                <Children>

              <Overview>
                <ObjectName>TrackOverview</ObjectName>
                <Group>[Channel1]</Group>
                <MinimumSize>728,76</MinimumSize>
                <MaximumSize>728,76</MaximumSize>
                <Connection>
                  <ConfigKey>[Channel1],playposition</ConfigKey>
                </Connection>
                <BgColor>#0c0c0c</BgColor>
                <SignalHighColor>#ff5544</SignalHighColor>
                <SignalMidColor>#88ff00</SignalMidColor>
                <SignalLowColor>#2266ff</SignalLowColor>
                <PlayPosColor>#ffffff</PlayPosColor>
                <EndOfTrackColor>#ff2200</EndOfTrackColor>
                <AxesColor>#333333</AxesColor>
                <Type>RGB</Type>
                <!-- Hotcues (auto), cue point, and active loop on the minimap -->
                <DefaultMark>
                  <Align>bottom|right</Align>
                  <Color>#88ff00</Color>
                  <TextColor>#0c0c0c</TextColor>
                  <Text> %1 </Text>
                </DefaultMark>
                <Mark>
                  <Control>cue_point</Control>
                  <Text>C</Text>
                  <Align>top|right</Align>
                  <Color>#ff0033</Color>
                  <TextColor>#ffffff</TextColor>
                </Mark>
                <MarkRange>
                  <StartControl>loop_start_position</StartControl>
                  <EndControl>loop_end_position</EndControl>
                  <EnabledControl>loop_enabled</EnabledControl>
                  <Color>#ff8800</Color>
                  <Opacity>0.75</Opacity>
                  <DisabledColor>#b35f00</DisabledColor>
                  <DisabledOpacity>0.4</DisabledOpacity>
                </MarkRange>
              </Overview>

                  <!-- Rate-adjusted BPM: what is actually playing, not the
                       file's stored tempo. Number, not NumberBpm: the latter
                       is deprecated and parses as a plain Number with no
                       implicit binding, so without the Connection it renders
                       nothing at all. (No double hyphens in an XML comment;
                       they are illegal and reject the whole file.) -->
                  <!-- Pitch column: how far the fader is from the track's own
                       tempo, over the range that fader spans. Both are stock
                       Mixxx widgets ; NumberRate already does (rate_ratio-1)
                       x100 with a sign, and RateRange already formats the
                       range as a percentage, so neither needs a Transform (the
                       skin has Add but no Multiply, which is why doing this by
                       hand would not have worked). -->
                  <WidgetGroup>
                    <ObjectName>PitchColumn</ObjectName>
                    <Layout>vertical</Layout>
                    <MinimumSize>86,76</MinimumSize>
                    <MaximumSize>86,76</MaximumSize>
                    <Children>
                      <NumberRate>
                        <ObjectName>PitchPercent</ObjectName>
                        <Group>[Channel1]</Group>
                        <NumberOfDigits>2</NumberOfDigits>
                        <Size>86,38f</Size>
                      </NumberRate>
                      <!-- The range the pitch fader spans, as "16%".
                           RateRange writes its own text and ignores any Text
                           format, so the per cent sign is a sibling label
                           rather than part of it; Display=range drops the +/-
                           prefix the default adds, which belongs on the pitch
                           value above and not on the range. -->
                      <WidgetGroup>
                        <ObjectName>PitchRangeRow</ObjectName>
                        <Layout>horizontal</Layout>
                        <Size>86,38f</Size>
                        <Children>
                          <WidgetGroup><Size>0me,0me</Size><Children/></WidgetGroup>
                          <RateRange>
                            <ObjectName>PitchRange</ObjectName>
                            <Group>[Channel1]</Group>
                            <Display>range</Display>
                            <Size>34,38f</Size>
                          </RateRange>
                          <Text>
                            <ObjectName>PitchRangeUnit</ObjectName>
                            <Text>%</Text>
                            <Size>14,38f</Size>
                          </Text>
                        </Children>
                      </WidgetGroup>
                    </Children>
                  </WidgetGroup>

                  <Number>
                    <ObjectName>TempoDisplay</ObjectName>
                    <Group>[Channel1]</Group>
                    <NumberOfDigits>2</NumberOfDigits>
                    <Text>%1</Text>
                    <MinimumSize>210,76</MinimumSize>
                    <MaximumSize>210,76</MaximumSize>
                    <Connection>
                      <ConfigKey>[Channel1],bpm</ConfigKey>
                    </Connection>
                  </Number>

                </Children>
              </WidgetGroup>


            </Children>
          </WidgetGroup>

          <!-- =========== MIDDLE: LIBRARY VIEW (shown when toggled) =========== -->
          <WidgetGroup>
            <ObjectName>LibraryView</ObjectName>
            <!-- Vertical, not horizontal: the two panes live in a nested row so
                 that LibraryBottomPad can sit UNDER both of them. -->
            <Layout>vertical</Layout>
            <!-- 600 total - 80 header. Nothing shares the space now. -->
            <MinimumSize>1024,520</MinimumSize>
            <MaximumSize>1024,520</MaximumSize>
            <Connection>
              <ConfigKey persist="true">[Master],show_library</ConfigKey>
              <BindProperty>visible</BindProperty>
            </Connection>
            <Children>
              <WidgetGroup>
                <ObjectName>LibraryPanes</ObjectName>
                <Layout>horizontal</Layout>
                <!-- Width stated explicitly. A horizontally Fixed group with no
                     MinimumSize takes its size HINT instead, which here is only
                     as wide as the two panes ask to be, so the row would sit
                     narrower than the screen. -->
                <MinimumSize>1024,200</MinimumSize>
                <MaximumSize>1024,520</MaximumSize>
                <SizePolicy>f,e</SizePolicy>
                <Children>
                  <!-- Width is CONTENT DRIVEN, not the old flat 240. `p` is
                       Preferred, so the column asks for its sizeHint and the
                       track table (Expanding) takes whatever is left. The hint
                       comes from WLibrarySidebar::sizeHint() in our fork, which
                       reports the widest row on show, indentation included, so
                       expanding Rekordbox widens the column and collapsing it
                       gives the width back.

                       341 = 1024 / 3. Past that the column would be eating the
                       track list to show folder names, so it stops and the
                       sidebar scrolls sideways instead, following the selection
                       (ensureCurrentItemVisible). 200 keeps it from collapsing
                       to a sliver while a feature is still populating. -->
                  <WidgetGroup>
                    <ObjectName>LibrarySidebarCol</ObjectName>
                    <Layout>vertical</Layout>
                    <MinimumSize>200,200</MinimumSize>
                    <MaximumSize>341,520</MaximumSize>
                    <SizePolicy>p,e</SizePolicy>
                    <Children>
                      <!-- `i` is Ignored: the search box's own sizeHint is left
                           out of the column's width, so a wide-ish line edit
                           cannot be what decides how wide the MENU is. It still
                           stretches to fill whatever width the tree settles on,
                           and MinimumSize keeps it usable. -->
                      <SearchBox>
                        <ObjectName>LibrarySearch</ObjectName>
                        <MinimumSize>120,40</MinimumSize>
                        <MaximumSize>-1,40</MaximumSize>
                        <SizePolicy>i,f</SizePolicy>
                      </SearchBox>
                      <LibrarySidebar>
                        <ObjectName>LibrarySidebar</ObjectName>
                        <SizePolicy>p,e</SizePolicy>
                      </LibrarySidebar>
                    </Children>
                  </WidgetGroup>
                  <Library>
                    <ObjectName>LibraryTable</ObjectName>
                    <SizePolicy>e,e</SizePolicy>
                  </Library>
                </Children>
              </WidgetGroup>

              <!-- Dead strip along the bottom edge. The last row of the panel is
                   physically hard to hit (the bezel gets your fingertip before
                   the glass does), so the last menu entry and the last track row
                   were effectively untappable. This pushes both up out of that
                   band. Empty on purpose: it exists to be unreachable.

                   Note for editors: no double hyphen anywhere in this comment.
                   XML forbids it inside comments and Qt's parser rejects the
                   whole skin, which boots Mixxx to a default one. -->
              <WidgetGroup>
                <ObjectName>LibraryBottomPad</ObjectName>
                <MinimumSize>1024,56</MinimumSize>
                <MaximumSize>1024,56</MaximumSize>
                <SizePolicy>f,f</SizePolicy>
                <Children/>
              </WidgetGroup>
            </Children>
          </WidgetGroup>

          <!-- No bottom button bar. Everything that used to live under the
               waveform (LIBRARY/DECK, the tempo-range pads, LOOP div-2 / x-2)
               is on the hardware, and POWER moved into the header. -->

        </Children>
      </WidgetGroup>
    </Children>
  </WidgetGroup>
</skin>
