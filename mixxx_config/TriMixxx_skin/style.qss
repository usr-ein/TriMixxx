/* ============== BASE ==============
 *
 * MesloLGL Nerd Font everywhere, shipped with this repo and installed by
 * upload.sh -- it is NOT a stock Raspberry Pi OS font, so the DejaVu fallbacks
 * below are load-bearing: if the font ever fails to reach the deck the UI comes
 * back plain instead of coming back wrong.
 *
 * Two things to know about it.
 *
 * It is MONOSPACE, and the family name does not warn you. Nerd Fonts ship three
 * spacings of every family (plain, "Mono", "Propo") and it is tempting to read
 * the plain one as proportional, but that suffix only describes how the ADDED
 * ICON glyphs are spaced; the underlying Meslo is a terminal font and every
 * variant is fixed-width. Measured from the hmtx tables, all six MesloLGL faces
 * render the same string to exactly the same width, with one distinct advance
 * across every character. So track titles take about 40% more width here than a
 * proportional face would, and a long one elides sooner. Switching between the
 * Nerd Font spellings will not change that; only a different family will.
 *
 * It covers Latin, Greek, Cyrillic, punctuation and symbols, but NOT CJK,
 * Hangul, Hebrew, Arabic, the Indic scripts or emoji. Those come from the Noto
 * families, per character, and the ORDER they are tried in is set by
 * ../pi_config/60-trimixxx-fonts.conf, which also installs them. That file is
 * the one that matters: the track table's font comes from mixxx.cfg, not from
 * here, so it never sees this stack. The families listed after Meslo below are
 * the same chain repeated for the widgets the stylesheet does reach. */
WWidget, QWidget {
    background-color: #1a1a1a;
    color: #e0e0e0;
    font-family: "MesloLGL Nerd Font", "Noto Sans", "Noto Color Emoji", "DejaVu Sans", sans-serif;
    font-size: 14px;
}

#Root { background-color: #0c0c0c; }

/* ============== TOP HEADER ============== */
#TopHeader {
    background-color: #1a1a1a;
    border-bottom: 1px solid #88ff00;
    padding: 4px;
}

#TitleText {
    color: #ffffff;
    font-size: 22px;
    font-weight: bold;
    qproperty-alignment: 'AlignLeft | AlignVCenter';
    padding-left: 8px;
}

#ArtistText {
    color: #909090;
    font-size: 16px;
    qproperty-alignment: 'AlignLeft | AlignVCenter';
    padding-left: 8px;
}

#BpmDisplay {
    color: #88ff00;
    font-family: "MesloLGL Nerd Font", "Noto Sans", "DejaVu Sans Mono", monospace;
    font-size: 28px;
    font-weight: bold;
    qproperty-alignment: 'AlignRight | AlignVCenter';
    padding-right: 8px;
}

#KeyDisplay {
    color: #cccccc;
    font-family: "MesloLGL Nerd Font", "Noto Sans", "DejaVu Sans Mono", monospace;
    font-size: 18px;
    qproperty-alignment: 'AlignRight | AlignVCenter';
    padding-right: 8px;
}

/* Underrun counter. Deliberately dim: it reads 0 the entire time the deck is
   healthy, so it must not compete with the track info beside it. There is no
   "turns red when > 0" rule -- qss cannot branch on a numeric value, and the
   only bindable alternative ([App],audio_latency_overload, the instantaneous
   0/1 flag) self-clears, so it would blink rather than latch. The count is the
   thing worth reading anyway: it only ever goes up. */
#XrunDisplay {
    color: #4a4a4a;
    font-family: "MesloLGL Nerd Font", "Noto Sans", "DejaVu Sans Mono", monospace;
    font-size: 13px;
    font-weight: bold;
    qproperty-alignment: 'AlignCenter';
}

#TimeElapsed {
    color: #ffffff;
    font-family: "MesloLGL Nerd Font", "Noto Sans", "DejaVu Sans Mono", monospace;
    font-size: 22px;
    qproperty-alignment: 'AlignRight | AlignVCenter';
    padding-right: 12px;
}

#TimeRemaining {
    color: #88ff00;
    font-family: "MesloLGL Nerd Font", "Noto Sans", "DejaVu Sans Mono", monospace;
    font-size: 22px;
    qproperty-alignment: 'AlignRight | AlignVCenter';
    padding-right: 12px;
}

/* ============== BUTTONS ==============
   There are none under the waveform any more. Transport, hotcues, loop sizing
   and the tempo-fader range are all hardware, and LIBRARY/DECK is the browse
   encoder's push, so every button those rules styled has been deleted from
   skin.xml. POWER, in the header, is the only on-screen button left. */

/* ============== SHUTDOWN MENU ============== */
/* POWER must not read as a normal deck control, so it is red rather than the
   skin's lime. It only ever opens the confirm. */
#PowerButton {
    background-color: #2a2a2a;
    border: 1px solid #7a2a2a;
    border-radius: 6px;
    color: #ff6666;
    font-size: 14px;
    font-weight: bold;
    margin: 3px;
}
#PowerButton:pressed,
#PowerButton[displayValue="1"] {
    background-color: #ff3333;
    border: 1px solid #ff3333;
    color: #0c0c0c;
}

/* The overlay is a *sibling* of Root in a StackAll layout, so it has to paint
   its own backdrop to actually cover the deck. The slight alpha leaves a hint
   of the UI behind it, which reads as "modal" rather than "another screen". */
#ShutdownOverlay {
    background-color: rgba(8, 8, 8, 242);
}

#ShutdownDialog {
    background-color: #161616;
    border-top: 2px solid #ff3333;
    border-bottom: 2px solid #ff3333;
}

#ShutdownTitle {
    color: #ffffff;
    font-size: 34px;
    font-weight: bold;
    qproperty-alignment: 'AlignCenter';
}

#ShutdownHint {
    color: #909090;
    font-size: 15px;
    qproperty-alignment: 'AlignCenter';
}

#ShutdownNo, #ShutdownYes {
    border-radius: 6px;
    font-size: 20px;
    font-weight: bold;
    margin: 3px;
}
#ShutdownNo {
    background-color: #2a2a2a;
    border: 1px solid #3a3a3a;
    color: #e0e0e0;
}
#ShutdownNo:pressed {
    background-color: #88ff00;
    color: #0c0c0c;
}
#ShutdownYes {
    background-color: #2a2a2a;
    border: 2px solid #ff3333;
    color: #ff6666;
}
#ShutdownYes:pressed {
    background-color: #ff3333;
    color: #0c0c0c;
}

/* ============== LIBRARY ==============
   Selectors here are WIDGET CLASS NAMES, not <ObjectName>s, which is how every
   stock skin styles the library. The previous rules targeted #LibraryTable /
   #LibrarySidebar / #LibraryTable QTableView and never took effect, so the
   library kept Qt's default LIGHT palette while inheriting this skin's white
   text: white on white, and untouched white alternating rows. */

#LibraryView { background-color: #000000; }
#LibraryPanes { background-color: #000000; }

/* The unreachable strip along the bottom edge. Same black as the panes above
   it, so it reads as "the list ends here", not as a bar you failed to hit. */
#LibraryBottomPad { background-color: #000000; }

/* Rows: black / dark-grey alternating, text always white. Selection deliberately
   flips to dark-on-lime -- white text on lime would be the same unreadable
   mistake in a different colour. */
WTrackTableView,
WLibrarySidebar,
WLibraryTextBrowser {
    background-color: #000000;
    alternate-background-color: #1e1e1e;
    color: #ffffff;
    border: none;
    gridline-color: #2a2a2a;
    selection-color: #0c0c0c;
    selection-background-color: #88ff00;
}

/* The track table's font and row height are NOT set here: Library reads
   [Library] Font and [Library] RowHeight from mixxx.cfg and applies them to the
   table directly, so setting them in QSS would just fight that. See mixxx.cfg.
   The sidebar is not covered by those, so it is styled here. */
WLibrarySidebar {
    /* Smaller than the track list on purpose: this is a short nav menu, not the
       thing you read at arm's length. The track table is the 18pt one. */
    font-size: 12pt;
    /* Keep the section arrows off the screen edge so a thumb can reach them. */
    padding-left: 14px;
    /* The real fix for "the triangles are too small to tap": a QTreeView's
       branch rect is `indentation` wide and the WHOLE rect toggles the node --
       the arrow itself never has to be hit. This makes the target finger-sized
       regardless of how the arrow is drawn. */
    qproperty-indentation: 48;
}

WLibrarySidebar::item {
    padding-top: 12px;
    padding-bottom: 12px;
}

WLibrarySidebar::item:selected {
    background-color: #88ff00;
    color: #0c0c0c;
}

/* Big arrows. url(skin:/...) resolves through the "skin" QDir search path Mixxx
   registers for the loaded skin (stock skins reference their graphics the same
   way).

   The :selected rules are not cosmetic. The selection background is lime and so
   was the arrow, so selecting a section made its arrow disappear into the
   highlight. An SVG cannot be recoloured from QSS, so the selected state gets
   its own dark-on-lime copy. */
WLibrarySidebar::branch:has-children:!has-siblings:closed,
WLibrarySidebar::branch:closed:has-children:has-siblings {
    image: url(skin:/branch_closed.svg);
}
WLibrarySidebar::branch:open:has-children:!has-siblings,
WLibrarySidebar::branch:open:has-children:has-siblings {
    image: url(skin:/branch_open.svg);
}
WLibrarySidebar::branch:has-children:!has-siblings:closed:selected,
WLibrarySidebar::branch:closed:has-children:has-siblings:selected {
    image: url(skin:/branch_closed_selected.svg);
    background-color: #88ff00;
}
WLibrarySidebar::branch:open:has-children:!has-siblings:selected,
WLibrarySidebar::branch:open:has-children:has-siblings:selected {
    image: url(skin:/branch_open_selected.svg);
    background-color: #88ff00;
}

WTrackTableViewHeader::section {
    background-color: #1a1a1a;
    color: #88ff00;
    border: none;
    padding: 8px;
    font-size: 13pt;
    font-weight: bold;
}

WSearchLineEdit {
    background-color: #1a1a1a;
    border: 1px solid #3a3a3a;
    color: #ffffff;
    padding: 8px;
    font-size: 16pt;
}

/* ---- Scrollbars ----
   Scoped through the CONTAINER's ObjectName rather than `WLibrarySidebar
   QScrollBar`, which is the pattern every stock skin uses (Tango: "#LibraryContainer
   QScrollBar") and, unlike the class-descendant form, actually takes effect here.

   Kinetic drag-to-scroll is not reachable from a skin (it needs
   QScroller::grabGesture in C++), so a grabbable bar is the honest substitute.
   Arrow buttons are removed throughout: hopeless finger targets that only steal
   length from the handle. */

/* Left panel: no bars at all, in either direction.
 *
 * Zero-sized rather than turned off with a scrollbar POLICY, which is the same
 * trick the track table uses below. Qt derives a scroll RANGE from the content,
 * not from whether the bar is drawn, so a 0px bar still scrolls perfectly well
 * under program control -- and it has to, because the sidebar scrolls sideways
 * by itself to keep the selected row on screen
 * (WLibrarySidebar::ensureCurrentItemVisible). ScrollBarAlwaysOff would have
 * taken that away along with the pixels.
 *
 * Vertically there is nothing left to drag, so the encoder is the only way to
 * move the list. That is the trade for the 44px the old fat bar cost: the menu
 * is a nav list you step through, not a document you pan, and the selection
 * scrolls the view along with it.
 *
 * Both selectors go through the container ObjectName, per the note above: the
 * `WLibrarySidebar QScrollBar` class-descendant form does not take effect here. */
#LibrarySidebarCol QScrollBar:vertical,
#LibrarySidebarCol QScrollBar:horizontal {
    width: 0;
    height: 0;
    background: transparent;
}

/* Right panel: the track encoder scrolls this, so the vertical bar is dead
   weight -- take the width back and give it to the tracks. */
#LibraryTable QScrollBar:vertical,
WTrackTableView QScrollBar:vertical {
    width: 0;
    height: 0;
    background: transparent;
}

/* Horizontal stays (columns run wider than the screen) but slim. */
#LibraryTable QScrollBar:horizontal,
WTrackTableView QScrollBar:horizontal {
    background-color: #0c0c0c;
    height: 12px;
    margin: 0;
}
#LibraryTable QScrollBar::handle:horizontal,
WTrackTableView QScrollBar::handle:horizontal {
    background-color: #3a3a3a;
    border-radius: 5px;
    min-width: 60px;
}
#LibraryTable QScrollBar::add-line:horizontal,
#LibraryTable QScrollBar::sub-line:horizontal,
WTrackTableView QScrollBar::add-line:horizontal,
WTrackTableView QScrollBar::sub-line:horizontal {
    height: 0;
    width: 0;
}
#LibraryTable QScrollBar::add-page:horizontal,
#LibraryTable QScrollBar::sub-page:horizontal,
WTrackTableView QScrollBar::add-page:horizontal,
WTrackTableView QScrollBar::sub-page:horizontal {
    background-color: #0c0c0c;
}
