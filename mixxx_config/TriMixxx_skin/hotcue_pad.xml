<!DOCTYPE template>
<Template>
  <PushButton>
    <ObjectName>HotcuePad</ObjectName>
    <MinimumSize>240,65</MinimumSize>
    <MaximumSize>250,65</MaximumSize>
    <NumberStates>2</NumberStates>
    <State><Number>0</Number><Text><Variable name="hotcuenum"/></Text></State>
    <State><Number>1</Number><Text><Variable name="hotcuenum"/></Text></State>
    <Connection>
      <ConfigKey>[Channel1],hotcue_<Variable name="hotcuenum"/>_activate</ConfigKey>
      <ButtonState>LeftButton</ButtonState>
      <EmitOnPressAndRelease>true</EmitOnPressAndRelease>
    </Connection>
    <Connection>
      <ConfigKey>[Channel1],hotcue_<Variable name="hotcuenum"/>_enabled</ConfigKey>
      <BindProperty>highlight</BindProperty>
    </Connection>
  </PushButton>
</Template>
