# The crew's resource limits, read by `crew resources` (and so by the nightman
# before each dispatch and on each heartbeat). Edit freely; KEY=VALUE, numbers only.
#
# Measured on MBP-NJ (M2 Pro, 12 cores, 16 GB RAM, 460 GB disk), 2026-10-08:
# an emulated deck takes ~2 GB of RAM and 6-7 GB of disk, a worktree's Mixxx
# build tree ~4 GB, Docker's VM up to 8 GB of RAM while it builds, and each
# Claude session ~0.4 GB. RAM is what runs out first.

# Minions alive at once (each: a Claude session, its deck, its builds).
MAX_MINIONS=2
# Emulated decks running on the Mac, everyone's (Sam's and other agents' too).
MAX_DECKS=3
# Decks one minion may run at once (its pitch can allow 2, e.g. ProLink).
DECKS_PER_MINION=1

# Emulated CDJs (`pi-qemu cdj`) running on the Mac, everyone's. Measured 2026-10-10 on main's emulator (e6a4b82):
# one takes 1.9 cores from boot on, idle or not (1.1 with --dsp-model), ~0.15 GB of RAM, and its logs grow ~0.5 GB an
# hour. CPU is what it costs: four, two minions' pairs, take 7.6 cores (4.4 with --dsp-model). Past that, with decks
# and a build, every core is busy, and a CDJ's timing slips.
MAX_CDJS=4
# CDJs one minion may run at once: a pair on one link, BRANCH-a and BRANCH-b (ProLink between two CDJs is what they
# are for). A minion is dispatched only while its pair fits.
CDJS_PER_MINION=2

# Dispatch only while the 5-minute load average is below LOAD_MAX x cores.
LOAD_MAX=0.75
# Shed load when the 15-minute load average stays above LOAD_SHED x cores.
LOAD_SHED=1.5

# Free disk (GB) needed to dispatch a minion or start a deck.
DISK_MIN_GB=40
# Below this, shed: stop decks, no builds, no new worktrees.
DISK_SHED_GB=20

# Free disk (GB) in Docker's VM, where Mixxx builds and their cache live (the Mac's own free disk says nothing of
# it: builds ran out of space twice on 2026-10-09 with 100 GB free on the Mac). Below it, no new minion or build.
DOCKER_MIN_GB=8
# Below this, shed. Freeing it (a prune) is Sam's call.
DOCKER_SHED_GB=4

# Review rounds before a PR waits for Sam.
MAX_REVIEW_ROUNDS=3

# Drift check: every N tool calls or M minutes of a minion's work, whichever first.
DRIFT_EVERY_CALLS=40
DRIFT_EVERY_MIN=25
