def notes_status(wt: Path) -> str:
    try:
        for line in (wt / ".crew" / "notes.md").read_text().splitlines():
            if line.startswith("Status:"):
                return line[len("Status:"):].strip()
    except OSError:
        pass
    return ""


def cmd_status(a) -> int:
    lim, snap = limits(), snapshot()
    by_name = {s.get("name"): s for s in claude_sessions()}
    open_prs = {p["headRefName"]: p for p in gh_json(
        ["pr", "list", "--repo", "usr-ein/TriMixxx", "--state", "open", "--json", PR_FIELDS]) or []}
    rows = []
    for wt in sorted((MAIN / ".claude" / "worktrees").glob("*/")):
        b = wt.name
        if not (wt / ".crew").is_dir():
            continue

        def sess(name):
            s = by_name.get(name)
            return f"{s.get('status')}" if s else "-"
        pr = open_prs.get(b)
        state = next((lb["name"].split(":", 1)[1] for lb in pr["labels"] if lb["name"].startswith("review:")), "open") if pr else "-"
        dks = [f"{d}({s[:3]})" for d, s in snap["decks"] if d in deck_names(b)]
        rows.append([b, sess(b), sess(f"{b}-bitch"), f"#{pr['number']}" if pr else "-", state,
                     " ".join(dks) or "-", notes_status(wt)[:60]])
    if rows:
        head = ["branch", "minion", "bitch", "PR", "review", "decks", "status"]
        widths = [max(len(str(r[i])) for r in rows + [head]) for i in range(len(head))]
        for r in [head] + rows:
            print("  ".join(str(c).ljust(w) for c, w in zip(r, widths)).rstrip())
    else:
        print("no crew worktrees")
    held = locks()
    print("\nreal decks: " + ("".join(f"\n  {lock_line(u, lk)}" for u, lk in held.items()) or "none locked"))
    night = by_name.get("nightman")
    print(f"\nnightman: {night.get('status') if night else 'not running'}")
    v, why = verdict(snap, lim, "minion")
    print(f"resources: {v}" + (f" ({'; '.join(why)})" if why else "") + f"\n  {describe(snap, lim)}")
    return 0


