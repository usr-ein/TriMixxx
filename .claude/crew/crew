class Fail(Exception):
    def __init__(self, msg: str, code: int = 1):
        super().__init__(msg)
        self.code = code


def die(msg: str, code: int = 1):
    raise Fail(msg, code)


def run(cmd, cwd=None, check=True, env=None, input=None, timeout=None) -> subprocess.CompletedProcess:
    try:
        r = subprocess.run([str(c) for c in cmd], cwd=cwd, env=env, input=input, text=True,
                           capture_output=True, timeout=timeout)
    except FileNotFoundError:
        die(f"{cmd[0]}: not found")
    except subprocess.TimeoutExpired:
        die(f"timed out after {timeout} s: {shlex.join(map(str, cmd))}")
    if check and r.returncode != 0:
        die(f"{shlex.join(map(str, cmd))} failed ({r.returncode}): {(r.stderr or r.stdout).strip()}")
    return r


def out(cmd, cwd=None, check=True, env=None, timeout=None) -> str:
    return run(cmd, cwd=cwd, check=check, env=env, timeout=timeout).stdout.strip()


def git(d, *args, check=True) -> str:
    return out(["git", "-C", d, *args], check=check)


def git_ok(d, *args) -> bool:
    return run(["git", "-C", d, *args], check=False).returncode == 0


def now_iso() -> str:
    return dt.datetime.now().astimezone().isoformat(timespec="seconds")


def limits() -> dict:
    vals = {}
    for line in (HERE / "limits.env").read_text().splitlines():
        line = line.split("#", 1)[0].strip()
        if "=" in line:
            k, v = line.split("=", 1)
            vals[k.strip()] = float(v)
    return vals


def worktree_of(branch: str) -> Path:
    return MAIN / ".claude" / "worktrees" / branch


def check_branch(name: str):
    if not re.fullmatch(r"[a-z0-9][a-z0-9._-]{1,48}", name) or name in ("main", "master") or \
            name.endswith(("-bitch", "-b")):
        die(f"{name!r}: a crew branch is lowercase kebab-case, 2-49 characters, not main, and not ending in "
            "-bitch or -b (its session and second deck are named so)")


def superproject_top(d: Path) -> Path:
    """The top of the checkout d is in, past any submodule (worktree/mixxx -> worktree)."""
    top = git(d, "rev-parse", "--show-toplevel")
    while True:
        sup = git(top, "rev-parse", "--show-superproject-working-tree", check=False)
        if not sup:
            return Path(top)
        top = sup


# --- sessions ---------------------------------------------------------------

def session_name(reg: dict) -> str:
    return {"minion": reg.get("branch"), "bitch": f"{reg.get('branch')}-bitch"}.get(reg["role"], "nightman")


def registration(sid) -> dict | None:
    if not sid:
        return None
    try:
        reg = json.loads((CREW / "sessions" / f"{sid}.json").read_text())
    except (OSError, ValueError):
        return None
    if not isinstance(reg, dict) or reg.get("role") not in ROLES:
        return None
    reg["sid"] = sid
    return reg


def registrations() -> list[dict]:
    regs = []
    for p in sorted((CREW / "sessions").glob("*.json")):
        reg = registration(p.stem)
        if reg:
            regs.append(reg)
    return regs


def claude_sessions() -> list[dict]:
    r = run(["claude", "agents", "--json"], check=False, timeout=30)
    try:
        return json.loads(r.stdout) if r.returncode == 0 else []
    except ValueError:
        return []


# What `claude agents` says of a session that isn't running: one stopped after its idle hour stays listed, status None.
ENDED = (None, "", "exited", "stopped", "completed", "failed", "dead")


def live_session(name: str, sessions=None) -> dict | None:
    """The running session of that name: busy, idle, waiting, or any status not known to mean it has ended."""
    for s in sessions if sessions is not None else claude_sessions():
        if s.get("name") == name and s.get("status") not in ENDED:
            return s
    return None


def launch(name: str, wt: Path, bg: bool, prompt: str, crew_env: dict, resume_sid=None, model=None) -> int:
    """A session in the foreground registers itself at its start from crew_env (CREW_ROLE, CREW_MODE, CREW_BRANCH,
    CREW_WORKTREE), before its first tool call. One in the background is registered here once `claude agents` shows
    it: Claude's daemon spawns every background session with its own environment, the one of whichever launch
    started the daemon, so crew_env stays out of it (or every session after this one would carry its role)."""
    live = live_session(name)
    if live:  # resumed, a running session comes back as a copy: two sessions on one conversation
        print(f"{name} is already running ({live.get('kind')}, {live.get('status')}): send it a message, "
              f"or open it with `claude attach {live.get('id') or live.get('sessionId')}`")
        return 0
    cmd = ["claude"] + (["--bg"] if bg else []) + ["-n", name, "--effort", "max"]
    if model:
        cmd += ["--model", model]
    if resume_sid:
        cmd += ["--resume", resume_sid]
    cmd.append(prompt)
    # A session launched from another (the nightman's shell) must not inherit its identity, nor its crew role.
    env = {k: v for k, v in os.environ.items()
           if not (k.startswith(("CLAUDE_CODE_", "CLAUDE_PID", "CLAUDECODE")) and k != "CLAUDE_CODE_EFFORT_LEVEL")
           and k not in CREW_ENV}
    if not bg:
        os.chdir(wt)
        os.execvpe("claude", cmd, dict(env, **crew_env))
    r = run(cmd, cwd=wt, timeout=120, env=env)
    m = re.search(r"backgrounded\W+(\w+)", r.stdout)
    short = m.group(1) if m else None
    if short and crew_env.get("CREW_ROLE"):
        # Its environment is the daemon's, and a resumed session comes back as a copy with a new id: register it here.
        for _ in range(20):
            s = next((s for s in claude_sessions() if s.get("id") == short), None)
            if s and s.get("sessionId"):
                register_session(s["sessionId"], crew_env["CREW_ROLE"], crew_env["CREW_MODE"],
                                 crew_env["CREW_BRANCH"] or None, Path(crew_env["CREW_WORKTREE"]))
                break
            time.sleep(0.5)
    print(f"{name}: running in the background as {short or '?'} in {wt}; "
          f"`claude attach {name}` opens it, `claude agents` lists it")
    return 0


# --- GitHub -----------------------------------------------------------------

_token = None


def gh_env(repo=None) -> dict:
    """gh as usr-ein, never as whichever account `gh auth switch` last left active."""
    global _token
    if _token is None:
        r = run(["gh", "auth", "token", "--user", GH_USER], check=False)
        if r.returncode or not r.stdout.strip():
            die(f"gh has no token for {GH_USER}: `gh auth login`, and pick {GH_USER}")
        _token = r.stdout.strip()
    env = dict(os.environ, GH_TOKEN=_token, GH_PROMPT_DISABLED="1")
    env.pop("GITHUB_TOKEN", None)
    if repo:
        env["GH_REPO"] = repo
    return env


def gh(args, repo=None, check=True, input=None) -> subprocess.CompletedProcess:
    return run(["gh", *args], env=gh_env(repo), check=check, input=input, timeout=120)


def gh_json(args, repo=None):
    r = gh(args, repo=repo)
    return json.loads(r.stdout) if r.stdout.strip() else None


def repo_of(d) -> str | None:
    url = git(d, "remote", "get-url", "origin", check=False)
    m = re.search(r"github\.com[^:/]*[:/]([^/]+)/([^/]+?)(?:\.git)?/?$", url or "")
    return f"{m.group(1)}/{m.group(2)}" if m else None


PR_FIELDS = "number,state,isDraft,labels,url,title,headRefName,headRefOid,baseRefName,body"


def find_prs(branch: str) -> dict:
    """The branch's PRs, by repo path; the TriMixxx one (".") is the primary."""
    prs = {}
    for path, repo in REPOS:
        found = gh_json(["pr", "list", "--repo", repo, "--head", branch, "--state", "all", "--json", PR_FIELDS])
        if found:
            pr = sorted(found, key=lambda p: (p["state"] != "OPEN", -p["number"]))[0]
            pr["repo"] = repo
            pr["labels"] = [lb["name"] for lb in pr["labels"]]
            prs[path] = pr
    return prs


def primary_pr(branch: str, prs=None) -> dict:
    pr = (prs if prs is not None else find_prs(branch)).get(".")
    if not pr:
        die(f"{branch} has no PR on usr-ein/TriMixxx", 2)
    return pr


def ai_reviews(pr: dict) -> list[dict]:
    """The bitch's reviews of a PR, oldest first."""
    pages = gh_json(["api", f"repos/{pr['repo']}/pulls/{pr['number']}/reviews", "--paginate", "--slurp"]) or []
    return [rv for page in pages for rv in page if (rv.get("body") or "").startswith(REVIEW_MARK)]


def review_rounds(pr: dict) -> int:
    return len(ai_reviews(pr))


def approved_commit(pr: dict) -> str | None:
    """The commit the last AI review approved, when the last AI review is an approval."""
    reviews = ai_reviews(pr)
    last = reviews[-1] if reviews else {}
    return last.get("commit_id") if "verdict: approved" in (last.get("body") or "").split("\n", 1)[0] else None


FOR_SAM = re.compile(r"^\s*[-*]\s*\[for Sam\]", re.M)


def set_state(branch: str, state: str, prs=None):
    pr = primary_pr(branch, prs)
    have = {lb["name"] for lb in gh_json(["label", "list", "--repo", pr["repo"], "--limit", "200", "--json", "name"])}
    for s in STATES:
        if f"review:{s}" not in have:
            gh(["label", "create", f"review:{s}", "--repo", pr["repo"], "--color", LABEL_COLORS[s],
                "--description", f"crew: {STATES[s]}"])
    args = ["pr", "edit", str(pr["number"]), "--repo", pr["repo"], "--add-label", f"review:{state}"]
    stale = [f"review:{s}" for s in STATES if s != state and f"review:{s}" in pr["labels"]]
    if stale:
        args += ["--remove-label", ",".join(stale)]
    gh(args)
    return pr


# --- resources --------------------------------------------------------------

def decks() -> list[tuple[str, str]]:
    r = run(["pi-qemu", "deck", "list"], check=False, timeout=30)
    found = []
    for line in r.stdout.splitlines():
        m = re.match(r"^(\S+)\s+ssh port\s+\S+\s+(\w+)", line)
        if m:
            found.append((m.group(1), m.group(2)))
    return found


def docker_free_gb() -> float | None:
    """Free disk in Docker's VM, where Mixxx builds and their cache live: a container's / is on it. None when Docker
    isn't up (or has no alpine image: it is never pulled for this)."""
    try:
        r = run(["docker", "run", "--rm", "--pull", "never", "--network", "none", "alpine", "df", "-kP", "/"],
                check=False, timeout=60)
    except Fail:
        return None
    m = re.match(r"\S+\s+\d+\s+\d+\s+(\d+)\s", (r.stdout.strip().splitlines() or [""])[-1])
    return int(m.group(1)) / 2**20 if r.returncode == 0 and m else None


def snapshot() -> dict:
    ncpu = int(out(["sysctl", "-n", "hw.ncpu"]))
    load = [float(x) for x in out(["sysctl", "-n", "vm.loadavg"]).strip("{} ").split()[:3]]
    pressure = int(out(["sysctl", "-n", "kern.memorystatus_vm_pressure_level"], check=False) or 0)
    m = re.search(r"free percentage:\s*(\d+)", out(["memory_pressure", "-Q"], check=False))
    mem_free = int(m.group(1)) if m else None
    m = re.search(r"used = ([\d.]+)M", out(["sysctl", "-n", "vm.swapusage"], check=False))
    swap_gb = float(m.group(1)) / 1024 if m else None
    disk_gb = shutil.disk_usage(MAIN).free / 2**30
    sessions = claude_sessions()
    live = {s.get("sessionId") for s in sessions}
    regs = [r for r in registrations() if r["sid"] in live]
    return {
        "ncpu": ncpu, "load": load, "pressure": pressure, "mem_free_pct": mem_free, "swap_gb": swap_gb,
        "disk_gb": disk_gb, "docker_gb": docker_free_gb(), "decks": decks(),
        "minions": [session_name(r) for r in regs if r["role"] == "minion"],
        "bitches": [session_name(r) for r in regs if r["role"] == "bitch"],
        "sessions": [{k: s.get(k) for k in ("name", "kind", "status", "cwd")} for s in sessions],
    }


def verdict(snap: dict, lim: dict, purpose: str) -> tuple[str, list[str]]:
    hold, shed = [], []
    n, (l1, l5, l15) = snap["ncpu"], snap["load"]
    running = [d for d, s in snap["decks"] if s == "running"]
    if snap["pressure"] >= 4:
        shed.append("memory pressure is critical")
    elif snap["pressure"] >= 2:
        hold.append("memory pressure is at warning")
    if snap["disk_gb"] < lim["DISK_SHED_GB"]:
        shed.append(f"{snap['disk_gb']:.0f} GB free disk < {lim['DISK_SHED_GB']:.0f}")
    elif snap["disk_gb"] < lim["DISK_MIN_GB"] and purpose != "build":
        hold.append(f"{snap['disk_gb']:.0f} GB free disk < {lim['DISK_MIN_GB']:.0f}")
    docker = snap.get("docker_gb")
    if docker is not None and docker < lim.get("DOCKER_SHED_GB", 4):
        shed.append(f"{docker:.1f} GB free in Docker's VM < {lim.get('DOCKER_SHED_GB', 4):.0f}: Sam decides a prune")
    elif docker is not None and docker < lim.get("DOCKER_MIN_GB", 8) and purpose != "deck":
        hold.append(f"{docker:.1f} GB free in Docker's VM < {lim.get('DOCKER_MIN_GB', 8):.0f}: no new builds")
    if l15 > lim["LOAD_SHED"] * n:
        shed.append(f"15-min load {l15:.1f} > {lim['LOAD_SHED'] * n:.0f}")
    if l5 > lim["LOAD_MAX"] * n:
        hold.append(f"5-min load {l5:.1f} > {lim['LOAD_MAX'] * n:.0f}")
    if purpose == "minion":
        if len(snap["minions"]) >= lim["MAX_MINIONS"]:
            hold.append(f"{len(snap['minions'])} minions alive (max {lim['MAX_MINIONS']:.0f})")
        if len(running) + lim["DECKS_PER_MINION"] > lim["MAX_DECKS"]:
            hold.append(f"{len(running)} decks running: no room for a minion's (max {lim['MAX_DECKS']:.0f})")
    elif purpose == "deck" and len(running) + 1 > lim["MAX_DECKS"]:
        hold.append(f"{len(running)} decks running (max {lim['MAX_DECKS']:.0f}): {', '.join(running)}")
    return ("shed", shed + hold) if shed else ("hold", hold) if hold else ("ok", [])


def describe(snap: dict, lim: dict) -> str:
    running = [d for d, s in snap["decks"] if s == "running"]
    pressure = {1: "normal", 2: "warning", 4: "critical"}.get(snap["pressure"], str(snap["pressure"]))
    docker = snap.get("docker_gb")
    return (f"load {'/'.join(f'{x:.1f}' for x in snap['load'])} on {snap['ncpu']} cores; memory {pressure}"
            f" ({snap['mem_free_pct']}% free, {snap['swap_gb'] or 0:.1f} GB swap); {snap['disk_gb']:.0f} GB disk free;"
            + (f" Docker's VM {docker:.1f} GB free;" if docker is not None else " Docker's VM: unknown (not up?);") +
            f" decks running {len(running)}/{lim['MAX_DECKS']:.0f} ({', '.join(running) or 'none'});"
            f" minions {len(snap['minions'])}/{lim['MAX_MINIONS']:.0f}")


def cmd_resources(a) -> int:
    lim, snap = limits(), snapshot()
    v, why = verdict(snap, lim, a.purpose)
    if a.json:
        print(json.dumps(dict(snap, verdict=v, reasons=why, purpose=a.purpose), indent=2))
    else:
        print(f"{v} for a new {a.purpose}: " + ("; ".join(why) if why else "within limits"))
        print(describe(snap, lim))
    return {"ok": 0, "hold": 10, "shed": 11}[v]


# --- launching ----------------------------------------------------------------

def write_pitch(path: Path, branch: str, mode: str, text: str):
    title = text.strip().splitlines()[0][:72] if text.strip() else branch
    base = git(MAIN, "rev-parse", "--short", "main")
    path.write_text(f"# {branch}: {title}\n\nMode: {mode}. Started {now_iso()} by Sam, from main {base}.\n\n"
                    f"## Pitch (Sam's words)\n\n{text.strip()}\n")


def cmd_minion(a) -> int:
    b = a.branch
    check_branch(b)
    wt, mode = worktree_of(b), ("night" if a.night else "day")
    if not wt.exists():
        if a.night and not a.force:
            v, why = verdict(snapshot(), limits(), "minion")
            if v != "ok":
                die(f"not starting {b}: resources {v}: {'; '.join(why)} (--force overrides)", 10)
        exists = git_ok(MAIN, "rev-parse", "--verify", "-q", f"refs/heads/{b}")
        run(["git", "-C", MAIN, "worktree", "add", wt] + ([b] if exists else ["-b", b, "main"]))
        print(f"{b}: worktree {wt}, branch {b}" + ("" if exists else f" from main {git(MAIN, 'rev-parse', '--short', 'main')}"))
        r = run(["pi-qemu", "worktree", "prepare"], cwd=wt, check=False, timeout=900)
        if r.returncode:
            die(f"pi-qemu worktree prepare failed in {wt}: {(r.stderr or r.stdout).strip()[-800:]}")
    (wt / ".crew").mkdir(exist_ok=True)
    pitch = wt / ".crew" / "pitch.md"
    if a.pitch:
        shutil.copyfile(a.pitch, pitch)
    elif a.text and not pitch.exists():
        write_pitch(pitch, b, mode, " ".join(a.text))
    if a.no_launch:
        print(wt)
        return 0
    sid = None
    if a.resume:
        sid = latest_sid("minion", b)
    return launch(b, wt, a.bg or a.night, a.prompt or f"/minion {mode}", crew_env("minion", mode, b, wt), sid, a.model)


def cmd_bitch(a) -> int:
    b = a.branch
    wt, mode = worktree_of(b), ("night" if a.night else "day")
    if not wt.exists():
        die(f"no worktree for {b} ({wt})")
    if a.brief:
        shutil.copyfile(a.brief, wt / ".crew" / "review-brief.md")
    sid = latest_sid("bitch", b) if a.resume else None
    return launch(f"{b}-bitch", wt, a.bg or a.night, a.prompt or f"/bitch {b} {mode}", crew_env("bitch", mode, b, wt),
                  sid, a.model)


def latest_sid(role: str, branch: str) -> str:
    regs = [r for r in registrations() if r["role"] == role and r.get("branch") == branch]
    if not regs:
        die(f"no registered {role} session for {branch}")
    return max(regs, key=lambda r: r.get("since", ""))["sid"]


def cmd_resume(a) -> int:
    regs = [r for r in registrations() if session_name(r) == a.name]
    if not regs:
        die(f"no registered crew session named {a.name}")
    reg = max(regs, key=lambda r: r.get("since", ""))
    live = live_session(a.name)
    if live:
        print(f"{a.name} is alive ({live.get('status')}): send it a message instead")
        return 0
    wt = Path(reg["worktree"])
    skill = MAIN / ".claude" / "skills" / reg["role"] / "SKILL.md"
    notes = f"{CREW}/night/plan.md" if reg["role"] == "nightman" else "your .crew/pitch.md and .crew/notes.md"
    prompt = (f"You were resumed as the crew's {reg['role']}" + (f" for {reg['branch']}" if reg.get("branch") else "") +
              f" ({reg['mode']} mode). First re-read {skill}, then {notes}. " +
              (a.prompt or "Then carry on per your skill."))
    return launch(a.name, wt, True, prompt, crew_env(reg["role"], reg["mode"], reg.get("branch"), wt), reg["sid"],
                  a.model)


def cmd_send(a) -> int:
    """A message for a crew session that has ended (after its idle hour, say): it is resumed with it. A running one
    takes messages only through SendMessage, from inside a session, which crew can't send for you: exit 10."""
    live = live_session(a.name)
    if live:
        print(f"{a.name} is running ({live.get('status')}): send it with SendMessage (to: {a.name})")
        return 10
    return cmd_resume(argparse.Namespace(name=a.name, prompt=" ".join(a.text), model=None))


def crew_env(role: str, mode: str, branch, wt: Path) -> dict:
    return {"CREW_ROLE": role, "CREW_MODE": mode, "CREW_BRANCH": branch or "", "CREW_WORKTREE": str(wt)}


def register_session(sid: str, role: str, mode: str, branch, top: Path) -> dict:
    (CREW / "sessions").mkdir(parents=True, exist_ok=True)
    old = registration(sid) or {}
    reg = {"role": role, "mode": mode, "branch": branch, "worktree": str(top),
           "since": old.get("since") if old.get("role") == role else now_iso(), "updated": now_iso()}
    (CREW / "sessions" / f"{sid}.json").write_text(json.dumps(reg, indent=2) + "\n")
    reg["sid"] = sid
    return reg


def cmd_register(a) -> int:
    sid = os.environ.get("CLAUDE_CODE_SESSION_ID")
    if not sid:
        die("not inside a Claude Code session (no CLAUDE_CODE_SESSION_ID)")
    top = superproject_top(Path.cwd())
    branch = None
    if a.role in ("minion", "bitch"):
        if top == MAIN:
            die(f"a {a.role} works in the branch's worktree, not the main checkout: "
                "`crew minion BRANCH --no-launch` makes it, then enter .claude/worktrees/BRANCH")
        branch = a.branch or git(top, "branch", "--show-current")
    else:
        top = MAIN
    reg = register_session(sid, a.role, a.mode, branch, top)
    print(f"registered {session_name(reg)}: {a.role}, {a.mode} mode, in {top}")
    return 0


