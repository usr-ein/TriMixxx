class Fail(Exception):
    def __init__(self, msg: str, code: int = 1):
        super().__init__(msg)
        self.code = code


def die(msg: str, code: int = 1):
    raise Fail(msg, code)


def run(cmd, cwd=None, check=True, env=None, input=None, timeout=None) -> subprocess.CompletedProcess:
    try:
        r = subprocess.run([str(c) for c in cmd], cwd=cwd, env=env, input=input, text=True,
                           capture_output=True, timeout=timeout)
    except FileNotFoundError:
        die(f"{cmd[0]}: not found")
    except subprocess.TimeoutExpired:
        die(f"timed out after {timeout} s: {shlex.join(map(str, cmd))}")
    if check and r.returncode != 0:
        die(f"{shlex.join(map(str, cmd))} failed ({r.returncode}): {(r.stderr or r.stdout).strip()}")
    return r


def out(cmd, cwd=None, check=True, env=None, timeout=None) -> str:
    return run(cmd, cwd=cwd, check=check, env=env, timeout=timeout).stdout.strip()


def git(d, *args, check=True) -> str:
    return out(["git", "-C", d, *args], check=check)


def git_ok(d, *args) -> bool:
    return run(["git", "-C", d, *args], check=False).returncode == 0


def now_iso() -> str:
    return dt.datetime.now().astimezone().isoformat(timespec="seconds")


def limits() -> dict:
    vals = {}
    for line in (HERE / "limits.env").read_text().splitlines():
        line = line.split("#", 1)[0].strip()
        if "=" in line:
            k, v = line.split("=", 1)
            vals[k.strip()] = float(v)
    return vals


def worktree_of(branch: str) -> Path:
    return MAIN / ".claude" / "worktrees" / branch


def check_branch(name: str):
    if not re.fullmatch(r"[a-z0-9][a-z0-9._-]{1,48}", name) or name in ("main", "master") or name.endswith("-bitch"):
        die(f"{name!r}: a crew branch is lowercase kebab-case, 2-49 characters, not main and not ending in -bitch")


def superproject_top(d: Path) -> Path:
    """The top of the checkout d is in, past any submodule (worktree/mixxx -> worktree)."""
    top = git(d, "rev-parse", "--show-toplevel")
    while True:
        sup = git(top, "rev-parse", "--show-superproject-working-tree", check=False)
        if not sup:
            return Path(top)
        top = sup


# --- sessions ---------------------------------------------------------------

def session_name(reg: dict) -> str:
    return {"minion": reg.get("branch"), "bitch": f"{reg.get('branch')}-bitch"}.get(reg["role"], "nightman")


def registration(sid) -> dict | None:
    if not sid:
        return None
    try:
        reg = json.loads((CREW / "sessions" / f"{sid}.json").read_text())
    except (OSError, ValueError):
        return None
    reg["sid"] = sid
    return reg


def registrations() -> list[dict]:
    regs = []
    for p in sorted((CREW / "sessions").glob("*.json")):
        reg = registration(p.stem)
        if reg:
            regs.append(reg)
    return regs


def claude_sessions() -> list[dict]:
    r = run(["claude", "agents", "--json"], check=False, timeout=30)
    try:
        return json.loads(r.stdout) if r.returncode == 0 else []
    except ValueError:
        return []


def live_session(name: str, sessions=None) -> dict | None:
    for s in sessions if sessions is not None else claude_sessions():
        if s.get("name") == name:
            return s
    return None


def launch(name: str, wt: Path, bg: bool, prompt: str, resume_sid=None, model=None) -> int:
    live = live_session(name)
    if live and not resume_sid:
        print(f"{name} is already running ({live.get('kind')}, {live.get('status')}): send it a message, "
              f"or open it with `claude attach {live.get('id') or live.get('sessionId')}`")
        return 0
    cmd = ["claude"] + (["--bg"] if bg else []) + ["-n", name, "--effort", "max"]
    if model:
        cmd += ["--model", model]
    if resume_sid:
        cmd += ["--resume", resume_sid]
    cmd.append(prompt)
    # A session launched from another (the nightman's shell) must not inherit its identity.
    env = {k: v for k, v in os.environ.items()
           if not (k.startswith(("CLAUDE_CODE_", "CLAUDE_PID", "CLAUDECODE")) and k != "CLAUDE_CODE_EFFORT_LEVEL")}
    if not bg:
        os.chdir(wt)
        os.execvpe("claude", cmd, env)
    r = run(cmd, cwd=wt, timeout=120, env=env)
    m = re.search(r"backgrounded\W+(\w+)", r.stdout)
    print(f"{name}: running in the background as {m.group(1) if m else '?'} in {wt}; "
          f"`claude attach {name}` opens it, `claude agents` lists it")
    return 0


# --- GitHub -----------------------------------------------------------------

_token = None


def gh_env(repo=None) -> dict:
    """gh as usr-ein, never as whichever account `gh auth switch` last left active."""
    global _token
    if _token is None:
        r = run(["gh", "auth", "token", "--user", GH_USER], check=False)
        if r.returncode or not r.stdout.strip():
            die(f"gh has no token for {GH_USER}: `gh auth login`, and pick {GH_USER}")
        _token = r.stdout.strip()
    env = dict(os.environ, GH_TOKEN=_token, GH_PROMPT_DISABLED="1")
    env.pop("GITHUB_TOKEN", None)
    if repo:
        env["GH_REPO"] = repo
    return env


def gh(args, repo=None, check=True, input=None) -> subprocess.CompletedProcess:
    return run(["gh", *args], env=gh_env(repo), check=check, input=input, timeout=120)


def gh_json(args, repo=None):
    r = gh(args, repo=repo)
    return json.loads(r.stdout) if r.stdout.strip() else None


def repo_of(d) -> str | None:
    url = git(d, "remote", "get-url", "origin", check=False)
    m = re.search(r"github\.com[^:/]*[:/]([^/]+)/([^/]+?)(?:\.git)?/?$", url or "")
    return f"{m.group(1)}/{m.group(2)}" if m else None


PR_FIELDS = "number,state,isDraft,labels,url,title,headRefName,headRefOid,baseRefName"


def find_prs(branch: str) -> dict:
    """The branch's PRs, by repo path; the TriMixxx one (".") is the primary."""
    prs = {}
    for path, repo in REPOS:
        found = gh_json(["pr", "list", "--repo", repo, "--head", branch, "--state", "all", "--json", PR_FIELDS])
        if found:
            pr = sorted(found, key=lambda p: (p["state"] != "OPEN", -p["number"]))[0]
            pr["repo"] = repo
            pr["labels"] = [lb["name"] for lb in pr["labels"]]
            prs[path] = pr
    return prs


def primary_pr(branch: str, prs=None) -> dict:
    pr = (prs if prs is not None else find_prs(branch)).get(".")
    if not pr:
        die(f"{branch} has no PR on usr-ein/TriMixxx", 2)
    return pr


def review_rounds(pr: dict) -> int:
    pages = gh_json(["api", f"repos/{pr['repo']}/pulls/{pr['number']}/reviews", "--paginate", "--slurp"]) or []
    return sum(1 for page in pages for rv in page if (rv.get("body") or "").startswith(REVIEW_MARK))


def set_state(branch: str, state: str, prs=None):
    pr = primary_pr(branch, prs)
    have = {lb["name"] for lb in gh_json(["label", "list", "--repo", pr["repo"], "--limit", "200", "--json", "name"])}
    for s in STATES:
        if f"review:{s}" not in have:
            gh(["label", "create", f"review:{s}", "--repo", pr["repo"], "--color", LABEL_COLORS[s],
                "--description", f"crew: {STATES[s]}"])
    args = ["pr", "edit", str(pr["number"]), "--repo", pr["repo"], "--add-label", f"review:{state}"]
    stale = [f"review:{s}" for s in STATES if s != state and f"review:{s}" in pr["labels"]]
    if stale:
        args += ["--remove-label", ",".join(stale)]
    gh(args)
    return pr


# --- resources --------------------------------------------------------------

def decks() -> list[tuple[str, str]]:
    r = run(["pi-qemu", "deck", "list"], check=False, timeout=30)
    found = []
    for line in r.stdout.splitlines():
        m = re.match(r"^(\S+)\s+ssh port\s+\S+\s+(\w+)", line)
        if m:
            found.append((m.group(1), m.group(2)))
    return found


def snapshot() -> dict:
    ncpu = int(out(["sysctl", "-n", "hw.ncpu"]))
    load = [float(x) for x in out(["sysctl", "-n", "vm.loadavg"]).strip("{} ").split()[:3]]
    pressure = int(out(["sysctl", "-n", "kern.memorystatus_vm_pressure_level"], check=False) or 0)
    m = re.search(r"free percentage:\s*(\d+)", out(["memory_pressure", "-Q"], check=False))
    mem_free = int(m.group(1)) if m else None
    m = re.search(r"used = ([\d.]+)M", out(["sysctl", "-n", "vm.swapusage"], check=False))
    swap_gb = float(m.group(1)) / 1024 if m else None
    disk_gb = shutil.disk_usage(MAIN).free / 2**30
    sessions = claude_sessions()
    live = {s.get("sessionId") for s in sessions}
    regs = [r for r in registrations() if r["sid"] in live]
    return {
        "ncpu": ncpu, "load": load, "pressure": pressure, "mem_free_pct": mem_free, "swap_gb": swap_gb,
        "disk_gb": disk_gb, "decks": decks(),
        "minions": [session_name(r) for r in regs if r["role"] == "minion"],
        "bitches": [session_name(r) for r in regs if r["role"] == "bitch"],
        "sessions": [{k: s.get(k) for k in ("name", "kind", "status", "cwd")} for s in sessions],
    }


def verdict(snap: dict, lim: dict, purpose: str) -> tuple[str, list[str]]:
    hold, shed = [], []
    n, (l1, l5, l15) = snap["ncpu"], snap["load"]
    running = [d for d, s in snap["decks"] if s == "running"]
    if snap["pressure"] >= 4:
        shed.append("memory pressure is critical")
    elif snap["pressure"] >= 2:
        hold.append("memory pressure is at warning")
    if snap["disk_gb"] < lim["DISK_SHED_GB"]:
        shed.append(f"{snap['disk_gb']:.0f} GB free disk < {lim['DISK_SHED_GB']:.0f}")
    elif snap["disk_gb"] < lim["DISK_MIN_GB"] and purpose != "build":
        hold.append(f"{snap['disk_gb']:.0f} GB free disk < {lim['DISK_MIN_GB']:.0f}")
    if l15 > lim["LOAD_SHED"] * n:
        shed.append(f"15-min load {l15:.1f} > {lim['LOAD_SHED'] * n:.0f}")
    if l5 > lim["LOAD_MAX"] * n:
        hold.append(f"5-min load {l5:.1f} > {lim['LOAD_MAX'] * n:.0f}")
    if purpose == "minion":
        if len(snap["minions"]) >= lim["MAX_MINIONS"]:
            hold.append(f"{len(snap['minions'])} minions alive (max {lim['MAX_MINIONS']:.0f})")
        if len(running) + lim["DECKS_PER_MINION"] > lim["MAX_DECKS"]:
            hold.append(f"{len(running)} decks running: no room for a minion's (max {lim['MAX_DECKS']:.0f})")
    elif purpose == "deck" and len(running) + 1 > lim["MAX_DECKS"]:
        hold.append(f"{len(running)} decks running (max {lim['MAX_DECKS']:.0f}): {', '.join(running)}")
    return ("shed", shed + hold) if shed else ("hold", hold) if hold else ("ok", [])


def describe(snap: dict, lim: dict) -> str:
    running = [d for d, s in snap["decks"] if s == "running"]
    pressure = {1: "normal", 2: "warning", 4: "critical"}.get(snap["pressure"], str(snap["pressure"]))
    return (f"load {'/'.join(f'{x:.1f}' for x in snap['load'])} on {snap['ncpu']} cores; memory {pressure}"
            f" ({snap['mem_free_pct']}% free, {snap['swap_gb'] or 0:.1f} GB swap); {snap['disk_gb']:.0f} GB disk free;"
            f" decks running {len(running)}/{lim['MAX_DECKS']:.0f} ({', '.join(running) or 'none'});"
            f" minions {len(snap['minions'])}/{lim['MAX_MINIONS']:.0f}")


def cmd_resources(a) -> int:
    lim, snap = limits(), snapshot()
    v, why = verdict(snap, lim, a.purpose)
    if a.json:
        print(json.dumps(dict(snap, verdict=v, reasons=why, purpose=a.purpose), indent=2))
    else:
        print(f"{v} for a new {a.purpose}: " + ("; ".join(why) if why else "within limits"))
        print(describe(snap, lim))
    return {"ok": 0, "hold": 10, "shed": 11}[v]


# --- launching ----------------------------------------------------------------

def write_pitch(path: Path, branch: str, mode: str, text: str):
    title = text.strip().splitlines()[0][:72] if text.strip() else branch
    base = git(MAIN, "rev-parse", "--short", "main")
    path.write_text(f"# {branch}: {title}\n\nMode: {mode}. Started {now_iso()} by Sam, from main {base}.\n\n"
                    f"## Pitch (Sam's words)\n\n{text.strip()}\n")


def cmd_minion(a) -> int:
    b = a.branch
    check_branch(b)
    wt, mode = worktree_of(b), ("night" if a.night else "day")
    if not wt.exists():
        if a.night and not a.force:
            v, why = verdict(snapshot(), limits(), "minion")
            if v != "ok":
                die(f"not starting {b}: resources {v}: {'; '.join(why)} (--force overrides)", 10)
        exists = git_ok(MAIN, "rev-parse", "--verify", "-q", f"refs/heads/{b}")
        run(["git", "-C", MAIN, "worktree", "add", wt] + ([b] if exists else ["-b", b, "main"]))
        print(f"{b}: worktree {wt}, branch {b}" + ("" if exists else f" from main {git(MAIN, 'rev-parse', '--short', 'main')}"))
        r = run(["pi-qemu", "worktree", "prepare"], cwd=wt, check=False, timeout=900)
        if r.returncode:
            die(f"pi-qemu worktree prepare failed in {wt}: {(r.stderr or r.stdout).strip()[-800:]}")
    (wt / ".crew").mkdir(exist_ok=True)
    pitch = wt / ".crew" / "pitch.md"
    if a.pitch:
        shutil.copyfile(a.pitch, pitch)
    elif a.text and not pitch.exists():
        write_pitch(pitch, b, mode, " ".join(a.text))
    if a.no_launch:
        print(wt)
        return 0
    sid = None
    if a.resume:
        sid = latest_sid("minion", b)
    return launch(b, wt, a.bg or a.night, a.prompt or f"/minion {mode}", sid, a.model)


def cmd_bitch(a) -> int:
    b = a.branch
    wt, mode = worktree_of(b), ("night" if a.night else "day")
    if not wt.exists():
        die(f"no worktree for {b} ({wt})")
    if a.brief:
        shutil.copyfile(a.brief, wt / ".crew" / "review-brief.md")
    sid = latest_sid("bitch", b) if a.resume else None
    return launch(f"{b}-bitch", wt, a.bg or a.night, a.prompt or f"/bitch {b} {mode}", sid, a.model)


def latest_sid(role: str, branch: str) -> str:
    regs = [r for r in registrations() if r["role"] == role and r.get("branch") == branch]
    if not regs:
        die(f"no registered {role} session for {branch}")
    return max(regs, key=lambda r: r.get("since", ""))["sid"]


def cmd_resume(a) -> int:
    regs = [r for r in registrations() if session_name(r) == a.name]
    if not regs:
        die(f"no registered crew session named {a.name}")
    reg = max(regs, key=lambda r: r.get("since", ""))
    live = live_session(a.name)
    if live and live.get("sessionId") == reg["sid"]:
        print(f"{a.name} is alive ({live.get('status')}): send it a message instead")
        return 0
    wt = Path(reg["worktree"])
    prompt = a.prompt or "You were resumed. Carry on per your crew skill (re-read it, your pitch and notes first)."
    return launch(a.name, wt, True, prompt, reg["sid"], a.model)


def cmd_register(a) -> int:
    sid = os.environ.get("CLAUDE_CODE_SESSION_ID")
    if not sid:
        die("not inside a Claude Code session (no CLAUDE_CODE_SESSION_ID)")
    top = superproject_top(Path.cwd())
    branch = None
    if a.role in ("minion", "bitch"):
        if top == MAIN:
            die(f"a {a.role} works in the branch's worktree, not the main checkout: "
                "`crew minion BRANCH --no-launch` makes it, then enter .claude/worktrees/BRANCH")
        branch = a.branch or git(top, "branch", "--show-current")
    else:
        top = MAIN
    (CREW / "sessions").mkdir(parents=True, exist_ok=True)
    old = registration(sid) or {}
    reg = {"role": a.role, "mode": a.mode, "branch": branch, "worktree": str(top),
           "since": old.get("since") if old.get("role") == a.role else now_iso(), "updated": now_iso()}
    (CREW / "sessions" / f"{sid}.json").write_text(json.dumps(reg, indent=2) + "\n")
    print(f"registered {session_name(reg)}: {a.role}, {a.mode} mode, in {top}")
    return 0


# --- status -----------------------------------------------------------------

def notes_status(wt: Path) -> str:
    try:
        for line in (wt / ".crew" / "notes.md").read_text().splitlines():
            if line.startswith("Status:"):
                return line[len("Status:"):].strip()
    except OSError:
        pass
    return ""


def cmd_status(a) -> int:
    lim, snap = limits(), snapshot()
    by_name = {s.get("name"): s for s in claude_sessions()}
    open_prs = {p["headRefName"]: p for p in gh_json(
        ["pr", "list", "--repo", "usr-ein/TriMixxx", "--state", "open", "--json", PR_FIELDS]) or []}
    rows = []
    for wt in sorted((MAIN / ".claude" / "worktrees").glob("*/")):
        b = wt.name
        if not (wt / ".crew").is_dir():
            continue

        def sess(name):
            s = by_name.get(name)
            return f"{s.get('status')}" if s else "-"
        pr = open_prs.get(b)
        state = next((lb["name"].split(":", 1)[1] for lb in pr["labels"] if lb["name"].startswith("review:")), "open") if pr else "-"
        dks = [f"{d}({s[:3]})" for d, s in snap["decks"] if d == b or d.startswith(b + "-")]
        rows.append([b, sess(b), sess(f"{b}-bitch"), f"#{pr['number']}" if pr else "-", state,
                     " ".join(dks) or "-", notes_status(wt)[:60]])
    if rows:
        head = ["branch", "minion", "bitch", "PR", "review", "decks", "status"]
        widths = [max(len(str(r[i])) for r in rows + [head]) for i in range(len(head))]
        for r in [head] + rows:
            print("  ".join(str(c).ljust(w) for c, w in zip(r, widths)).rstrip())
    else:
        print("no crew worktrees")
    night = by_name.get("nightman")
    print(f"\nnightman: {night.get('status') if night else 'not running'}")
    v, why = verdict(snap, lim, "minion")
    print(f"resources: {v}" + (f" ({'; '.join(why)})" if why else "") + f"\n  {describe(snap, lim)}")
    return 0


# --- preflight ----------------------------------------------------------------

def cmd_preflight(a) -> int:
    bad, warn = [], []

    def check(ok: bool, good: str, fix: str, soft=False):
        print(("  ok   " if ok else ("  warn " if soft else "  FAIL ")) + (good if ok else fix))
        if not ok:
            (warn if soft else bad).append(fix)

    print("Mac")
    batt = out(["pmset", "-g", "batt"], check=False)
    check("AC Power" in batt, "on mains power", "on battery: plug the charger in (caffeinate cannot hold a Mac awake on battery)")
    if a.keep_awake:
        pid = str(a.keep_awake)
        mine = run(["pgrep", "-f", f"caffeinate -i -s -m -w {pid}"], check=False).returncode == 0
        if not mine:
            subprocess.Popen(["caffeinate", "-i", "-s", "-m", "-w", pid], start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        print(f"  ok   kept awake while process {pid} lives (caffeinate); the lid must stay open")
    key = Path.home() / ".ssh" / "with_pass" / "rsa_sam.pub"
    fp = out(["ssh-keygen", "-lf", key], check=False).split()[1:2]
    agent = out(["ssh-add", "-l"], check=False)
    check(bool(fp) and fp[0] in agent, "ssh agent holds with_pass/rsa_sam (decks, commit signing, pushes)",
          "ssh agent lacks with_pass/rsa_sam: run `! ssh-add --apple-use-keychain ~/.ssh/with_pass/rsa_sam`")
    gh_login = gh(["api", "user", "--jq", ".login"], check=False).stdout.strip()
    check(gh_login == GH_USER, f"gh acts as {GH_USER} through crew gh", f"crew gh acts as {gh_login or 'nobody'}, not {GH_USER}")
    r = run(["ssh", "-T", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", "git@github.com-usr-ein"], check=False, timeout=30)
    check(f"Hi {GH_USER}" in r.stderr + r.stdout, "GitHub accepts pushes as usr-ein", "ssh to github.com-usr-ein fails: pushes will too")
    r = run(["docker", "info", "--format", "{{.ServerVersion}}"], check=False, timeout=30)
    check(r.returncode == 0, "Docker is up (Mixxx builds)", "Docker is not running: start Docker Desktop")

    print("Repositories (main vs origin/main)")
    for path, repo in REPOS:
        d = MAIN / path
        if not (d / ".git").exists():
            continue
        run(["git", "-C", d, "fetch", "--quiet", "origin"], check=False, timeout=120)
        ahead = int(git(d, "rev-list", "--count", "origin/main..main", check=False) or 0)
        behind = int(git(d, "rev-list", "--count", "main..origin/main", check=False) or 0)
        check(ahead == 0, f"{path}: main is pushed" + (f" ({behind} behind: crew merge catches up)" if behind else ""),
              f"{path}: main has {ahead} commit(s) not on origin. Push them before the night, or every crew PR on "
              f"{repo} carries them and no merge goes through")
        dirty = git(d, "status", "--porcelain", "--untracked-files=no", "--ignore-submodules=all", check=False)
        check(not dirty, f"{path}: no uncommitted changes to tracked files",
              f"{path}: uncommitted changes in the main checkout; a merge that touches them stops", soft=True)

    print("Load")
    lim, snap = limits(), snapshot()
    print(f"  {describe(snap, lim)}")
    v, why = verdict(snap, lim, "minion")
    check(v == "ok", "room to dispatch a minion now", f"no room to dispatch yet ({'; '.join(why)})", soft=True)
    others = [s for s in snap["sessions"] if s.get("status") == "busy" and s.get("name") not in ("nightman",)]
    if others:
        print("  note other busy Claude sessions share this Mac: " + ", ".join(str(s.get("name")) for s in others))
    if bad:
        print(f"\n{len(bad)} to fix before the night.")
    return 1 if bad else 0


# --- merge and clean ------------------------------------------------------------

def tip(d: Path, ref: str) -> str | None:
    r = run(["git", "-C", d, "rev-parse", "--verify", "-q", ref + "^{commit}"], check=False)
    return r.stdout.strip() or None


def cmd_merge(a) -> int:
    b = a.branch
    prs = find_prs(b)
    pr = primary_pr(b, prs)
    if pr["state"] != "OPEN":
        die(f"PR #{pr['number']} is {pr['state'].lower()}", 2)
    if pr["isDraft"]:
        die(f"PR #{pr['number']} is a draft", 2)
    if "review:needs-sam" in pr["labels"]:
        die(f"PR #{pr['number']} waits for Sam (review:needs-sam)", 2)
    if "review:approved" not in pr["labels"] and not a.unapproved:
        die(f"PR #{pr['number']} is not approved (labels: {', '.join(pr['labels']) or 'none'})", 2)

    involved = []
    for path, repo in REPOS:
        d = MAIN / path
        if not (d / ".git").exists():
            continue
        run(["git", "-C", d, "fetch", "--quiet", "origin"], timeout=180)
        if tip(d, f"refs/heads/{b}") or tip(d, f"refs/remotes/origin/{b}"):
            involved.append((path, repo, d))
    if not any(p == "." for p, _, _ in involved):
        die(f"{b} has no branch in TriMixxx itself", 2)

    # Each repo's main must be what origin has: never publish someone's unpushed commits.
    for path, repo, d in [(p, r, MAIN / p) for p, r in REPOS if (MAIN / p / ".git").exists()]:
        ahead = int(git(d, "rev-list", "--count", "origin/main..main"))
        if ahead:
            die(f"{path}: main has {ahead} commit(s) that origin lacks (Sam's unpushed work?). "
                "Nothing merged; Sam decides whether to push them", 4)

    plan = []
    for path, repo, d in involved:
        local, remote = tip(d, f"refs/heads/{b}"), tip(d, f"refs/remotes/origin/{b}")
        if remote is None or (local and local != remote):
            die(f"{path}: {b} is not pushed as it is locally (local {str(local)[:7]}, origin {str(remote)[:7]})", 2)
        main_tip = tip(d, "refs/remotes/origin/main")
        if main_tip == remote or git_ok(d, "merge-base", "--is-ancestor", remote, main_tip):
            plan.append((path, repo, d, remote, "merged"))
            continue
        if not git_ok(d, "merge-base", "--is-ancestor", main_tip, remote):
            die(f"{path}: {b} is not on top of main any more: the minion must rebase it (deepest repo first), "
                "re-point the submodules, retest and push", 3)
        plan.append((path, repo, d, remote, "merge"))
    tips = {p: t for p, _, _, t, _ in plan}
    for child, (parent, sub) in GITLINKS.items():
        if child in tips:
            pref = tips.get(parent) or tip(MAIN / parent, "refs/remotes/origin/main")
            link = git(MAIN / parent, "rev-parse", f"{pref}:{sub}")
            if link != tips[child]:
                die(f"{parent} on {b} points {sub} at {link[:7]}, but {child}'s {b} is {tips[child][:7]}: "
                    "the minion must commit the submodule bump", 2)

    for path, repo, d, t, what in plan:
        print(f"{path:22} {what:7} {t[:7]}  {repo}")
    if a.dry_run:
        return 0

    for path, repo, d, t, what in plan:
        if what == "merged":
            continue
        head = git(d, "symbolic-ref", "-q", "HEAD", check=False)
        if git(d, "rev-parse", "main") != tip(d, "refs/remotes/origin/main"):
            run(["git", "-C", d, "fetch", ".", "refs/remotes/origin/main:refs/heads/main"] if head != "refs/heads/main"
                else ["git", "-C", d, "merge", "--ff-only", "--quiet", "origin/main"])
        if head == "refs/heads/main":
            run(["git", "-C", d, "merge", "--ff-only", "--quiet", t])
        else:
            run(["git", "-C", d, "fetch", ".", f"{t}:refs/heads/main"])
        r = run(["git", "-C", d, "push", "origin", "main"], check=False, timeout=300)
        if r.returncode:
            die(f"{path}: push of main failed, so the merge stops here (deeper repos are pushed):\n{r.stderr.strip()}", 5)
        print(f"{path}: main is {t[:7]}, pushed")

    # The main checkout's submodules follow the pointers main now records.
    for child, (parent, sub) in GITLINKS.items():
        d = MAIN / child
        if not (d / ".git").exists():
            continue
        want = git(MAIN / parent, "rev-parse", f"HEAD:{sub}", check=False)
        if want and git(d, "rev-parse", "HEAD") != want:
            if git(d, "symbolic-ref", "-q", "HEAD", check=False) or git(d, "status", "--porcelain", "--untracked-files=no"):
                print(f"note: {child} in the main checkout is not at {want[:7]}, which main records; left as it is")
            else:
                run(["git", "-C", d, "checkout", "--quiet", "--detach", want])

    for path, repo, d, t, what in plan:
        p = prs.get(path)
        if not p:
            continue
        for _ in range(10):
            state = gh_json(["pr", "view", str(p["number"]), "--repo", repo, "--json", "state"])["state"]
            if state == "MERGED":
                break
            time.sleep(3)
        print(f"{repo}#{p['number']}: {state.lower()}")
    return 0


def cmd_clean(a) -> int:
    b = a.branch
    wt = worktree_of(b)
    for path, repo in REPOS:
        d = MAIN / path
        t = tip(d, f"refs/heads/{b}") if (d / ".git").exists() else None
        if t and not a.abandon and not git_ok(d, "merge-base", "--is-ancestor", t, "main"):
            die(f"{path}: {b} has commits main lacks; nothing cleaned (`--abandon` stops its sessions and decks only)", 2)

    me = os.environ.get("CLAUDE_CODE_SESSION_ID")
    blocking = []
    for s in claude_sessions():
        if s.get("name") in (b, f"{b}-bitch") and s.get("sessionId") != me:
            if s.get("kind") == "background":
                run(["claude", "stop", s.get("id") or s["sessionId"]], check=False, timeout=60)
                print(f"stopped {s.get('name')}")
            else:
                blocking.append(s.get("name"))
    for name, state in decks():
        if name == b or name.startswith(b + "-"):
            run(["pi-qemu", "deck", "rm", name], check=False, timeout=180)
            print(f"removed deck {name}")
    if a.abandon:
        print(f"{b}: sessions and decks stopped; worktree and branches kept")
        return 0
    if blocking:
        die(f"{', '.join(blocking)} still open in a terminal: exit it, then `crew clean {b}` again", 2)

    if (wt / ".crew").is_dir():
        dest = CREW / "archive" / f"{b}-{dt.date.today().isoformat()}"
        shutil.copytree(wt / ".crew", dest, dirs_exist_ok=True)
        shutil.rmtree(wt / ".crew")  # archived; git may not ignore it in a worktree older than the crew
        print(f"kept its pitch and notes in {dest}")
    if wt.exists():
        r = run(["pi-qemu", "worktree", "release"], cwd=wt, check=False, timeout=600)
        if r.returncode:
            die(f"pi-qemu worktree release refused: {(r.stderr or r.stdout).strip()[-600:]}", 2)
        run(["git", "-C", MAIN, "worktree", "remove", wt])
        print(f"removed worktree {wt}")
    for path, repo in REPOS:
        d = MAIN / path
        if not (d / ".git").exists():
            continue
        if tip(d, f"refs/heads/{b}"):
            git(d, "branch", "-d", b, check=False)
        if tip(d, f"refs/remotes/origin/{b}"):
            run(["git", "-C", d, "push", "--quiet", "origin", "--delete", b], check=False, timeout=120)
            print(f"{path}: deleted {b} on origin")
    for reg in registrations():
        if reg.get("branch") == b:
            (CREW / "sessions" / f"{reg['sid']}.json").unlink(missing_ok=True)
            (CREW / "sessions" / f"{reg['sid']}.drift.json").unlink(missing_ok=True)
    return 0


