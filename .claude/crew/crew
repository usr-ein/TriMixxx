#!/usr/bin/env python3
"""crew: the tool of TriMixxx's agent crew: minions, bitches and the nightman.

How the crew works: .claude/crew/README.md. The roles: .claude/skills/{minion,bitch,nightman}.
Stdlib only. Run it by path, or as `crew` once `crew install` has linked it into ~/.local/bin.
"""

from __future__ import annotations

import os
import sys

# Hooks run on every tool call of every session in the repo: settle "not a crew session" before
# importing anything else (~10 ms instead of ~60).
_HOOK_INPUT = None
if __name__ == "__main__" and sys.argv[1:2] == ["hook"]:
    _HOOK_INPUT = sys.stdin.read()
    _at = _HOOK_INPUT.find('"session_id"')
    _sid = _HOOK_INPUT[_at:].split('"')[3] if _at >= 0 else ""
    _main = os.path.dirname(os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
    _state = os.environ.get("CREW_STATE") or os.path.join(_main.split("/.claude/worktrees/")[0], ".crew")
    _launched_by_crew = sys.argv[2:3] == ["session"] and os.environ.get("CREW_ROLE")
    if not _sid or "/" in _sid or not (os.path.exists(os.path.join(_state, "sessions", _sid + ".json"))
                                       or _launched_by_crew):
        sys.exit(0)


def _run_main_checkouts_copy():
    """Every copy of crew (a worktree's, a hook's) runs the main checkout's, so a fix to the crew
    reaches the sessions already running. CREW_LOCAL=1 runs this copy instead (to try a change)."""
    here = os.path.realpath(__file__)
    checkout = os.path.dirname(os.path.dirname(os.path.dirname(here)))
    main_copy = os.path.join(checkout.split("/.claude/worktrees/")[0], ".claude", "crew", "crew")
    if os.environ.get("CREW_LOCAL") or not os.path.isfile(main_copy) or os.path.samefile(main_copy, here):
        return
    if _HOOK_INPUT is None:
        os.execv(sys.executable, [sys.executable, main_copy] + sys.argv[1:])
    import subprocess as sp
    r = sp.run([sys.executable, main_copy] + sys.argv[1:], input=_HOOK_INPUT, text=True, capture_output=True)
    sys.stdout.write(r.stdout)
    sys.stderr.write(r.stderr)
    sys.exit(r.returncode)


if __name__ == "__main__":
    _run_main_checkouts_copy()

