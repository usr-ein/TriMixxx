UNIT = re.compile(r"trimixxx[1-9]\d*")  # a real deck by its own name, as in mixxx_config/units/


def resolve_host(name: str) -> str:
    """What ssh reaches for name: its HostName in ~/.ssh/config (trimixxx-pi -> 192.168.1.80), or the name itself."""
    if not name or name.startswith("-"):
        return name.lower()
    try:
        r = subprocess.run(["ssh", "-G", name], capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.SubprocessError):
        return name.lower()
    m = re.search(r"^hostname (\S+)$", r.stdout, re.M)
    return (m.group(1) if m else name).lower()


def host_names(host: str) -> set[str]:
    """A host as the locks compare it: its name, and the address ssh resolves it to. %% is a %: ssh expands an
    `-o HostName=`, so an IPv6 link-local's interface is written fe80::...%%en12 there."""
    host = host.rsplit("@", 1)[-1].strip("[]").replace("%%", "%").lower()
    return {host, resolve_host(host)}


def locks() -> dict:
    """The real decks held, by unit: {unit, holder (a minion's branch, or Sam), names, since, by, why}."""
    held = {}
    for p in sorted((CREW / "locks").glob("*.json")):
        try:
            lk = json.loads(p.read_text())
        except (OSError, ValueError):
            continue
        if isinstance(lk, dict) and lk.get("holder") and isinstance(lk.get("names"), list):
            held[p.stem] = lk
    return held


def lock_on(names: set[str], held: dict) -> tuple[str, dict] | None:
    return next(((u, lk) for u, lk in held.items() if names & set(lk["names"])), None)


def units_named(names) -> list[str]:
    """The units a host's names spell out: trimixxx2.local, the HostName of trimixxx-pi-2, is trimixxx2."""
    return sorted({f"trimixxx{d}" for n in names for d in re.findall(r"trimixxx([1-9]\d*)", n)})


def lock_line(unit: str, lk: dict) -> str:
    via = [n for n in lk["names"] if n not in (unit, f"{unit}.local")]
    return (f"{unit}: {lk['holder']}'s since {(lk.get('since') or '')[11:16]}, granted by {lk.get('by') or '?'}"
            + (f" ({lk['why']})" if lk.get("why") else "") + (f"; reached as {', '.join(via)}" if via else ""))


def cmd_lock(a) -> int:
    held = locks()
    if not a.unit:
        print("\n".join(lock_line(u, lk) for u, lk in held.items()) or "no real deck is locked")
        return 0
    unit = a.unit.lower()
    if not UNIT.fullmatch(unit):
        die(f"{a.unit} is not a unit. A unit is a real deck's own name (trimixxx1, trimixxx2, ...); the ssh aliases "
            "and addresses it is reached by come after it: `crew lock trimixxx1 trimixxx-pi 169.254.232.146`", 2)
    reg = registration(os.environ.get("CLAUDE_CODE_SESSION_ID"))  # None: Sam, from his shell or a session of his
    role = reg["role"] if reg else None
    if role == "bitch":
        die("the bitch never uses a real deck", 2)
    if role == "minion":
        holder = reg["branch"]
        if a.holder and a.holder != holder:
            die(f"a minion locks units for itself ({holder}) only", 2)
    elif a.holder:
        holder = "Sam" if a.holder.lower() == "sam" else a.holder
    elif role:
        die("say who holds it: --for BRANCH (the minion you grant it to), or --for Sam", 2)
    else:
        holder = "Sam"
    if holder != "Sam":
        check_branch(holder)
        if not worktree_of(holder).is_dir():
            die(f"{holder} has no crew worktree ({worktree_of(holder)}): --for BRANCH, or --for Sam", 2)
    cur = held.get(unit)
    if cur and cur["holder"] != holder:
        die(f"{lock_line(unit, cur)}. One holder at a time: it is free once they `crew unlock {unit}`", 3)
    if role == "minion" and reg["mode"] == "night" and not cur:
        die(f"at night the nightman grants real decks, on Sam's go: ask it for {unit}, saying what you will do on it, "
            "for how long, and how you will leave it", 2)
    names = set(cur["names"]) if cur else {unit, f"{unit}.local"}
    for n in a.names:
        new = host_names(n)
        others = [u for u in units_named(new) if u != unit]
        if others:
            die(f"{n} is {others[0]}'s name, not {unit}'s", 2)
        taken = lock_on(new, {u: lk for u, lk in held.items() if u != unit})
        if taken:
            die(f"{n} is in the lock on {lock_line(*taken)}. One holder per unit", 3)
        names |= new
    lk = {"unit": unit, "holder": holder, "names": sorted(names), "since": cur["since"] if cur else now_iso(),
          "by": cur["by"] if cur else session_name(reg) if reg else "Sam", "why": a.why or (cur or {}).get("why", "")}
    path = CREW / "locks" / f"{unit}.json"
    path.parent.mkdir(parents=True, exist_ok=True)
    text = json.dumps(lk, indent=2) + "\n"
    if cur:
        tmp = path.with_name(f".{unit}.{os.getpid()}.tmp")
        tmp.write_text(text)
        tmp.replace(path)
    else:
        try:
            with open(path, "x") as f:  # of two sessions locking one unit at the same moment, one gets it
                f.write(text)
        except FileExistsError:
            now = locks().get(unit)
            die(f"{lock_line(unit, now) if now else unit}: locked just now. One holder at a time", 3)
    print(lock_line(unit, lk))
    return 0


def cmd_unlock(a) -> int:
    unit = a.unit.lower()
    cur = locks().get(unit)
    if not cur:
        print(f"{unit} is not locked")
        return 0
    reg = registration(os.environ.get("CLAUDE_CODE_SESSION_ID"))
    if reg and reg["role"] == "bitch":
        die("the bitch never uses a real deck", 2)
    if reg and reg["role"] == "minion" and cur["holder"] != reg["branch"]:
        die(f"{lock_line(unit, cur)}. Only its holder, the nightman or Sam frees it", 2)
    (CREW / "locks" / f"{unit}.json").unlink(missing_ok=True)
    print(f"{unit} is free (it was {cur['holder']}'s since {(cur.get('since') or '')[11:16]})")
    return 0


def release_locks(holder: str) -> list[str]:
    freed = [u for u, lk in locks().items() if lk["holder"] == holder]
    for u in freed:
        (CREW / "locks" / f"{u}.json").unlink(missing_ok=True)
    return freed


