TMP_ROOTS = ("/tmp/", "/private/tmp/", "/var/folders/", "/private/var/folders/")


def under(p: Path, root: Path) -> bool:
    try:
        p.resolve().relative_to(root.resolve())
        return True
    except ValueError:
        return False


def write_reason(path: str, reg: dict) -> str | None:
    if not path:
        return None
    p, wt, role = Path(path), Path(reg["worktree"]), reg["role"]
    allowed = {"minion": wt, "bitch": wt / ".crew"}.get(role, CREW)
    if under(p, allowed):
        return None
    why = {"minion": f"a minion writes only inside its worktree {wt}",
           "bitch": "the bitch is read-only: it writes reviews to a temp file or its .crew/"}.get(
        role, f"the nightman writes only its own state under {CREW}")
    if under(p, MAIN):
        return why
    s = str(p.resolve())
    scratch = [os.environ.get("TMPDIR"), os.environ.get("CLAUDE_JOB_DIR")]
    if s.startswith(TMP_ROOTS) or any(x and s.startswith(os.path.realpath(x)) for x in scratch):
        return None
    if re.search(r"/\.claude/(projects/[^/]+/memory|jobs)/", s):  # memory; a background session's job directory
        return None
    return why


HEREDOC = re.compile(r"<<-?\s*(['\"]?)([A-Za-z_]\w*)\1")
QUOTED = re.compile(r"'[^']*'|\"(?:\\.|[^\"\\])*\"", re.S)
SPLIT = re.compile(r"\|\||&&|[;|&\n(){}]|\$\(|`")
SEPARATORS = "();<>|&`\n"
REDIRECTS = {"<", ">", "<<", "<<<", ">>", "<&", ">&", "&>", "&>>", "<>", ">|"}  # not <( or >(: commands run in those
WRAPPERS ={"command", "exec", "nohup", "time", "nice", "env", "timeout", "xargs", "caffeinate", "{", "}", "!", "if",
            "then", "else", "elif", "while", "until", "do"}
GIT_WRITES = {"commit", "push", "merge", "rebase", "reset", "checkout", "switch", "stash", "tag", "cherry-pick",
              "revert", "am", "apply", "clean", "add", "rm", "mv", "worktree", "pull", "submodule", "restore",
              "branch", "remote", "config", "update-ref", "update-index", "notes", "gc", "prune", "filter-branch"}
SSH_VALUE_OPTS = set("bcDEeFIiJLlmOoPpQRSWw")
# trimixxx0 is the emulated one. 169.254 and fe80:: are link-local: a deck's Ethernet, cabled to the Mac's dock.
REAL_DECK = re.compile(r"^(trimixxx(?!0$)[\w.-]*|192\.168\.\d+\.\d+|169\.254\.\d+\.\d+"
                       r"|fe[89ab][0-9a-f]:[0-9a-f:]*(%[\w.-]+)?)$", re.I)


def strip_heredocs(cmd: str) -> str:
    lines, kept, term = cmd.split("\n"), [], None
    for line in lines:
        if term is not None:
            if line.strip() == term:
                term = None
            continue
        kept.append(line)
        m = HEREDOC.search(line)
        if m:
            term = m.group(2)
    return "\n".join(kept)


def segments(cmd: str) -> list[list[str]]:
    """The command's simple commands, as words. Quotes are respected (quoted text is never a command), heredoc
    bodies dropped, and redirections too (`2>&1`, `>log`): a seatbelt's parser, not a shell's."""
    text = strip_heredocs(cmd)
    try:
        lex = shlex.shlex(text, posix=True, punctuation_chars=SEPARATORS)
        lex.whitespace, lex.whitespace_split = " \t\r", True
        words = list(lex)
    except ValueError:  # an unbalanced quote: blank out what looks quoted, split roughly
        return [seg.split() for seg in SPLIT.split(QUOTED.sub("''", text))]
    segs, cur, target = [], [], False
    for w in words:
        if w in REDIRECTS:  # the command goes on; the fd before it (the 2 of 2>&1) and its target are no arguments
            if cur and cur[-1].isdigit():
                cur.pop()
            target = True
        elif w and set(w) <= set(SEPARATORS):
            segs.append(cur)
            cur, target = [], False
        elif target:
            target = False
        else:
            cur.append(w)
    segs.append(cur)
    return segs


def commands(cmd: str):
    """Each simple command's program (its basename) and arguments, in order."""
    for toks in segments(cmd):
        toks = [t for t in toks if t != "$"]
        while toks and (re.match(r"^[A-Za-z_]\w*=", toks[0]) or toks[0] in WRAPPERS):
            w = toks.pop(0)
            if w == "timeout" and toks:
                toks.pop(0)
        if toks:
            yield os.path.basename(toks[0]), toks[1:]


def git_verb(args: list[str]) -> tuple[str | None, list[str], str | None]:
    i, cdir = 0, None
    while i < len(args) and args[i].startswith("-"):
        if args[i] in ("-C", "-c") and i + 1 < len(args):
            cdir = args[i + 1] if args[i] == "-C" else cdir
            i += 2
        else:
            i += 1
    return (args[i], args[i + 1:], cdir) if i < len(args) else (None, [], cdir)


def git_writes(verb: str, rest: list[str]) -> bool:
    """Whether a git command changes a repository; log, diff, show, status, fetch, `branch -a` only read."""
    opts = {x.split("=", 1)[0] for x in rest if x.startswith("-")}
    pos = [x for x in rest if not x.startswith("-")]
    if verb == "branch":
        if opts & {"-d", "-D", "--delete", "-m", "-M", "--move", "-c", "-C", "--copy", "-f", "--force", "-u",
                   "--set-upstream-to", "--unset-upstream", "--edit-description", "-t", "--track"}:
            return True
        return bool(pos) and not opts & {"-a", "--all", "-r", "--remotes", "-l", "--list", "-v", "-vv", "--verbose",
                                         "--contains", "--no-contains", "--merged", "--no-merged", "--points-at"}
    if verb == "tag":
        return bool(pos) and not opts & {"-l", "--list", "-v", "--verify", "--contains", "--no-contains",
                                         "--points-at", "--merged", "--no-merged", "-n"}
    if verb == "worktree":
        return pos[:1] != ["list"]
    if verb == "submodule":
        return pos[:1] not in ([], ["status"], ["summary"])
    if verb == "stash":
        return pos[:1] not in (["list"], ["show"])
    if verb == "remote":
        return pos[:1] in (["add"], ["remove"], ["rm"], ["rename"], ["set-url"], ["set-head"], ["set-branches"],
                           ["prune"], ["update"])
    if verb == "config":
        return len(pos) >= 2 and not opts & {"--get", "--get-all", "--get-regexp", "-l", "--list"}
    return verb in GIT_WRITES


def remote_hosts(prog: str, args: list[str]) -> list[str]:
    """The hosts an ssh, sftp, scp or rsync command reaches, an `-o HostName=` among them."""
    targets = []
    for i, x in enumerate(args):
        opt = (args[i + 1] if i + 1 < len(args) else "") if x == "-o" else x[2:] if x.startswith("-o") else ""
        m = re.match(r"(?i)\s*hostname[=\s]+(\S+)", opt)
        if m:
            targets.append(m.group(1))
    if prog in ("ssh", "sftp", "mosh"):
        i = 0
        while i < len(args):
            if args[i].startswith("-"):
                i += 2 if len(args[i]) == 2 and args[i][1] in SSH_VALUE_OPTS else 1
                continue
            targets.append(args[i])
            break
    elif prog in ("scp", "rsync"):
        for x in args:
            m = re.match(r"([^@/:\[]+@)?(\[[^\]]+\]|[^:/\[]+):", x)  # [user@]host:path, [user@][fe80::1%en12]:path
            if m and not x.startswith(("-", ".")):
                targets.append(m.group(2))
    return [t.rsplit("@", 1)[-1].strip("[]") for t in targets]


def deck_names(branch: str) -> tuple[str, str]:
    return branch, f"{branch}-b"


def push_reason(rest: list[str], d: Path, branch: str) -> str | None:
    flags = [x for x in rest if x.startswith("-")]
    if any(f in ("--all", "--mirror", "--tags", "--follow-tags", "--prune") or f.startswith(("--delete", "-d"))
           for f in flags):
        return f"push only your branch {branch}: no --all, --mirror, --tags or --delete"
    refspecs = [x for x in rest if not x.startswith("-")][1:]
    current = git(d, "branch", "--show-current", check=False)
    for rs in refspecs or ["HEAD"]:
        src, _, dst = rs.lstrip("+").partition(":")
        dst = (dst or src).removeprefix("refs/heads/")
        if dst == "HEAD":
            dst = current
        if dst != branch:
            return f"you may push only your branch {branch} (this pushes {dst or 'a detached HEAD'})"
    return None


def host_flag(args: list[str]) -> str | None:
    """pi-qemu's --host: a real deck, whatever its name."""
    for i, x in enumerate(args):
        if x == "--host":
            return args[i + 1] if i + 1 < len(args) else ""
        if x.startswith("--host="):
            return x.split("=", 1)[1]
    return None


def real_deck_reason(host: str, reg: dict, flagged=False) -> str | None:
    """A minion reaches a real deck only through a lock of its own that names it (`crew lock`), by day or night; the
    bitch and the nightman never do. flagged: pi-qemu's --host, a real deck whatever its name."""
    if re.search(r"[$`]", host):
        return f"{host}: name the host itself, not a variable: the guard knows real decks by name"
    if not host:
        return "--host names no deck"
    names, held = host_names(host), locks()
    found = lock_on(names, held)
    if not (found or flagged or any(REAL_DECK.match(n) for n in names)):
        return None
    if reg["role"] != "minion":
        return f"{host} is a real deck: only a minion uses one, under the unit's lock"
    if found and found[1]["holder"] == reg.get("branch"):
        return None
    if found:
        return f"{host} is {lock_line(*found)}. One holder at a time: wait until it is free"
    mine = next((u for u, lk in held.items() if lk["holder"] == reg.get("branch")), None)
    named = units_named(names)
    if mine and named in ([], [mine]):
        return (f"{host} is a real deck your lock on {mine} does not name. If it is {mine}, `crew lock {mine} {host}` "
                "adds it; another unit needs a lock of its own")
    return (f"{host} is a real deck, and no lock of yours names it. By day, once Sam says go: "
            f"`crew lock {named[0] if named else 'UNIT'} {host}`; at night the nightman grants units, on Sam's go")


def bash_reason(cmd: str, reg: dict, cwd: str) -> str | None:
    role, mode, branch = reg["role"], reg["mode"], reg.get("branch")
    here = Path(cwd or ".")
    for prog, args in commands(cmd):
        if prog in ("cd", "pushd"):
            dest = next((x for x in args if not x.startswith("-")), None)
            if dest:
                dest = os.path.expanduser(dest)
                here = Path(dest) if os.path.isabs(dest) else here / dest
            continue
        if prog == "sudo":
            return "nothing the crew does on the Mac needs sudo"
        if prog in ("diskutil", "fdisk", "asr") or prog.startswith(("newfs", "mkfs")) or \
                (prog == "dd" and any(x.startswith("of=") for x in args)):
            return "Sam flashes and formats disks himself; never touch a disk"
        if prog in ("pkill", "killall"):
            return "never kill by name: other agents' qemu, docker and pi-qemu share this Mac; kill only PIDs you started"
        if prog == "docker" and (args[:1] == ["rmi"] or args[:2] == ["volume", "rm"] or "prune" in args[:2]):
            return "freeing Docker space is Sam's call: report it"
        if prog == "gh":
            return "use `crew gh ...`: it pins the usr-ein account and usr-ein/* repositories (plain gh may act as " \
                   "another account, or open a PR on upstream mixxxdj/mixxx)"
        if prog in ("ssh", "sftp", "mosh", "scp", "rsync"):
            for h in remote_hosts(prog, args):
                why = real_deck_reason(h, reg)
                if why:
                    return why
        if prog == "pi-qemu":
            if args[:2] in (["deck", "golden"], ["image", "build"]):
                return "that rebuilds the golden card everyone's decks start from: Sam's call"
            host = host_flag(args)
            why = real_deck_reason(host, reg, flagged=True) if host is not None else None
            if why:
                return why
            if args[:1] == ["deck"] and len(args) > 2 and not args[2].startswith("-"):
                verb, name = args[1], args[2]
                if role == "minion" and verb in ("up", "rm", "stop", "kill") and name not in deck_names(branch):
                    return f"your decks are {branch} and {branch}-b; never touch another's"
                if role == "bitch" and verb not in ("list", "status", "shot", "leds", "where"):
                    return "the bitch only looks at decks (list, status, shot, leds)"
                if role == "nightman" and verb in ("up", "deploy"):
                    return "minions run decks; the nightman only stops or removes them to shed load"
        if prog == "claude":
            launches = {"--bg", "-p", "--print", "-r", "--resume", "-c", "--continue", "attach", "rm", "stop",
                        "kill", "respawn", "-w", "--worktree", "--from-pr"}
            if role != "nightman" and launches.intersection(args):
                return f"a {role} is a single agent: only the nightman (or Sam) starts and stops sessions"
        if prog == "crew":
            sub = args[:1]
            if sub in (["minion"], ["bitch"], ["resume"], ["send"]) and role != "nightman":
                return f"a {role} does not start sessions"
            if sub in (["merge"], ["clean"]) and not (role == "nightman" or (role == "bitch" and mode == "day")):
                return "merges are the nightman's at night, and the bitch's after Sam's yes in the day"
        if prog == "git":
            verb, rest, cdir = git_verb(args)
            if verb is None:
                continue
            d = here
            if cdir:
                cdir = os.path.expanduser(cdir)
                d = Path(cdir) if os.path.isabs(cdir) else here / cdir
            writes = git_writes(verb, rest)
            if role == "bitch" and writes:
                return "the bitch is read-only: no git writes"
            if role == "nightman" and writes:
                return "the nightman does not write to git itself: `crew merge` and `crew clean` do"
            if role == "minion":
                why = push_reason(rest, d, branch) if verb == "push" else None
                if why:
                    return why
                if writes and verb != "push" and under(d, MAIN) and not under(d, MAIN / ".claude" / "worktrees"):
                    return f"that is the main checkout: work in your worktree {reg['worktree']}"
    return None


def hook_guard(data: dict, reg: dict):
    tool, ti = data.get("tool_name"), data.get("tool_input") or {}
    reason = None
    if tool == "Bash":
        reason = bash_reason(ti.get("command", ""), reg, data.get("cwd") or os.getcwd())
    elif tool in ("Edit", "Write", "MultiEdit", "NotebookEdit"):
        reason = write_reason(ti.get("file_path") or ti.get("notebook_path") or "", reg)
    if reason:
        return {"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "deny",
                                       "permissionDecisionReason": f"crew guard ({reg['role']}, {reg['mode']}): {reason}."}}
    return None


def hook_drift(data: dict, reg: dict):
    if reg["role"] != "minion":
        return None
    lim, path = limits(), CREW / "drift" / f"{reg['sid']}.json"
    path.parent.mkdir(exist_ok=True)
    try:
        st = json.loads(path.read_text())
    except (OSError, ValueError):
        st = {"calls": 0, "last": time.time()}
    st["calls"] += 1
    mins = (time.time() - st["last"]) / 60
    if st["calls"] < lim["DRIFT_EVERY_CALLS"] and not (mins >= lim["DRIFT_EVERY_MIN"] and st["calls"] >= 3):
        path.write_text(json.dumps(st))
        return None
    path.write_text(json.dumps({"calls": 0, "last": time.time()}))
    wt, b = Path(reg["worktree"]), reg["branch"]
    try:
        title = (wt / ".crew" / "pitch.md").read_text().strip().splitlines()[0].lstrip("# ")
    except (OSError, IndexError):
        title = "(no .crew/pitch.md yet: write it first)"
    areas = []
    for path_, _ in REPOS:
        d = wt / path_
        if (d / ".git").exists() and tip(d, f"refs/heads/{b}"):
            stat = git(d, "diff", "--shortstat", f"main...{b}", check=False)
            if stat:
                areas.append(f"{path_}: {stat}")
    dirty = len(git(wt, "status", "--porcelain", "--ignore-submodules=dirty", check=False).splitlines())
    text = (
        f"Crew drift check ({mins:.0f} min, {st['calls']} tool calls since the last). Pause before your next step.\n"
        f"1. Your pitch: \"{title}\" ({wt}/.crew/pitch.md). Re-read it if it has been a while.\n"
        f"2. Your branch so far: {'; '.join(areas) or 'no commits yet'}; {dirty} uncommitted path(s). "
        f"Last status: \"{notes_status(wt) or 'none written'}\".\n"
        "3. Answer for yourself, in a line each: what am I doing right now, and which part of the pitch does it "
        "serve? Is anything in the diff outside the pitch? Have I been stuck on one problem for more than ~45 min?\n"
        "4. Drifted: stop, write the detour under Follow-ups in .crew/notes.md, return to the pitch. Stuck: change "
        "approach, or escalate (day: ask Sam; night: message the nightman). On track: carry on.\n"
        "5. Update the Status line of .crew/notes.md (one line, with the time)."
    )
    return {"hookSpecificOutput": {"hookEventName": "PostToolUse", "additionalContext": text}}


def hook_session(data: dict, reg: dict):
    hso = {"hookEventName": "SessionStart", "sessionTitle": session_name(reg)}
    if data.get("source") in ("resume", "compact"):
        where = f"{CREW}/night/plan.md" if reg["role"] == "nightman" else \
            f"{reg['worktree']}/.crew/pitch.md and notes.md"
        skill = MAIN / ".claude" / "skills" / reg["role"] / "SKILL.md"
        hso["additionalContext"] = (
            f"Crew: this session is the {reg['role']}" + (f" for {reg['branch']}" if reg.get("branch") else "") +
            f", in {reg['mode']} mode. Before going on, re-read {skill} (the main checkout's copy is the "
            f"current one) and {where}.")
    return {"hookSpecificOutput": hso}


def hook_prompt(data: dict, reg: dict):
    return {"hookSpecificOutput": {"hookEventName": "UserPromptSubmit", "sessionTitle": session_name(reg)}}


HOOKS = {"guard": hook_guard, "drift": hook_drift, "session": hook_session, "prompt": hook_prompt}


def cmd_hook(a) -> int:
    """Runs on every hook of every session in the project: silent and quick unless the session is crew."""
    try:
        data = json.loads(_HOOK_INPUT if _HOOK_INPUT is not None else sys.stdin.read())
        reg = registration(data.get("session_id"))
        role, wt = os.environ.get("CREW_ROLE"), os.environ.get("CREW_WORKTREE")
        # The role crew launched the session with, if it starts where crew launched it: Claude's daemon hands the
        # environment of the launch that started it to every background session after it, wherever they start.
        if not reg and a.kind == "session" and role in ROLES and wt and data.get("session_id") and \
                os.path.realpath(data.get("cwd") or ".") == os.path.realpath(wt):
            reg = register_session(data["session_id"], role, os.environ.get("CREW_MODE", "day"),
                                   os.environ.get("CREW_BRANCH") or None, Path(wt))
        if reg:
            result = HOOKS[a.kind](data, reg)
            if result:
                print(json.dumps(result))
    except Exception as e:  # a crew bug must never block or break a session
        print(f"crew hook {a.kind}: {e}", file=sys.stderr)
    return 0


def cmd_feedback(a) -> int:
    log = CREW / "feedback.md"
    if not a.text:
        print(log.read_text() if log.exists() else "no feedback yet")
        return 0
    reg = registration(os.environ.get("CLAUDE_CODE_SESSION_ID"))
    who = f"{session_name(reg)} ({reg['role']}, {reg['mode']})" if reg else \
        ("a session" if os.environ.get("CLAUDE_CODE_SESSION_ID") else "Sam")
    CREW.mkdir(parents=True, exist_ok=True)
    if not log.exists():
        log.write_text("# Crew feedback\n\nWhere the crew's rules or tools got in the way. `/crew-tune` works from it.\n\n")
    with log.open("a") as f:
        f.write(f"- {now_iso()} {who}: {' '.join(a.text)}\n")
    print(f"noted in {log}")
    return 0


def cmd_root(a) -> int:
    print(MAIN)
    return 0


def cmd_install(a) -> int:
    link = Path.home() / ".local" / "bin" / "crew"
    target = MAIN / ".claude" / "crew" / "crew"
    link.parent.mkdir(parents=True, exist_ok=True)
    if link.is_symlink() or link.exists():
        link.unlink()
    link.symlink_to(target)
    print(f"{link} -> {target}")
    return 0


# --- command line -------------------------------------------------------------

def main(argv=None) -> int:
    p = argparse.ArgumentParser(prog="crew", description=__doc__.strip().splitlines()[0],
                                epilog="How it fits together: .claude/crew/README.md")
    sub = p.add_subparsers(dest="cmd", metavar="VERB", required=True)

    s = sub.add_parser("minion", help="start (or resume) the minion for a branch: worktree, submodules, session")
    s.add_argument("branch")
    s.add_argument("text", nargs="*", help="the pitch, in Sam's words (day mode)")
    s.add_argument("--pitch", help="a pitch file to use as .crew/pitch.md (the nightman's)")
    s.add_argument("--night", action="store_true", help="started by the nightman: background, Sam asleep")
    s.add_argument("--bg", action="store_true", help="day mode, but in the background (`claude agents` to watch)")
    s.add_argument("--resume", action="store_true", help="resume the branch's last minion session")
    s.add_argument("--no-launch", action="store_true", help="only make the worktree")
    s.add_argument("--force", action="store_true", help="dispatch even when resources say hold")
    s.add_argument("--prompt", help="the session's first prompt instead of /minion")
    s.add_argument("--model", help=argparse.SUPPRESS)
    s.set_defaults(fn=cmd_minion)

    s = sub.add_parser("bitch", help="start (or resume) the reviewer of a branch's PR, in its worktree")
    s.add_argument("branch")
    s.add_argument("--night", action="store_true")
    s.add_argument("--bg", action="store_true")
    s.add_argument("--resume", action="store_true")
    s.add_argument("--brief", help="the nightman's review brief, copied to .crew/review-brief.md")
    s.add_argument("--prompt")
    s.add_argument("--model", help=argparse.SUPPRESS)
    s.set_defaults(fn=cmd_bitch)

    s = sub.add_parser("resume", help="wake a stopped crew session (BRANCH, BRANCH-bitch, nightman) in the background")
    s.add_argument("name")
    s.add_argument("--prompt")
    s.add_argument("--model", help=argparse.SUPPRESS)
    s.set_defaults(fn=cmd_resume)

    s = sub.add_parser("send", help="a message for a crew session: resumes it with it if it has ended; a running one "
                                    "only through SendMessage (exit 10)")
    s.add_argument("name")
    s.add_argument("text", nargs="+")
    s.set_defaults(fn=cmd_send)

    s = sub.add_parser("register", help="(from a session) record this session's crew role, for the hooks")
    s.add_argument("role", choices=ROLES)
    s.add_argument("--mode", choices=("day", "night"), default="day")
    s.add_argument("--branch")
    s.set_defaults(fn=cmd_register)

    s = sub.add_parser("status", help="every crew branch: sessions, PR, review state, decks; and the load")
    s.set_defaults(fn=cmd_status)

    s = sub.add_parser("resources", help="the Mac's load against limits.env: ok (0), hold (10) or shed (11)")
    s.add_argument("--for", dest="purpose", choices=("minion", "deck", "build"), default="minion")
    s.add_argument("--json", action="store_true")
    s.set_defaults(fn=cmd_resources)

    s = sub.add_parser("preflight", help="is the Mac ready to be left alone tonight?")
    s.add_argument("--keep-awake", type=int, metavar="PID", help="hold the Mac awake while PID lives")
    s.set_defaults(fn=cmd_preflight)

    sub.add_parser("gh", help="gh as usr-ein, on usr-ein/* repositories only (crew gh ARGS...)")

    s = sub.add_parser("pr", help="a branch's PRs in every repo, with labels and AI review rounds")
    s.add_argument("branch")
    s.add_argument("--json", action="store_true")
    s.set_defaults(fn=cmd_pr)

    s = sub.add_parser("label", help="set the review state of a branch's TriMixxx PR")
    s.add_argument("branch")
    s.add_argument("state", choices=list(STATES))
    s.set_defaults(fn=cmd_label)

    s = sub.add_parser("review", help="post the bitch's review on a branch's PR, and set its state")
    s.add_argument("branch")
    s.add_argument("verdict", choices=("approved", "changes", "needs-sam"))
    s.add_argument("--commit", required=True, help="the commit you reviewed (git rev-parse BRANCH when you began)")
    s.add_argument("--body-file", required=True)
    s.add_argument("--comments", help="JSON list of {path, line, body} for inline comments")
    s.add_argument("--repo", choices=list(REPO_KEYS), default="trimixxx", help="a companion PR instead")
    s.set_defaults(fn=cmd_review)

    s = sub.add_parser("merge", help="fast-forward a branch into main, deepest repo first, and push")
    s.add_argument("branch")
    s.add_argument("--dry-run", action="store_true")
    s.set_defaults(fn=cmd_merge)

    s = sub.add_parser("clean", help="after a merge: stop its sessions and decks, drop its worktree and branches, "
                                     "free its real decks")
    s.add_argument("branch")
    s.add_argument("--abandon", action="store_true", help="unmerged: stop sessions and decks, keep the rest")
    s.set_defaults(fn=cmd_clean)

    s = sub.add_parser("lock", help="hold a real deck, one holder per unit: UNIT, then the ssh aliases and addresses "
                                    "it is reached by (no UNIT: the locks)")
    s.add_argument("unit", nargs="?", help="trimixxx1, trimixxx2, ...")
    s.add_argument("names", nargs="*", help="e.g. trimixxx-pi 169.254.232.146")
    s.add_argument("--for", dest="holder", help="the minion's BRANCH it is granted to (the nightman), or Sam")
    s.add_argument("--why", help="what it is for: Sam's go, in his words")
    s.set_defaults(fn=cmd_lock)

    s = sub.add_parser("unlock", help="free a real deck: its holder, the nightman or Sam")
    s.add_argument("unit")
    s.set_defaults(fn=cmd_unlock)

    s = sub.add_parser("hook", help="(Claude Code hooks) guard, drift, session, prompt")
    s.add_argument("kind", choices=list(HOOKS))
    s.set_defaults(fn=cmd_hook)

    s = sub.add_parser("feedback", help="log where the crew's rules or tools got in the way (no text: show the log)")
    s.add_argument("text", nargs="*")
    s.set_defaults(fn=cmd_feedback)

    s = sub.add_parser("root", help="the main checkout's path: where the crew's current files are")
    s.set_defaults(fn=cmd_root)

    s = sub.add_parser("install", help="link this tool as ~/.local/bin/crew (the main checkout's copy)")
    s.set_defaults(fn=cmd_install)

    argv = sys.argv[1:] if argv is None else argv
    if argv[:1] == ["gh"]:
        try:
            return cmd_gh(argv[1:])
        except Fail as e:
            print(f"crew gh: {e}", file=sys.stderr)
            return e.code
    a, extra = p.parse_known_args(argv)
    if extra and a.cmd == "lock" and a.unit and not any(x.startswith("-") for x in extra):
        a.names += extra  # `crew lock UNIT --for BRANCH ADDR...`: names after the options too
    elif extra:
        p.error(f"unrecognized arguments: {' '.join(extra)}")
    try:
        return a.fn(a)
    except Fail as e:
        print(f"crew {a.cmd}: {e}", file=sys.stderr)
        return e.code


if __name__ == "__main__":
    sys.exit(main())
