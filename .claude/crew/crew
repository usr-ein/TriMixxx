def cmd_preflight(a) -> int:
    bad, warn = [], []

    def check(ok: bool, good: str, fix: str, soft=False):
        print(("  ok   " if ok else ("  warn " if soft else "  FAIL ")) + (good if ok else fix))
        if not ok:
            (warn if soft else bad).append(fix)

    print("Mac")
    batt = out(["pmset", "-g", "batt"], check=False)
    check("AC Power" in batt, "on mains power", "on battery: plug the charger in (caffeinate cannot hold a Mac awake on battery)")
    if a.keep_awake:
        pid = str(a.keep_awake)
        mine = run(["pgrep", "-f", f"caffeinate -i -s -m -w {pid}"], check=False).returncode == 0
        if not mine:
            subprocess.Popen(["caffeinate", "-i", "-s", "-m", "-w", pid], start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        print(f"  ok   kept awake while process {pid} lives (caffeinate); the lid must stay open")
    key = Path.home() / ".ssh" / "with_pass" / "rsa_sam.pub"
    fp = out(["ssh-keygen", "-lf", key], check=False).split()[1:2]
    agent = out(["ssh-add", "-l"], check=False)
    check(bool(fp) and fp[0] in agent, "ssh agent holds with_pass/rsa_sam (decks, commit signing, pushes)",
          "ssh agent lacks with_pass/rsa_sam: run `! ssh-add --apple-use-keychain ~/.ssh/with_pass/rsa_sam`")
    gh_login = gh(["api", "user", "--jq", ".login"], check=False).stdout.strip()
    check(gh_login == GH_USER, f"gh acts as {GH_USER} through crew gh", f"crew gh acts as {gh_login or 'nobody'}, not {GH_USER}")
    r = run(["ssh", "-T", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", "git@github.com-usr-ein"], check=False, timeout=30)
    check(f"Hi {GH_USER}" in r.stderr + r.stdout, "GitHub accepts pushes as usr-ein", "ssh to github.com-usr-ein fails: pushes will too")
    r = run(["docker", "info", "--format", "{{.ServerVersion}}"], check=False, timeout=30)
    check(r.returncode == 0, "Docker is up (Mixxx builds)", "Docker is not running: start Docker Desktop")
    mode = None
    for f in (Path.home() / ".claude" / "settings.json", MAIN / ".claude" / "settings.json",
              MAIN / ".claude" / "settings.local.json"):  # the later wins
        try:
            mode = json.loads(f.read_text()).get("permissions", {}).get("defaultMode") or mode
        except (OSError, ValueError):
            pass
    check(mode == "bypassPermissions", "sessions start in bypass mode: no permission prompt can stall a minion",
          f"sessions start in {mode or 'default'} mode: a background minion would wait all night on its first "
          "permission prompt, and messages between sessions in different modes are held. Set "
          "permissions.defaultMode to bypassPermissions in ~/.claude/settings.json")

    print("Repositories (main vs origin/main)")
    for path, repo in REPOS:
        d = MAIN / path
        if not (d / ".git").exists():
            continue
        run(["git", "-C", d, "fetch", "--quiet", "origin"], check=False, timeout=120)
        ahead = int(git(d, "rev-list", "--count", "origin/main..main", check=False) or 0)
        behind = int(git(d, "rev-list", "--count", "main..origin/main", check=False) or 0)
        check(ahead == 0, f"{path}: main is pushed" + (f" ({behind} behind: crew merge catches up)" if behind else ""),
              f"{path}: main has {ahead} commit(s) not on origin. Push them before the night, or every crew PR on "
              f"{repo} carries them and no merge goes through")
        dirty = git(d, "status", "--porcelain", "--untracked-files=no", "--ignore-submodules=all", check=False)
        check(not dirty, f"{path}: no uncommitted changes to tracked files",
              f"{path}: uncommitted changes in the main checkout; a merge that touches them stops", soft=True)

    print("Load")
    lim, snap = limits(), snapshot()
    print(f"  {describe(snap, lim)}")
    docker, least = snap.get("docker_gb"), lim.get("DOCKER_MIN_GB", 8)
    if docker is not None:
        check(docker >= least, f"Docker's VM has {docker:.1f} GB free for builds",
              f"Docker's VM has {docker:.1f} GB free, under {least:.0f}: Mixxx builds would fail tonight. Freeing it "
              "is Sam's call (which build cache to prune)")
    v, why = verdict(snap, lim, "minion")
    check(v == "ok", "room to dispatch a minion now", f"no room to dispatch yet ({'; '.join(why)})", soft=True)
    others = [s for s in snap["sessions"] if s.get("status") == "busy" and s.get("name") not in ("nightman",)]
    if others:
        print("  note other busy Claude sessions share this Mac: " + ", ".join(str(s.get("name")) for s in others))
    if bad:
        print(f"\n{len(bad)} to fix before the night.")
    return 1 if bad else 0


# --- merge and clean ------------------------------------------------------------

def tip(d: Path, ref: str) -> str | None:
    r = run(["git", "-C", d, "rev-parse", "--verify", "-q", ref + "^{commit}"], check=False)
    return r.stdout.strip() or None


def change_id(d: Path, t: str) -> str:
    """What a commit changes against main, as a patch id: the same after a clean rebase, different otherwise.
    Submodule pointers are left out: each submodule's own change is compared in its repo."""
    base = git(d, "merge-base", "refs/remotes/origin/main", t)
    diff = run(["git", "-C", d, "diff", "--no-color", "--ignore-submodules=all", base, t]).stdout
    return (run(["git", "patch-id", "--stable"], input=diff).stdout.split() or ["-"])[0]


def approved_tips(approved: str) -> dict:
    """Each repo's commit as the approved TriMixxx commit records it."""
    res = {".": approved}
    for child in ("mixxx", "mixxx_config/ttymidi", "mixxx/lib/prolink"):  # parents before their children
        parent, sub = GITLINKS[child]
        if res.get(parent) and (MAIN / child / ".git").exists():
            res[child] = git(MAIN / parent, "rev-parse", f"{res[parent]}:{sub}", check=False) or None
    return res


def cmd_merge(a) -> int:
    b = a.branch
    prs = find_prs(b)
    pr = primary_pr(b, prs)
    n = pr["number"]
    if pr["state"] != "OPEN":
        die(f"PR #{n} is {pr['state'].lower()}", 2)
    if pr["isDraft"]:
        die(f"PR #{n} is a draft", 2)
    if "review:needs-sam" in pr["labels"]:
        die(f"PR #{n} waits for Sam (review:needs-sam)", 2)
    if FOR_SAM.search(pr.get("body") or ""):
        die(f"PR #{n} still lists decisions taken for Sam ([for Sam]): they wait for him. Once he answers, "
            "its body records each as [Sam]", 2)
    if "review:approved" not in pr["labels"]:
        die(f"PR #{n} is not approved (labels: {', '.join(pr['labels']) or 'none'})", 2)
    approved = approved_commit(pr)
    if not approved:
        die(f"PR #{n}: its last AI review is not an approval", 2)

    involved = []
    for path, repo in REPOS:
        d = MAIN / path
        if not (d / ".git").exists():
            continue
        run(["git", "-C", d, "fetch", "--quiet", "origin"], timeout=180)
        if tip(d, f"refs/heads/{b}") or tip(d, f"refs/remotes/origin/{b}"):
            involved.append((path, repo, d))
    if not any(p == "." for p, _, _ in involved):
        die(f"{b} has no branch in TriMixxx itself", 2)

    # Each repo's main must be what origin has: never publish someone's unpushed commits.
    for path, repo, d in [(p, r, MAIN / p) for p, r in REPOS if (MAIN / p / ".git").exists()]:
        ahead = int(git(d, "rev-list", "--count", "origin/main..main"))
        if ahead:
            die(f"{path}: main has {ahead} commit(s) that origin lacks (Sam's unpushed work?). "
                "Nothing merged; Sam decides whether to push them", 4)

    plan = []
    for path, repo, d in involved:
        local, remote = tip(d, f"refs/heads/{b}"), tip(d, f"refs/remotes/origin/{b}")
        if remote is None or (local and local != remote):
            die(f"{path}: {b} is not pushed as it is locally (local {str(local)[:7]}, origin {str(remote)[:7]})", 2)
        main_tip = tip(d, "refs/remotes/origin/main")
        if main_tip == remote or git_ok(d, "merge-base", "--is-ancestor", remote, main_tip):
            plan.append((path, repo, d, remote, "merged"))
            continue
        if not git_ok(d, "merge-base", "--is-ancestor", main_tip, remote):
            die(f"{path}: {b} is not on top of main any more: the minion must rebase it (deepest repo first), "
                "re-point the submodules, retest and push", 3)
        plan.append((path, repo, d, remote, "merge"))
    tips = {p: t for p, _, _, t, _ in plan}

    # Every submodule pointer the branch changes lands on that submodule's main with it.
    for child, (parent, sub) in GITLINKS.items():
        pdir, cdir = MAIN / parent, MAIN / child
        if not (pdir / ".git").exists() or not (cdir / ".git").exists():
            continue
        ptip = tips.get(parent) or tip(pdir, "refs/remotes/origin/main")
        new = git(pdir, "rev-parse", f"{ptip}:{sub}", check=False)
        old = git(pdir, "rev-parse", f"refs/remotes/origin/main:{sub}", check=False)
        if child in tips:
            if new != tips[child]:
                die(f"{parent} on {b} points {sub} at {new[:7]}, but {child}'s {b} is {tips[child][:7]}: "
                    "the minion must commit the submodule bump", 2)
        elif new != old and not git_ok(cdir, "merge-base", "--is-ancestor", new, "refs/remotes/origin/main"):
            die(f"{parent} on {b} points {sub} at {new[:7]}, which is not on {child}'s main and is on no {b} "
                f"branch there: its commits must be on a branch named {b} in {child}, pushed and reviewed", 2)

    # What lands is what the bitch approved: its very commits, or the same change rebased onto a newer main.
    if tips["."] != approved:
        if not tip(MAIN, approved):
            run(["git", "-C", MAIN, "fetch", "--quiet", "origin", approved], check=False, timeout=180)
        if not tip(MAIN, approved):
            die(f"PR #{n}: the approved commit {approved[:7]} is gone, so its current head needs a review", 2)
        was = approved_tips(approved)
        for path, repo, d, t, what in plan:
            ok = was.get(path) == t or (was.get(path) and tip(d, was[path]) and
                                         change_id(d, was[path]) == change_id(d, t))
            if not ok:
                die(f"{path}: {b} has changed since the bitch approved {approved[:7]}, beyond a clean rebase: "
                    "it needs another review round", 2)

    for path, repo, d, t, what in plan:
        print(f"{path:22} {what:7} {t[:7]}  {repo}")
    if a.dry_run:
        return 0

    old_links = {child: git(MAIN / parent, "rev-parse", f"HEAD:{sub}", check=False)
                 for child, (parent, sub) in GITLINKS.items() if (MAIN / child / ".git").exists()}
    for path, repo, d, t, what in plan:
        if what == "merged":
            continue
        head = git(d, "symbolic-ref", "-q", "HEAD", check=False)
        if git(d, "rev-parse", "main") != tip(d, "refs/remotes/origin/main"):
            run(["git", "-C", d, "fetch", ".", "refs/remotes/origin/main:refs/heads/main"] if head != "refs/heads/main"
                else ["git", "-C", d, "merge", "--ff-only", "--quiet", "origin/main"])
        if head == "refs/heads/main":
            run(["git", "-C", d, "merge", "--ff-only", "--quiet", t])
        else:
            run(["git", "-C", d, "fetch", ".", f"{t}:refs/heads/main"])
        r = run(["git", "-C", d, "push", "origin", "main"], check=False, timeout=300)
        if r.returncode:
            die(f"{path}: push of main failed, so the merge stops here (deeper repos are pushed):\n{r.stderr.strip()}", 5)
        print(f"{path}: main is {t[:7]}, pushed")

    # A detached submodule in the main checkout follows main's pointer, if it was where main pointed before.
    for child, (parent, sub) in GITLINKS.items():
        d = MAIN / child
        if not (d / ".git").exists():
            continue
        want, now = git(MAIN / parent, "rev-parse", f"HEAD:{sub}", check=False), git(d, "rev-parse", "HEAD")
        if not want or now == want:
            continue
        detached = not git(d, "symbolic-ref", "-q", "HEAD", check=False)
        if detached and now == old_links.get(child) and not git(d, "status", "--porcelain", "--untracked-files=no"):
            run(["git", "-C", d, "checkout", "--quiet", "--detach", want])
        else:
            print(f"note: {child} in the main checkout is at {now[:7]}, not at {want[:7]} as main records; left as it is")

    for path, repo, d, t, what in plan:
        p = prs.get(path)
        if not p:
            continue
        for _ in range(10):
            state = gh_json(["pr", "view", str(p["number"]), "--repo", repo, "--json", "state"])["state"]
            if state == "MERGED":
                break
            time.sleep(3)
        print(f"{repo}#{p['number']}: {state.lower()}")
    return 0


def cmd_clean(a) -> int:
    b = a.branch
    wt = worktree_of(b)
    for path, repo in REPOS:
        d = MAIN / path
        t = tip(d, f"refs/heads/{b}") if (d / ".git").exists() else None
        if t and not a.abandon and not git_ok(d, "merge-base", "--is-ancestor", t, "main"):
            die(f"{path}: {b} has commits main lacks; nothing cleaned (`--abandon` stops its sessions and decks only)", 2)

    me = os.environ.get("CLAUDE_CODE_SESSION_ID")
    blocking = []
    for s in claude_sessions():
        if s.get("name") in (b, f"{b}-bitch") and s.get("sessionId") != me:
            if s.get("kind") == "background":
                run(["claude", "stop", s.get("id") or s["sessionId"]], check=False, timeout=60)
                print(f"stopped {s.get('name')}")
            else:
                blocking.append(s.get("name"))
    for name, state in decks():
        if name in deck_names(b):
            run(["pi-qemu", "deck", "rm", name], check=False, timeout=180)
            print(f"removed deck {name}")
    if a.abandon:
        for u, lk in locks().items():
            if lk["holder"] == b:
                print(f"{b} still holds {u}, which may be mid-check: `crew unlock {u}` once its state is known")
        print(f"{b}: sessions and decks stopped; worktree, branches and locks kept")
        return 0
    if blocking:
        die(f"{', '.join(blocking)} still open in a terminal: exit it, then `crew clean {b}` again", 2)

    if (wt / ".crew").is_dir():
        dest = CREW / "archive" / f"{b}-{dt.date.today().isoformat()}"
        shutil.copytree(wt / ".crew", dest, dirs_exist_ok=True)
        shutil.rmtree(wt / ".crew")  # archived; git may not ignore it in a worktree older than the crew
        print(f"kept its pitch and notes in {dest}")
    if wt.exists():
        r = run(["pi-qemu", "worktree", "release"], cwd=wt, check=False, timeout=600)
        if r.returncode:
            die(f"pi-qemu worktree release refused: {(r.stderr or r.stdout).strip()[-600:]}", 2)
        run(["git", "-C", MAIN, "worktree", "remove", wt])
        print(f"removed worktree {wt}")
    for path, repo in REPOS:
        d = MAIN / path
        if not (d / ".git").exists():
            continue
        if tip(d, f"refs/heads/{b}"):
            git(d, "branch", "-d", b, check=False)
        if tip(d, f"refs/remotes/origin/{b}"):
            run(["git", "-C", d, "push", "--quiet", "origin", "--delete", b], check=False, timeout=120)
            print(f"{path}: deleted {b} on origin")
    for reg in registrations():
        if reg.get("branch") == b:
            (CREW / "sessions" / f"{reg['sid']}.json").unlink(missing_ok=True)
            (CREW / "drift" / f"{reg['sid']}.json").unlink(missing_ok=True)
    for u in release_locks(b):
        print(f"{u} is free (it was {b}'s)")
    return 0


# --- PRs and reviews --------------------------------------------------------------

def cmd_gh(argv: list[str]) -> int:
    """Every argument goes to gh untouched (argparse would eat a leading -R)."""
    if argv[:2] == ["pr", "merge"]:
        die("merges go through `crew merge` (fast-forward, deepest repo first)", 2)
    repo = None
    for i, x in enumerate(argv):
        if x in ("-R", "--repo") and i + 1 < len(argv):
            repo = argv[i + 1]
        elif x.startswith("--repo="):
            repo = x.split("=", 1)[1]
        m = re.match(r"/?repos/([^/]+)/", x)
        if m and m.group(1).lower() != GH_USER.lower():
            die(f"{x} is not a {GH_USER} repository", 2)
    repo = repo or repo_of(Path.cwd())
    if not repo or repo.split("/")[0].lower() != GH_USER.lower():
        die(f"{repo or 'this directory'} is not a {GH_USER} repository (pass -R {GH_USER}/REPO); "
            "never upstream mixxxdj/mixxx", 2)
    os.execvpe("gh", ["gh", *argv], gh_env(repo))


def cmd_pr(a) -> int:
    prs = find_prs(a.branch)
    if a.json:
        if "." in prs:
            prs["."]["rounds"] = review_rounds(prs["."])
        print(json.dumps(prs, indent=2))
        return 0
    if not prs:
        print(f"{a.branch}: no PRs")
    for path, p in prs.items():
        extra = f", {review_rounds(p)} AI review(s)" if path == "." else ""
        print(f"{p['repo']}#{p['number']} {p['state'].lower()}{' draft' if p['isDraft'] else ''}"
              f" [{', '.join(p['labels']) or 'no labels'}{extra}] {p['url']}")
    return 0


def cmd_label(a) -> int:
    if a.state == "approved":
        die("review:approved comes only with an approving review, which records the commit approved: "
            "`crew review BRANCH approved --commit SHA ...` (Sam's yes too, quoting him)", 2)
    pr = set_state(a.branch, a.state)
    print(f"{pr['repo']}#{pr['number']}: review:{a.state}")
    return 0


def cmd_review(a) -> int:
    b = a.branch
    prs = find_prs(b)
    pr = prs.get(REPO_KEYS[a.repo])
    if not pr or pr["state"] != "OPEN":
        die(f"{b} has no open PR on {dict(REPOS)[REPO_KEYS[a.repo]]}", 2)
    if pr["headRefOid"] != a.commit:
        die(f"{pr['repo']}#{pr['number']} is at {pr['headRefOid'][:7]} now, not {a.commit[:7]} as you reviewed it: "
            "review what was pushed since, then post", 2)
    body = Path(a.body_file).read_text().strip()
    primary = a.repo == "trimixxx"
    if primary:
        n = review_rounds(pr) + 1
        body = f"{REVIEW_MARK} · round {n} · verdict: {STATES[a.verdict]}**\n\n{body}"
    else:
        body = f"{REVIEW_MARK} of the {a.repo} side, for {primary_pr(b, prs)['url']}**\n\n{body}"
    payload = {"event": "COMMENT", "body": body, "commit_id": a.commit}
    if a.comments:
        payload["comments"] = [{"path": c["path"], "line": int(c["line"]), "side": "RIGHT", "body": c["body"]}
                               for c in json.loads(Path(a.comments).read_text())]
    r = gh(["api", "-X", "POST", f"repos/{pr['repo']}/pulls/{pr['number']}/reviews", "--input", "-"],
           input=json.dumps(payload))
    url = json.loads(r.stdout).get("html_url")
    if primary:
        set_state(b, a.verdict, prs)
    print(f"posted: {url}" + (f" (review:{a.verdict})" if primary else ""))
    return 0


