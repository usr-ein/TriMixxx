	(text "TODO: Is the optical enc\nable to take \nin/output 3.3V, \nor only 5V?"
		(exclude_from_sim no)
		(at 199.898 105.918 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "5ccece00-cb72-4538-8895-e665a89c490b")
	)
	(text "The OneButton's CH32V003 has \nLVTTL for pin voltage detection,\nso it can read 3.3V in.\nV_IH min is 2.06V when powered by 5V\nV_IL max is 1.09 V (low side)\nWe're good sending it 3.3V TX, with margins"
		(exclude_from_sim no)
		(at 246.38 84.074 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "61e014a8-f7a2-47f2-a998-9d9aa226d0cb")
	)
	(text "This comes back from the \nOneButton boards as 5V,\nand would fry the S3 so \nI have a divider down to 3.24V"
		(exclude_from_sim no)
		(at 258.572 49.53 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "78311c2a-5cf4-4282-9593-a4eb2e1fcaf8")
	)
	(text "Pi's layout is:\nFunction : GND | TX | RX\nGPIO     : 8   | 10 | 12\nPi sends in 3.3V and \nreceives ONLY 3.3V, \nso we natively good"
		(exclude_from_sim no)
		(at 186.182 19.558 0)
		(effects
			(font
				(face "JetBrainsMono NF")
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "c6f760c8-2acb-476d-9eaa-56ad4ab35274")
	)
