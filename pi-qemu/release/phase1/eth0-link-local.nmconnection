# eth0, cabled straight to the Mac (pi-qemu/PLAN.md §2.2): link-local only, as
# on the decks' eth0 (pi_config/prolink-eth0.sh), in IPv4 (169.254/16) and
# IPv6. avahi announces trimixxx3.local on both.
#
# A keyfile in /etc/NetworkManager rather than a cloud-init network-config:
# Pi OS's NetworkManager rewrites netplan's eth0 profile into one that matches
# every NIC (/etc/netplan/90-NM-*.yaml, `match: {}`). Other Ethernet NICs, such
# as pi-qemu's management NIC, keep NetworkManager's default: DHCP.
[connection]
id=eth0-link-local
type=ethernet
interface-name=eth0

[ipv4]
method=link-local

[ipv6]
method=link-local
addr-gen-mode=eui64
