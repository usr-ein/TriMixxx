# The deck's own hotspot when it has no other network (pi_config/wifi-fallback),
# as deploy step 002_system makes it on a dev deck. `pi-qemu release card`
# writes it into each deck's /data: its SSID is the deck's name, its channel the
# deck's own (hotspotChannel in mixxx_config/units/<deck>.json, else 6), its
# password pi_config/wifi-fallback/hotspot.env's.
[connection]
id=trimixxx-hotspot
type=wifi
interface-name=wlan0
autoconnect=false

[wifi]
mode=ap
ssid=@DECK@
band=bg
channel=@CHANNEL@

[wifi-security]
key-mgmt=wpa-psk
proto=rsn;
pairwise=ccmp;
group=ccmp;
psk=@PSK@

[ipv4]
method=shared
address1=10.42.0.1/24

[ipv6]
method=disabled
