# Copy to secrets.env (gitignored) and fill in. image/build.sh reads it, and
# so does the release's `make card` (pi-qemu/release).
#
# The console password for sam1902 (tty2 with a USB keyboard, the rescue
# console). Only its SHA-512 crypt hash goes into the image; ssh stays
# key-only (pi_config/fresh-install.md 1.1).
SAM1902_PASSWORD=

# Home Wi-Fi. `make card` gives every deck's /data a NetworkManager profile
# for it (release/home-wifi.nmconnection.in). Leave both empty for none.
HOME_WIFI_SSID=
HOME_WIFI_PSK=
