# Copy to secrets.env (gitignored) and fill in. `pi-qemu image build`,
# `pi-qemu release card` and `pi-qemu deck console` read it.
#
# The console password for sam1902 (tty2 with a USB keyboard, the rescue
# console). Only its SHA-512 crypt hash goes into the image; ssh stays
# key-only (pi_config/fresh-install.md 1.1). `deck console` logs in with it.
SAM1902_PASSWORD=

# Home Wi-Fi. `pi-qemu release card` gives every deck's /data a NetworkManager
# profile for it (release/home-wifi.nmconnection.in). Leave both empty for none.
HOME_WIFI_SSID=
HOME_WIFI_PSK=
